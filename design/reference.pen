                      "width": 620,
                      "layout": "vertical",
                      "gap": 26,
                      "children": [
                        {
                          "type": "frame",
                          "id": "TDaNy",
                          "name": "Para 1",
                          "width": "fill_container",
                          "layout": "vertical",
                          "children": [
                            {
                              "type": "text",
                              "id": "R5TBRx",
                              "fill": "$ink",
                              "content": "Neubrutalism is a contemporary web and UI",
                              "lineHeight": 1.62,
                              "fontFamily": "$font-body",
                              "fontSize": 18,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "BbJmv",
                              "fill": "$ink",
                              "content": "design movement that rejects polished",
                              "lineHeight": 1.62,
                              "fontFamily": "$font-body",
                              "fontSize": 18,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "bofFj",
