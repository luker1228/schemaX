                          "layout": "vertical",
                          "gap": 14,
                          "padding": 26,
                          "children": [
                            {
                              "type": "text",
                              "id": "W12FQV",
                              "name": "Q1 Mark",
                              "fill": "$ink",
                              "content": "“",
                              "lineHeight": 0.6,
                              "fontFamily": "$font-display",
                              "fontSize": 42,
                              "fontWeight": "800"
                            },
                            {
                              "type": "text",
                              "id": "NfXvs",
                              "name": "Q1 Text",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Neubrutalism is the 2020s domestication of anti-design energy. It borrows brutalism's language of bluntness and exposed structure, borrows postmodern anti-design's appetite for friction and play, and borrows web brutalism's resistance to polished sameness.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-body",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "RzTWy",
                          "name": "Quote 2",
                          "width": "fill_container",
                          "fill": "$blue-light",
                          "stroke": "$ink",
                          "strokeWidth": 3,
                          "strokeAlignment": "inner",
                          "effect": {
                            "type": "shadow",
                            "shadowType": "outer",
                            "color": "$ink",
                            "offset": {
                              "x": 5,
                              "y": 5
                            }
                          },
                          "layout": "vertical",
                          "gap": 14,
                          "padding": 26,
                          "children": [
                            {
                              "type": "text",
                              "id": "Rxikc",
                              "name": "Q2 Text",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "“A visual-design trend defined by high contrast, blocky layouts, bold colors, thick borders, and unpolished elements… more colorful and orderly than pure brutalism.”",
