                  "children": [
                    {
                      "type": "text",
                      "id": "owjvd",
                      "name": "Disappear H",
                      "fill": "#000000",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Why It Won't Disappear",
                      "lineHeight": 1.15,
                      "fontFamily": "$font-heading",
                      "fontSize": 30,
                      "fontWeight": "700",
