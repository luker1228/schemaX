# Memorix environment variables
# Copy this file to .env and fill in real values.
# Secrets go here. Behavior settings stay in memorix.yml.

# LLM API key
MEMORIX_LLM_API_KEY=sk-your-key-here

# Embedding API key
# Falls back to MEMORIX_LLM_API_KEY if omitted
# MEMORIX_EMBEDDING_API_KEY=sk-your-key-here
# MEMORIX_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Optional unified key
# MEMORIX_API_KEY=sk-your-key-here

# Compatibility variables (lowest priority)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
