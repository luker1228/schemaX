# EditorConfig —— SchemaX
# 统一编辑器基础格式（IDE 层面的最低保障，与 Prettier 互补）。
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
