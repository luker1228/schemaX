---
import { site } from '../../config/site';
const year = new Date().getFullYear();
---

<footer class="footer" data-pagefind-ignore>
  <div class="sx-container footer__inner">
    <span class="footer__brand">{site.name}</span>
    <span class="footer__tag">{site.tagline}</span>
    <nav class="footer__social" aria-label="Social">
      {
        site.social.map((s) => (
          <a
            class="footer__link"
            href={s.href}
            rel="me noopener"
            target="_blank"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
    <span class="footer__copy">© {year} {site.author.name}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--sx-ref-space-24);
    background: var(--sx-sys-color-bg-page);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sx-ref-space-4);
    padding-block: var(--sx-ref-space-8);
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .footer__brand {
    font-weight: 800;
  }

  .footer__tag {
    font-family: ui-monospace, monospace;
    opacity: 0.8;
  }

  .footer__social {
    display: flex;
    gap: var(--sx-ref-space-3);
  }

  .footer__link {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
