---
import { site } from '../../config/site';
import { navigation } from '../../data/navigation';
import Button from '../design-system/Button.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-header__inner">
    <div class="header-primary">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <span class="brand-logo" aria-hidden="true">
          <span class="brand-logo__mark">{}</span>
        </span>
        <span class="brand-text">
          <span class="brand-name">{site.name}</span>
          <span class="brand-tagline">{site.brandTagline}</span>
        </span>
      </a>

      <nav class="nav" aria-label="Primary">
        {
          navigation.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="header-actions" aria-label="固定入口">
      <Button variant="outline" size="sm" href={site.rss.href}>
        {site.rss.label}
      </Button>
      <Button
        variant="primary"
        size="sm"
        href={site.social[0]?.href}
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </Button>
    </div>
  </div>
</header>

<style>
  /* —— sticky header：横跨视口全宽（不与页面内容同宽）。
     半透明背景 + backdrop blur。视觉参数全部走 --sx-comp-header-* 组件令牌。 —— */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: var(--sx-comp-header-padding-block);
    padding-inline: var(--sx-comp-header-padding-inline);
    background: color-mix(
      in srgb,
      var(--sx-sys-color-bg-page) 94%,
      transparent
    );
    backdrop-filter: blur(8px);
  }

  /* —— 布局：左 primary（brand + nav）占满 / 右 actions。
     不套 .sx-container —— header 独立于内容宽度，brand 与 actions 分布两端。 —— */
  .site-header__inner {
    display: grid;
    align-items: center;
    gap: var(--sx-comp-header-gap);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .header-primary {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-width: 0;
  }

  /* —— Brand：logo + 双行文字 —— */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    text-decoration: none;
  }
  .brand:hover {
    color: inherit;
  }

  /* logo 占位色块（无外部图片资源时，保留花括号品牌母题作为 logo mark） */
  .brand-logo {
    width: var(--sx-comp-header-logo-size);
    height: var(--sx-comp-header-logo-size);
    flex: 0 0 var(--sx-comp-header-logo-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-sm);
    transition:
      transform 180ms ease,
      box-shadow 120ms ease;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--sx-sys-color-text-primary);
  }
  .brand:hover .brand-logo,
  .brand:focus-visible .brand-logo {
    transform: rotate(4deg);
    box-shadow: var(--sx-sys-shadow-md);
  }

  .brand-text {
    display: grid;
    gap: 0.15rem;
  }
  .brand-name {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
    white-space: nowrap;
  }
  .brand-tagline {
    color: var(--sx-sys-color-text-soft, var(--sx-sys-color-text-primary));
    opacity: 0.7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 600;
    font-size: 0.78rem;
    /* 中文副标题：字距收窄，避免中文字间出现不自然空隙 */
    letter-spacing: 0.02em;
    line-height: normal;
  }

  /* —— Nav 样式见 src/styles/components.css 的全局 .nav 类 —— */

  /* —— Header actions 容器：仅控制 flex 排列。
       按钮本体复用全局 Button 组件（.btn 类），不再维护私有 .header-action 样式。 —— */
  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  /* —— 移动端：单列，header-primary 改纵向 —— */
  @media (max-width: 760px) {
    .site-header__inner {
      grid-template-columns: 1fr;
    }
    .header-primary {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .nav {
      justify-content: flex-start;
    }
    .header-actions {
      justify-content: flex-start;
    }
  }
</style>
