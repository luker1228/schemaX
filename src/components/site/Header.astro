---
import { site } from '../../config/site';
import { navigation } from '../../data/navigation';
import Button from '../design-system/Button.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-header__inner">
    <div class="header-primary">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <span class="brand-logo" aria-hidden="true">
          <svg class="brand-logo__mark" viewBox="0 0 144 144" fill="currentColor" width="100%" height="100%">
            <path d="M52 26H44C39.5817 26 36 29.5817 36 34V51.6914L58 72L36 92.3076V110C36 114.418 39.5817 118 44 118H52V136H34C25.1634 136 18 128.837 18 120V90C18 85.5817 14.4183 82 10 82H3V62H10C14.4183 62 18 58.4183 18 54V24C18 15.1634 25.1634 8 34 8H52V26ZM110 8C118.837 8 126 15.1634 126 24V54C126 58.4183 129.582 62 134 62H141V82H134C129.582 82 126 85.5817 126 90V120C126 128.837 118.837 136 110 136H92V118H100C104.418 118 108 114.418 108 110V92.3076L86 72L108 51.6914V34C108 29.5817 104.418 26 100 26H92V8H110Z"/>
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">{site.name}</span>
          <span class="brand-tagline">{site.brandTagline}</span>
        </span>
      </a>

      <nav class="nav" aria-label="Primary">
        {
          navigation.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="header-actions" aria-label="固定入口">
      <Button variant="outline" size="sm" href={site.rss.href}>
        {site.rss.label}
      </Button>
      <Button
        variant="primary"
        size="sm"
        href={site.social[0]?.href}
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </Button>
    </div>
  </div>
</header>

<style>
  /* —— sticky header：横跨视口全宽（不与页面内容同宽）。
     半透明背景 + backdrop blur。视觉参数全部走 --sx-comp-header-* 组件令牌。 —— */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-block: var(--sx-comp-header-padding-block);
    padding-inline: var(--sx-comp-header-padding-inline);
    background: color-mix(
      in srgb,
      var(--sx-sys-color-bg-page) 94%,
      transparent
    );
    backdrop-filter: blur(8px);
  }

  /* —— 布局：左 primary（brand + nav）占满 / 右 actions。
     不套 .sx-container —— header 独立于内容宽度，brand 与 actions 分布两端。 —— */
  .site-header__inner {
    display: grid;
    align-items: center;
    gap: var(--sx-comp-header-gap);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .header-primary {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-width: 0;
  }

  /* —— Brand：logo + 双行文字 —— */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    text-decoration: none;
  }
  .brand:hover {
    color: inherit;
  }

  /* logo 容器：真实 mark（黑底暖纸反白）。mark 用 currentColor，跟随 --sx-comp-header-logo-fg。 */
  .brand-logo {
    box-sizing: border-box;
    width: var(--sx-comp-header-logo-size);
    height: var(--sx-comp-header-logo-size);
    flex: 0 0 var(--sx-comp-header-logo-size);
    padding: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--sx-comp-header-logo-bg);
    color: var(--sx-comp-header-logo-fg);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-sm);
    transition:
      transform 180ms ease,
      box-shadow 120ms ease;
  }
  .brand:hover .brand-logo,
  .brand:focus-visible .brand-logo {
    transform: rotate(4deg);
    box-shadow: var(--sx-sys-shadow-md);
  }

  .brand-text {
    display: grid;
    gap: 0.15rem;
  }
  .brand-name {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 0.95;
    white-space: nowrap;
  }
  .brand-tagline {
    color: var(--sx-sys-color-text-soft, var(--sx-sys-color-text-primary));
    opacity: 0.7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 600;
    font-size: 0.78rem;
    /* 中文副标题：字距收窄，避免中文字间出现不自然空隙 */
    letter-spacing: 0.02em;
    line-height: normal;
  }

  /* —— Nav 样式见 src/styles/components.css 的全局 .nav 类 —— */

  /* —— Header actions 容器：仅控制 flex 排列。
       按钮本体复用全局 Button 组件（.btn 类），不再维护私有 .header-action 样式。 —— */
  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  /* —— 移动端：单列，header-primary 改纵向 —— */
  @media (max-width: 760px) {
    .site-header__inner {
      grid-template-columns: 1fr;
    }
    .header-primary {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .nav {
      justify-content: flex-start;
    }
    .header-actions {
      justify-content: flex-start;
    }
  }
</style>
