---
/**
 * 课程列表卡 —— layout 承重：
 * 阅读序：Title（主）→ Description（次）→ Meta（辅）
 * 结构：横排「身份印章 | 文案栈」；窄屏印章缩顶左、文案仍纵向。
 * 入口：整张卡为 <a>，hover 浮起 = 唯一入口（无内嵌 CTA / 脚注）。
 */
import type { CollectionEntry } from 'astro:content';
import Doodle from '../design-system/Doodle.astro';
import type { DoodleMarkKind } from '../../lib/doodle';

interface Props {
  course: CollectionEntry<'courses'>;
}
const { course } = Astro.props;
const { title, description, level, type, status } = course.data;

const doodleByType: Record<string, DoodleMarkKind> = {
  handbook: 'icon-course',
  guide: 'icon-base',
  workshop: 'icon-component',
  series: 'icon-pattern',
};
const doodle = doodleByType[type] ?? 'icon-course';

const stampByType: Record<string, string> = {
  handbook: 'var(--sx-sys-color-accent)',
  guide: 'var(--sx-sys-color-bg-page)',
  workshop: 'var(--sx-sys-color-bg-page)',
  series: 'var(--sx-sys-color-beige)',
};
const stampBg = stampByType[type] ?? 'var(--sx-sys-color-accent)';

const shadowByType: Record<string, string> = {
  handbook: 'var(--sx-sys-color-accent)',
  guide: 'var(--sx-sys-color-action-primary)',
  workshop: 'var(--sx-sys-color-border)',
  series: 'var(--sx-sys-color-border)',
};
const shadowColor = shadowByType[type] ?? 'var(--sx-sys-color-border)';

const levelLabel: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
};

const typeLabel: Record<string, string> = {
  handbook: 'Handbook',
  guide: 'Guide',
  workshop: 'Workshop',
  series: 'Series',
};

const statusLabel: Record<string, string> = {
  planning: 'Planning',
  writing: 'Writing',
  active: 'Active',
  completed: 'Completed',
};

const isActive = status === 'active' || status === 'completed';
---

<a
  class="coursecard"
  href={`/courses/${course.id}`}
  style={`--sx-sys-shadow-color: ${shadowColor}`}
>
  {/* 身份列：涂鸦印章 ——  squint 下的「这是哪类课」锚点 */}
  <div class="coursecard__identity" aria-hidden="true">
    <div class="coursecard__stamp" style={`background:${stampBg}`}>
      <Doodle kind={doodle} size="md" />
    </div>
  </div>

  {/* 文案列：标签 → 标题 → 描述 → 脚注（主阅读路径） */}
  <div class="coursecard__main">
    <div class="coursecard__meta-row">
      <span class="coursecard__type">{typeLabel[type] ?? type}</span>
      <span class="coursecard__level">{levelLabel[level] ?? level}</span>
      {
        !isActive && (
          <span class="coursecard__status">
            {statusLabel[status] ?? status}
          </span>
        )
      }
    </div>

    <h3 class="coursecard__title">{title}</h3>
    <p class="coursecard__desc">{description}</p>
  </div>
</a>

<style>
  /*
   * 空间命题（layout thesis）
   * - 主路径：标题 → 描述（进入由整卡 hover 浮起承担，单一入口）
   * - 身份（印章）与文案分列：proximity 上标签绑定，但不与标题抢 squint 权重
   * - 组内紧（meta/title/desc gap-2～3）；描述 flex 推底，卡片等高
   */
  .coursecard {
    --sx-sys-shadow-color: var(--sx-sys-color-border);

    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 var(--sx-ref-space-6);
    align-items: stretch;
    height: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--sx-ref-space-6);
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    box-shadow: var(--sx-sys-shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .coursecard:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--sx-sys-shadow-md);
  }

  .coursecard:focus-visible {
    outline: var(--sx-sys-border-width) solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  /* —— 身份列 —— */
  .coursecard__identity {
    display: flex;
    align-items: flex-start;
  }

  .coursecard__stamp {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);

    /* 重置回黑：抵消卡片根上覆盖的撞色 shadow-color，stamp 保持黑色小硬影 */
    --sx-sys-shadow-color: var(--sx-sys-color-border);

    box-shadow: var(--sx-sys-shadow-sm);
  }

  .coursecard__stamp :global(.sx-doodle) {
    width: 2.5rem;
    height: 2.5rem;
  }

  /* —— 文案栈：纵向节奏 —— */
  .coursecard__main {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    min-width: 0;
    min-height: 100%;
  }

  /* 元信息一行：紧贴标题上方（eyebrow 角色） */
  .coursecard__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sx-ref-space-2);
  }

  .coursecard__type,
  .coursecard__level,
  .coursecard__status {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.45rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .coursecard__type {
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-text-primary);
  }

  .coursecard__level {
    background: transparent;
    color: var(--sx-sys-color-text-soft);
  }

  .coursecard__status {
    background: var(--sx-sys-color-beige);
    color: var(--sx-sys-color-text-soft);
  }

  /* 主元素：标题 */
  .coursecard__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
    /* 标题上方略紧：与 meta 同属「标题组」 */
  }

  /* 次元素：描述限 2 行，压密度、让脚注常可见 */
  .coursecard__desc {
    margin: 0;
    flex: 1 1 auto;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.5;
    color: var(--sx-sys-color-text-soft);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* 极窄：印章缩到顶行与 meta 同行，避免竖向浪费 */
  @media (max-width: 36rem) {
    .coursecard {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 var(--sx-ref-space-4);
      padding: var(--sx-ref-space-4);
    }

    .coursecard__stamp {
      width: 3rem;
      height: 3rem;
    }

    .coursecard__stamp :global(.sx-doodle) {
      width: 1.85rem;
      height: 1.85rem;
    }

    .coursecard__title {
      font-size: var(--sx-sys-font-size-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coursecard {
      transition: none;
    }

    .coursecard:hover {
      transform: none;
    }
  }
</style>
