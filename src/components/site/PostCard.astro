---
import type { CollectionEntry } from 'astro:content';
import Card from '../design-system/Card.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, description, publishedAt } = post.data;
const date = publishedAt
  ? publishedAt.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<Card href={`/blog/${post.id}`} class="postcard">
  <span class="badge">Post</span>
  <h3 class="postcard__title">{title}</h3>
  <p class="postcard__desc">{description}</p>
  {date && <p class="postcard__meta">{date}</p>}
</Card>

<style>
  .postcard {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    height: 100%;
  }
  .postcard__title {
    font-size: var(--sx-sys-font-size-xl);
    font-weight: 700;
    line-height: 1.2;
  }
  .postcard__desc {
    flex: 1;
    opacity: 0.85;
  }
  .postcard__meta {
    font-size: var(--sx-sys-font-size-md);
    font-family: ui-monospace, monospace;
    opacity: 0.7;
  }
</style>
