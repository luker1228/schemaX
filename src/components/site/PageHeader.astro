---
// PageHeader —— 子路由页面顶部的居中标题区。
// 用于 blog / projects / courses / design-system 等列表页，
// 统一 eyebrow + 大标题 + 描述的结构，居中展示。
//
// 用法：
//   <PageHeader title="Projects" description="开源仓库、产品实验与工程作品。" />
//   <PageHeader eyebrow="SchemaX UI" title="Design System">
//     <p>描述里需要 <code>内联代码</code> 时用 slot。</p>
//   </PageHeader>

interface Props {
  /** 大标题，渲染为 <h1> */
  title: string;
  /** 可选：标题上方的等宽小字（eyebrow），如 "SchemaX UI" */
  eyebrow?: string;
  /** 可选：纯文本描述。若描述含富文本（如 <code>），改用默认 slot */
  description?: string;
}

const { title, eyebrow, description } = Astro.props;
---

<header class="page-head">
  {eyebrow && <p class="page-head__eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">{title}</h1>
  <div class="page-head__desc">
    {description ? <p>{description}</p> : <slot />}
  </div>
</header>

<style>
  .page-head {
    text-align: center;
    max-width: var(--sx-comp-page-head-max-width);
    margin-block: var(--sx-comp-page-head-margin-block-start)
      var(--sx-comp-page-head-margin-block-end);
    /* 水平居中：margin auto 在 sx-container 内把本块推到中间 */
    margin-inline: auto;
  }
  .page-head__eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--sx-sys-color-action-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .page-head__title {
    font-size: var(--sx-comp-page-head-title-size);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-block-start: var(--sx-ref-space-2);
  }
  .page-head__desc {
    font-size: var(--sx-comp-page-head-desc-size);
    line-height: 1.6;
    opacity: 0.8;
    margin-block-start: var(--sx-comp-page-head-gap);
  }
  .page-head__desc :global(p) {
    margin: 0;
  }
  /* slot 里的描述（含富文本）沿用同样的间距 */
  .page-head__desc :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85em;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    padding: 0.05em 0.4em;
  }
</style>
