---
import DoodleMark from './DoodleMark.astro';

// 编辑式原则墙：黑白线稿为主，蓝/黄局部强调（非彩虹 bento）
const principles = [
  {
    en: 'Structure before automation',
    cn: '先结构，后自动化',
    body: '先把意图、字段、边界和约束描述清楚，再让工具与 Agent 执行。',
    accent: 'yellow' as const,
  },
  {
    en: 'Contract before integration',
    cn: '先契约，后集成',
    body: 'API、组件、内容和工具调用都先建立可验证契约，再进入系统连接。',
    accent: 'blue' as const,
  },
  {
    en: 'Constraints enable reliability',
    cn: '约束带来可靠性',
    body: '合理约束不是限制能力，而是让执行结果可以检查、复现和维护。',
    accent: 'ink' as const,
  },
  {
    en: 'Small schemas, large systems',
    cn: '小 Schema，大系统',
    body: '用可组合的小契约组织复杂度，而不是一次写完整个世界。',
    accent: 'yellow' as const,
  },
];
---

<section class="manifesto home-section" aria-labelledby="manifesto-title">
  <div class="manifesto__inner home-section__inner">
    <header class="manifesto__intro">
      <div class="manifesto__intro-copy">
        <p class="manifesto__kicker">
          <DoodleMark kind="spark" size="sm" />
          <span>构建原则 · MANIFESTO</span>
        </p>
        <h2 class="manifesto__title" id="manifesto-title">
          结构先于自动化，<br />
          契约先于集成。
        </h2>
        <p class="manifesto__lede">
          这不是口号墙——是我在 Agent、内容与设计系统里反复验证过的工作方式。
        </p>
      </div>
      <div class="manifesto__sketch" aria-hidden="true">
        <DoodleMark kind="brace" size="lg" />
        <DoodleMark kind="star" size="md" class="manifesto__sketch-star" />
      </div>
    </header>

    <ol class="manifesto__list">
      {
        principles.map((p, i) => (
          <li class:list={['principle', `principle--${p.accent}`]}>
            <span class="principle__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="principle__body">
              <h3 class="principle__cn">{p.cn}</h3>
              <p class="principle__en">{p.en}</p>
              <p class="principle__text">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .manifesto__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: var(--sx-ref-space-8);
    align-items: end;
    margin-bottom: var(--sx-ref-space-6);
  }

  .manifesto__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--sx-ref-space-2);
    margin: 0 0 var(--sx-ref-space-4);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }

  .manifesto__title {
    margin: 0 0 var(--sx-ref-space-4);
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .manifesto__lede {
    margin: 0;
    max-width: 40ch;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.65;
    color: var(--sx-sys-color-text-soft);
  }

  .manifesto__sketch {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sx-ref-space-4);
    min-height: 5rem;
  }

  .manifesto__list {
    list-style: none;
    margin: var(--sx-ref-space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sx-sys-border-width-strong);
    background: var(--sx-sys-color-border);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
  }

  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sx-ref-space-4);
    padding: var(--sx-ref-space-6) var(--sx-ref-space-6);
    background: var(--sx-sys-color-bg-surface);
    margin: 0;
  }

  .principle__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    background: var(--sx-sys-color-bg-page);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .principle__body {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    min-width: 0;
  }

  .principle__cn {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-xl);
    font-weight: 800;
    line-height: 1.15;
    color: var(--sx-sys-color-text-primary);
  }

  .principle__en {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--sx-sys-color-text-muted);
  }

  .principle__text {
    margin: var(--sx-ref-space-2) 0 0;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.55;
    color: var(--sx-sys-color-text-soft);
  }

  .principle--yellow {
    background: color-mix(
      in srgb,
      var(--sx-sys-color-accent) 28%,
      var(--sx-sys-color-bg-surface)
    );
  }

  .principle--blue .principle__en {
    color: var(--sx-sys-color-action-primary);
  }

  .principle--yellow .principle__index {
    background: var(--sx-sys-color-accent);
  }

  .principle--blue .principle__index {
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
  }

  @media (max-width: 48rem) {
    .manifesto__intro {
      grid-template-columns: 1fr;
    }

    .manifesto__sketch {
      justify-content: flex-start;
    }

    .manifesto__list {
      grid-template-columns: 1fr;
    }
  }
</style>
