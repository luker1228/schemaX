---
import GeoMark from '../design-system/GeoMark.astro';

// 四原则墙：每条原则一张硬边贴纸卡，四色各一——
// 蓝底白字 / 白底黑字 / 白底蓝字 / 黄底黑字。
// 文字色继承卡色，靠 opacity 分层（标题纯色、编号/英文/正文弱化）。
const principles = [
  {
    en: 'Structure before automation',
    cn: '先结构，后自动化',
    body: '先把意图、字段、边界和约束描述清楚，再让工具与 Agent 执行。',
    tone: 'coral' as const,
  },
  {
    en: 'Contract before integration',
    cn: '先契约，后集成',
    body: 'API、组件、内容和工具调用都先建立可验证契约，再进入系统连接。',
    tone: 'white' as const,
  },
  {
    en: 'Constraints enable reliability',
    cn: '约束带来可靠性',
    body: '合理约束不是限制能力，而是让执行结果可以检查、复现和维护。',
    tone: 'pop-green' as const,
  },
  {
    en: 'Small schemas, large systems',
    cn: '小 Schema，大系统',
    body: '用可组合的小契约组织复杂度，而不是一次写完整个世界。',
    tone: 'yellow' as const,
  },
];
---

<section class="manifesto home-section" aria-labelledby="manifesto-title">
  <div class="manifesto__inner home-section__inner">
    <header class="manifesto__intro">
      <div class="manifesto__intro-copy">
        <p class="manifesto__kicker">
          <GeoMark kind="spark" size="sm" />
          <span>构建原则 · MANIFESTO</span>
        </p>
        <h2 class="manifesto__title" id="manifesto-title">
          结构先于自动化，<br />契约先于集成。
        </h2>
      </div>
      <div class="manifesto__sketch" aria-hidden="true">
        <GeoMark kind="brace" size="lg" />
        <GeoMark kind="star" size="md" class="manifesto__sketch-star" />
      </div>
    </header>

    <ol class="manifesto__list">
      {
        principles.map((p, i) => (
          <li class:list={['principle', `principle--${p.tone}`]}>
            <span class="principle__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="principle__body">
              <h3 class="principle__cn">{p.cn}</h3>
              <p class="principle__en">{p.en}</p>
              <p class="principle__text">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .manifesto__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: var(--sx-ref-space-8);
    align-items: end;
    margin-bottom: var(--sx-ref-space-8);
  }

  .manifesto__intro-copy {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-3);
  }

  .manifesto__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--sx-ref-space-2);
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }

  .manifesto__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .manifesto__sketch {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sx-ref-space-4);
    min-height: 5rem;
  }

  .manifesto__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sx-sys-border-width-strong);
    background: var(--sx-sys-color-border);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
  }

  .principle {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sx-ref-space-4);
    padding: var(--sx-ref-space-6);
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
    margin: 0;
  }

  /* 四撞色矩阵（neubrutalism）：浅撞色一律黑字（对比度 ≥3:1），区分靠背景填充。 */
  .principle--white {
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
  }

  .principle--coral {
    background: var(--sx-sys-color-coral);
    color: var(--sx-sys-color-text-primary);
  }

  .principle--pop-green {
    background: var(--sx-sys-color-pop-green);
    color: var(--sx-sys-color-text-primary);
  }

  .principle--yellow {
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-text-primary);
  }

  .principle__index {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.55;
  }

  .principle__body {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    min-width: 0;
  }

  .principle__cn {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-xl);
    font-weight: 800;
    line-height: 1.15;
    color: inherit;
  }

  .principle__en {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.03em;
    opacity: 0.7;
  }

  .principle__text {
    margin: var(--sx-ref-space-1) 0 0;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.55;
    opacity: 0.85;
  }

  @media (max-width: 48rem) {
    .manifesto__intro {
      grid-template-columns: 1fr;
    }

    .manifesto__sketch {
      justify-content: flex-start;
    }

    .manifesto__list {
      grid-template-columns: 1fr;
    }
  }
</style>
