---
import GeoMark from '../design-system/GeoMark.astro';

// Tech Note：构建链路（固定事实）。重构为黄底黑字大卡——纵向布局，pipeline 为主视觉。
// 原来的 bullets 与 pipeline 合并为一条四步流程（编号 + 步骤 + 工具命令）。
const pipeline = [
  { num: '01', step: 'TOKENS', detail: 'Style Dictionary → CSS + TS' },
  { num: '02', step: 'CONTENT', detail: 'Zod · schema gate' },
  { num: '03', step: 'ASTRO', detail: 'static compile' },
  { num: '04', step: 'SEARCH', detail: 'pagefind over dist' },
];
---

<section class="tech home-section" aria-labelledby="tech-title">
  <div class="tech__inner home-section__inner">
    <div class="tech__card">
      <div class="tech__head">
        <span class="tech__eyebrow">Technical notes</span>
        <h2 class="tech__title" id="tech-title">
          构建顺序本身就是产品质量的一部分。
        </h2>
        <p class="tech__body">
          令牌、内容、类型、静态构建与搜索索引串成一条不可随意打乱的链路；GitHub
          数据只在构建期写入缓存，不在运行时请求。
        </p>
      </div>

      <ol class="tech__flow">
        {
          pipeline.map((p, i) => (
            <li class="flow-item">
              <div class="flow-step">
                <span class="flow-step__num">{p.num}</span>
                <span class="flow-step__name">{p.step}</span>
                <span class="flow-step__detail">{p.detail}</span>
              </div>
              {i < pipeline.length - 1 && (
                <span class="flow-arrow" aria-hidden="true">
                  <GeoMark kind="arrow" size="sm" />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .tech {
    padding-block-end: clamp(3rem, 7vw, 5rem);
  }

  /* 黄底黑字大卡——重构：从蓝底左右双栏改成黄底纵向，pipeline 作主视觉 */
  .tech__card {
    padding: var(--sx-ref-space-8);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-accent);
    box-shadow: var(--sx-sys-shadow-lg);
    color: var(--sx-sys-color-text-primary);
  }

  .tech__head {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-3);
    max-width: 46rem;
    margin-bottom: var(--sx-ref-space-8);
  }

  .tech__eyebrow {
    display: inline-flex;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
    opacity: 0.7;
  }

  .tech__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-sm);
    font-weight: 800;
    line-height: 1.12;
    color: var(--sx-sys-color-text-primary);
  }

  .tech__body {
    margin: 0;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.6;
    color: var(--sx-sys-color-text-primary);
    opacity: 0.8;
  }

  .tech__flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sx-ref-space-2);
  }

  .flow-item {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-2);
    min-width: 0;
  }

  /* 白底墨字色块：墨边框住（贴纸色块），在黄卡上靠色差 + 边框区分 */
  .flow-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    padding: var(--sx-ref-space-4);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
    min-width: 0;
    box-shadow: var(--sx-sys-shadow-sm);
  }

  /* 大编号用 action 蓝——黄卡上蓝编号 pop，蓝黄对比 */
  .flow-step__num {
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    line-height: 1;
    color: var(--sx-sys-color-action-primary);
  }

  .flow-step__name {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--sx-sys-color-text-muted);
  }

  .flow-step__detail {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    color: var(--sx-sys-color-text-primary);
  }

  .flow-arrow {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  @media (max-width: 64rem) {
    .tech__flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .tech__flow {
      grid-template-columns: 1fr;
    }

    .flow-arrow {
      display: none;
    }
  }
</style>
