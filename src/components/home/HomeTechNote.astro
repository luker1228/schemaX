---
// Tech Note：构建链路说明（固定事实，硬编码）。
// 左文案 + 4 步彩色 pipeline 流程 + 3 个 metric。
const bullets = [
  '01 tokens:build -> CSS + TS artifacts',
  '02 content:check -> schema gate',
  '03 astro build -> static output',
  '04 search:build -> pagefind over dist',
];

const pipeline = [
  { step: 'TOKENS', detail: 'Style Dictionary', bg: 'var(--sx-sys-color-accent)' },
  { step: 'CONTENT', detail: 'Zod collections', bg: 'var(--sx-sys-color-mint)' },
  { step: 'ASTRO', detail: 'Static compile', bg: 'var(--sx-sys-color-action-primary)' },
  { step: 'SEARCH', detail: 'Pagefind index', bg: 'var(--sx-sys-color-lavender)' },
];

const metrics = [
  { value: '5', label: 'COLLECTIONS' },
  { value: '1', label: 'SOURCE OF TRUTH' },
  { value: '0', label: 'RUNTIME CMS' },
];
---

<section class="tech">
  <div class="tech__inner">
    <div class="tech__card">
      <div class="tech__copy">
        <span class="tech__eyebrow">TECHNICAL NOTES</span>
        <h2 class="tech__title">构建顺序本身就是产品质量的一部分。</h2>
        <p class="tech__body">
          令牌生成、内容校验、类型检查、静态构建与搜索索引被串成一个不可随意打乱的链路。GitHub
          数据只在构建期写入缓存，不在运行时请求。
        </p>
        <ul class="tech__bullets">
          {bullets.map((b) => <li class="tech__bullet">{b}</li>)}
        </ul>
      </div>

      <div class="tech__diagram">
        <div class="diagram__head">
          <span class="diagram__label">PIPELINE MAP</span>
          <span class="diagram__status">BUILD-TIME VERIFIED</span>
        </div>

        <div class="diagram__flow">
          {pipeline.map((p) => (
            <div class="flow-step" style={`--sx-step-bg: ${p.bg}`}>
              <span class="flow-step__name">{p.step}</span>
              <span class="flow-step__rule" />
              <span class="flow-step__detail">{p.detail}</span>
            </div>
          ))}
        </div>

        <div class="diagram__metrics">
          {metrics.map((m) => (
            <div class="metric">
              <span class="metric__value">{m.value}</span>
              <span class="metric__label">{m.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 4rem);
    padding-inline: var(--sx-ref-space-6);
  }
  .tech__inner {
    max-width: 80rem;
    margin-inline: auto;
  }

  .tech__card {
    display: flex;
    gap: 1.875rem;
    padding: 1.5rem 1.625rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: var(--sx-sys-shadow-lg);
  }

  .tech__copy {
    flex: 0 0 28rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tech__eyebrow {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--sx-sys-color-text-primary);
  }
  .tech__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--sx-sys-color-text-primary);
  }
  .tech__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--sx-sys-color-text-muted);
  }
  .tech__bullets {
    margin: 0;
    padding: 0.375rem 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tech__bullet {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--sx-sys-color-text-primary);
  }

  /* —— Pipeline 图 —— */
  .tech__diagram {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: center;
  }
  .diagram__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-accent);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.7rem;
  }
  .diagram__label {
    font-weight: 700;
  }

  .diagram__flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.625rem;
  }
  .flow-step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0.625rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-step-bg);
    box-shadow: var(--sx-sys-shadow-sm);
  }
  .flow-step__name {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }
  .flow-step__rule {
    height: 1px;
    background: var(--sx-sys-color-text-primary);
  }
  .flow-step__detail {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--sx-sys-color-text-primary);
  }

  .diagram__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.625rem;
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.625rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-bg-page);
    box-shadow: var(--sx-sys-shadow-sm);
  }
  .metric__value {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }
  .metric__label {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.625rem;
    color: var(--sx-sys-color-text-muted);
  }

  @media (max-width: 56rem) {
    .tech__card {
      flex-direction: column;
    }
    .tech__copy {
      flex-basis: auto;
    }
    .diagram__flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
