---
// 四个核心入口：白底卡片 + 2px 黑边 + 各自彩色硬阴影（青/红/蓝/黄）。
// 彩色阴影通过 --sx-entry-shadow 局部变量注入，档位（4px）走 token。
const entries = [
  {
    label: 'Courses',
    href: '/courses',
    desc: '体系化课程、章节与练习。',
    shadow: 'var(--sx-sys-color-mint)',
  },
  {
    label: 'Blog',
    href: '/blog',
    desc: '技术文章、工程总结与观点记录。',
    shadow: 'var(--sx-sys-color-danger)',
  },
  {
    label: 'Projects',
    href: '/projects',
    desc: '开源仓库、产品实验与工程作品。',
    shadow: 'var(--sx-sys-color-action-primary)',
  },
  {
    label: 'Design System',
    href: '/design-system',
    desc: 'SchemaX 的 Token、组件与内容规范。',
    shadow: 'var(--sx-sys-color-accent)',
  },
];
---

<section class="entries">
  <div class="entries__inner">
    <h2 class="entries__title">四个核心入口</h2>
    <div class="entries__grid">
      {
        entries.map((e) => (
          <a
            class="entry"
            href={e.href}
            style={`--sx-entry-shadow: ${e.shadow}`}
          >
            <span class="entry__arrow" aria-hidden="true">
              &rarr;
            </span>
            <span class="entry__label">{e.label}</span>
            <span class="entry__desc">{e.desc}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .entries {
    padding-block: var(--sx-ref-space-4);
    padding-inline: var(--sx-ref-space-6);
  }

  .entries__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-6);
  }

  .entries__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }

  .entries__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* 卡片：固定高度 + 2px 黑边 + 彩色硬阴影。hover 抬起、阴影加大。 */
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-height: 12.25rem;
    padding: 1.125rem 1.125rem 1.25rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: 4px 4px 0 var(--sx-entry-shadow);
    text-decoration: none;
    color: inherit;
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }
  .entry:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--sx-entry-shadow);
  }

  .entry__arrow {
    position: absolute;
    top: 1rem;
    right: 1.125rem;
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-weight: 700;
    color: var(--sx-sys-color-text-muted);
    transition: transform 140ms ease;
  }
  .entry:hover .entry__arrow {
    transform: translateX(3px);
  }

  .entry__label {
    margin-top: auto;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }

  .entry__desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  @media (max-width: 56rem) {
    .entries__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 32rem) {
    .entries__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
