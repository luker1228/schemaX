---
import { site } from '../../config/site';
import { profile } from '../../data/profile';
import HeroTerminal from './HeroTerminal.tsx';
import DoodleMark from './DoodleMark.astro';

// 首页 hero 终端轮播内容（规范 §4.1）。纯视觉语言呈现，非真实 JSON 契约。
const heroSlides = [
  {
    title: 'profile.json',
    code: `{
  "name": "${profile.name}",
  "role": "${profile.role}",
  "modes": ${JSON.stringify(profile.modes)},
  "status": "${profile.status}"
}`,
  },
  {
    title: 'site.json',
    code: `{
  "site": "${site.name}",
  "pillars": ["courses", "blog", "projects"],
  "built": "2026"
}`,
  },
  {
    title: 'now.json',
    code: `{
  "now": "shipping design system",
  "mood": "focused",
  "next": "course: schema-first"
}`,
  },
];
---

<section class="hero home-section" aria-labelledby="hero-title">
  <div class="hero__inner home-section__inner">
    <div class="hero__copy">
      <div class="hero__meta">
        <span class="hero__stamp-badge">Schema-Driven</span>
        <DoodleMark kind="star" size="sm" class="hero__star" />
        <DoodleMark kind="spark" size="sm" class="hero__spark" />
      </div>

      <h1 class="hero__title" id="hero-title">
        Structure
        <span class="hero__title-line">
          <span class="hero__title-hl">the Unknown.</span>
          <DoodleMark kind="arrow" class="hero__arrow" />
        </span>
      </h1>

      <p class="hero__lede">用 Schema，为未知建立可执行的结构。</p>

      {/* Marie 式个人叙事：第一人称，短而具体 */}
      <p class="hero__bio">
        我是 Luke——AI Agent 工程师，也在自己的知识系统里当学生。SchemaX
        是我公开的第二大脑：课程、笔记、作品与设计系统共用同一套契约。你从搜索掉进某篇文章时，看到的是可验证的结构，不是营销页。
      </p>

      <div class="hero__command" aria-hidden="true">
        <span class="hero__command-label">path</span>
        <code class="hero__command-code">schema → contract → tool call</code>
        <DoodleMark kind="brace" size="sm" class="hero__brace" />
      </div>

      <div class="hero__cta">
        <a class="stamp stamp--primary" href="/projects">Explore Projects</a>
        <a class="stamp stamp--ghost" href="/blog">Read the Blog</a>
      </div>
    </div>

    <div class="hero__stage">
      <div class="hero__terminal">
        <HeroTerminal client:visible slides={heroSlides} />
      </div>
      <p class="hero__caption">
        <span class="hero__caption-mark">*</span>
        终端里的 JSON 是视觉语言，不是对外 API 契约。
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.95fr);
    gap: var(--sx-ref-space-12);
    align-items: start;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sx-ref-space-6);
    position: relative;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
  }

  /* 手写标签感：略歪的蓝底印章 */
  .hero__stamp-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-md);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--sx-sys-shadow-sm);
    transform: rotate(-1.5deg);
  }

  .hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-lg);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .hero__title-line {
    display: inline-flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
    flex-wrap: wrap;
  }

  .hero__title-hl {
    background: var(--sx-sys-color-accent);
    padding: 0 0.12em;
  }

  .hero__lede {
    margin: 0;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-sm);
    font-weight: 700;
    line-height: 1.25;
    color: var(--sx-sys-color-text-soft);
    max-width: 28ch;
  }

  .hero__bio {
    margin: 0;
    max-width: 42ch;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.7;
    color: var(--sx-sys-color-text-soft);
  }

  .hero__command {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: 3px 3px 0 var(--sx-sys-color-action-primary);
  }

  .hero__command-label {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sx-sys-color-text-muted);
  }

  .hero__command-code {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-base);
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }

  .hero__brace {
    position: absolute;
    right: -1.1rem;
    top: -1.1rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sx-ref-space-4);
    margin-top: var(--sx-ref-space-2);
  }

  .hero__stage {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-3);
    position: relative;
  }

  .hero__terminal :global(.term) {
    border-width: var(--sx-sys-border-width-strong);
    border-radius: var(--sx-sys-radius-sm);
    box-shadow: 5px 5px 0 var(--sx-sys-color-accent);
    width: 100%;
    font-family: var(--sx-sys-font-family-terminal), ui-monospace, monospace;
  }

  .hero__terminal :global(.term__title),
  .hero__terminal :global(.term__screen),
  .hero__terminal :global(.term__code) {
    font-family: var(--sx-sys-font-family-terminal), ui-monospace, monospace;
  }

  .hero__terminal :global(.term--hero .term__screen) {
    min-height: 13rem;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.55;
  }

  .hero__caption {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    color: var(--sx-sys-color-text-muted);
    transform: rotate(-0.4deg);
  }

  .hero__caption-mark {
    color: var(--sx-sys-color-action-primary);
    font-weight: 700;
  }

  @media (max-width: 48rem) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--sx-ref-space-8);
    }
  }
</style>
