---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import GeoMark from '../design-system/GeoMark.astro';

interface Props {
  /** 已按发布时间倒序的已发布文章（取前 N 篇：第 1 篇大卡，其余归档行）。 */
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;

const [latest, ...archive] = posts;

const topics = await getCollection('topics');
const topicRef = latest?.data.topics[0] as { id: string } | undefined;
const latestTopic = topicRef
  ? topics.find((t) => t.id === topicRef.id)
  : undefined;
const latestTopicLabel = latestTopic?.data.label ?? null;

const formatDate = (d?: Date) =>
  d
    ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(
        d.getDate(),
      ).padStart(2, '0')}`
    : '';

const latestDate = formatDate(latest?.data.publishedAt);
const latestMeta = [latestDate, latestTopicLabel].filter(Boolean).join(' / ');
---

{
  latest && (
    <section class="latest home-section" aria-labelledby="latest-title">
      <div class="latest__inner home-section__inner">
        <header class="home-head">
          <h2 class="home-head__title" id="latest-title">
            最新文章
          </h2>
          <a class="home-head__link" href="/blog">
            Read the blog →
          </a>
        </header>

        <a class="latest-card" href={`/blog/${latest.id}`}>
          <div class="latest-card__meta">
            <span class="post-badge">
              <GeoMark kind="icon-blog" size="sm" />
              POST
            </span>
            {latestMeta && (
              <span class="latest-card__date">{latestMeta}</span>
            )}
            <GeoMark kind="star" size="sm" class="latest-card__star" />
          </div>
          <h3 class="latest-card__title">{latest.data.title}</h3>
          <p class="latest-card__desc">{latest.data.description}</p>
          <span class="latest-card__cta">
            继续阅读
            <GeoMark kind="arrow" size="sm" />
          </span>
        </a>

        {archive.length > 0 && (
          <div class="archive">
            <div class="archive__head">
              <span>Article index</span>
              <span>{String(archive.length).padStart(2, '0')} more</span>
            </div>
            {archive.map((p, i) => (
              <a class="archive__row" href={`/blog/${p.id}`}>
                <div class="archive__copy">
                  <span class="archive__index">
                    [{String(i + 2).padStart(2, '0')}]
                  </span>
                  <span class="archive__title">{p.data.title}</span>
                  <span class="archive__desc">{p.data.description}</span>
                </div>
                <span class="archive__action">Read →</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .latest-card {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-4);
    padding: var(--sx-ref-space-8);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: var(--sx-sys-shadow-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease;
  }

  .latest-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 var(--sx-sys-color-border);
  }

  .latest-card:focus-visible {
    outline: var(--sx-sys-border-width) solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  .latest-card__meta {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
    flex-wrap: wrap;
  }

  .post-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-coral);
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    box-shadow: var(--sx-sys-shadow-sm);
    transform: rotate(var(--sx-sys-rotate-sticker));
  }

  .latest-card__date {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    color: var(--sx-sys-color-text-muted);
  }

  .latest-card__star {
    margin-left: auto;
  }

  .latest-card__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .latest-card__desc {
    margin: 0;
    max-width: 62ch;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  .latest-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sx-ref-space-2);
    margin-top: var(--sx-ref-space-2);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-md);
    font-weight: 700;
    color: var(--sx-sys-color-action-primary);
  }

  /* 裸 editorial 索引：不套卡、行间无分割线，靠留白与 hover 反应区分条目。
     head 用 muted 文字而非黄底——黄只留 hero/closing，且 Never-Dark 禁暗色填充。 */
  .archive {
    margin-top: var(--sx-ref-space-8);
    display: flex;
    flex-direction: column;
  }

  .archive__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.5rem var(--sx-ref-space-3);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }

  .archive__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sx-ref-space-4);
    padding: var(--sx-ref-space-4) 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 120ms ease;
  }

  .archive__row:hover {
    background: var(--sx-sys-color-bg-surface);
  }

  .archive__row:focus-visible {
    outline: var(--sx-sys-border-width) solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  .archive__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .archive__index {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 700;
    color: var(--sx-sys-color-text-muted);
  }

  .archive__title {
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-xl);
    font-weight: 800;
    line-height: 1.2;
  }

  .archive__desc {
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.5;
    color: var(--sx-sys-color-text-muted);
  }

  .archive__action {
    flex-shrink: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    color: var(--sx-sys-color-action-primary);
  }
</style>
