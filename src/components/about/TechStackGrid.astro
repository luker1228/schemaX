---
import { techStack } from '../../data/tech-stack';

// 颜色等级映射（类似 GitHub 贡献图）
const levelColors = {
  0: 'var(--sx-sys-color-gray-light)', // 空白
  1: 'var(--sx-sys-color-beige)', // 浅
  2: 'var(--sx-sys-color-mint)', // 中
  3: 'var(--sx-sys-color-action-primary)', // 深
  4: 'var(--sx-sys-color-accent)', // 最深
} as const;

const levelLabels = {
  1: '熟悉',
  2: '熟练',
  3: '精通',
  4: '专家',
} as const;
---

<section class="tech-stack">
  <div class="tech-stack__inner">
    <header class="tech-stack__header">
      <h2 class="tech-stack__title">技术栈</h2>
      <p class="tech-stack__lede">
        从前端到 AI，这是我多年来积累的技术栈。颜色越深，代表掌握程度越高。
      </p>
    </header>

    <div class="tech-stack__legend">
      <span class="tech-stack__legend-label">熟练度：</span>
      <div class="tech-stack__legend-items">
        <span class="legend-item" style={`background: ${levelColors[1]}`}></span>
        <span class="legend-item" style={`background: ${levelColors[2]}`}></span>
        <span class="legend-item" style={`background: ${levelColors[3]}`}></span>
        <span class="legend-item" style={`background: ${levelColors[4]}`}></span>
        <span class="tech-stack__legend-text">少 → 多</span>
      </div>
    </div>

    <div class="tech-stack__categories">
      {techStack.map((category) => (
        <div class="tech-category">
          <div class="tech-category__header">
            <h3 class="tech-category__name">{category.name}</h3>
            <p class="tech-category__desc">{category.description}</p>
          </div>

          <div class="tech-category__items">
            {category.items.map((item) => (
              <div
                class={`tech-item${item.featured ? ' tech-item--featured' : ''}`}
                title={`${item.name} - ${levelLabels[item.level]}${item.years ? ` · ${item.years} 年经验` : ''}`}
              >
                <span
                  class="tech-item__dot"
                  style={`background: ${levelColors[item.level]}`}
                ></span>
                <span class="tech-item__name">{item.name}</span>
                {item.years && (
                  <span class="tech-item__years">{item.years}年</span>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="tech-stack__note">
      <span class="tech-stack__note-icon">📊</span>
      <p>
        技术栈持续更新中。我专注于 <strong>React 生态</strong>、<strong>AI Agent 开发</strong> 和
        <strong>Schema-driven 设计</strong>。
      </p>
    </div>
  </div>
</section>

<style>
  .tech-stack {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(3rem, 7vw, 5rem);
    padding-inline: var(--sx-ref-space-6);
    border-top: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .tech-stack__inner {
    max-width: 64rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-10);
  }

  /* —— 头部 —— */
  .tech-stack__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .tech-stack__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .tech-stack__lede {
    margin: 0;
    max-width: 40ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  /* —— 图例 —— */
  .tech-stack__legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 9999px;
    background: var(--sx-sys-color-bg-page);
    align-self: center;
  }

  .tech-stack__legend-label {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sx-sys-color-text-soft);
  }

  .tech-stack__legend-items {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .legend-item {
    width: 0.875rem;
    height: 0.875rem;
    border: 1px solid var(--sx-sys-color-border);
    border-radius: 2px;
  }

  .tech-stack__legend-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sx-sys-color-text-muted);
  }

  /* —— 分类网格 —— */
  .tech-stack__categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: var(--sx-ref-space-8);
  }

  .tech-category {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-bg-page);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .tech-category__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1rem;
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .tech-category__name {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }

  .tech-category__desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--sx-sys-color-text-muted);
  }

  /* —— 技术项列表 —— */
  .tech-category__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.65rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-page);
    font-size: 0.875rem;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .tech-item:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .tech-item--featured {
    border-width: var(--sx-sys-border-width-strong);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .tech-item--featured:hover {
    box-shadow: var(--sx-sys-shadow-md);
  }

  .tech-item__dot {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--sx-sys-color-border);
    border-radius: 2px;
  }

  .tech-item__name {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-weight: 600;
    color: var(--sx-sys-color-text-primary);
  }

  .tech-item__years {
    font-size: 0.6875rem;
    color: var(--sx-sys-color-text-muted);
  }

  /* —— 底部备注 —— */
  .tech-stack__note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-beige);
  }

  .tech-stack__note-icon {
    font-size: 1.25rem;
  }

  .tech-stack__note p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  .tech-stack__note strong {
    color: var(--sx-sys-color-text-primary);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .tech-stack__categories {
      grid-template-columns: 1fr;
    }

    .tech-category {
      padding: 1.25rem;
    }
  }
</style>
