---
import { roles, accentToken } from '../../data/about';
---

<section class="skills">
  <div class="skills__inner">
    <div class="skills__head">
      <h2 class="skills__title">角色</h2>
    </div>

    <div class="skills__cards">
      {roles.map((role) => (
        <article class="role-card">
          <div
            class="role-card__band"
            style={`--sx-accent: ${accentToken[role.accent]}`}
          >
            <span class="role-card__index">{role.index}</span>
          </div>

          <div class="role-card__body">
            <span class="role-card__eyebrow">{role.eyebrow}</span>
            <h3 class="role-card__title">{role.title}</h3>
            <p class="role-card__desc">{role.desc}</p>
            <div class="role-card__tags">
              {role.tags.map((tag) => (
                <span class="role-card__tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 5vw, 4.5rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .skills__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .skills__head {
    display: flex;
    align-items: flex-end;
  }

  .skills__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .skills__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .role-card {
    display: flex;
    flex-direction: column;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-lg);
    overflow: hidden;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .role-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--sx-sys-color-border);
  }

  .role-card__band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 1rem 1.125rem;
    background: var(--sx-accent, var(--sx-sys-color-accent));
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .role-card__index {
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-3xl);
    font-weight: 900;
    line-height: 1;
    color: var(--sx-sys-color-text-primary);
  }

  .role-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.125rem 1.125rem 1.25rem;
  }

  .role-card__eyebrow {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 800;
    color: var(--sx-sys-color-text-soft);
  }

  .role-card__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    line-height: 1.15;
    color: var(--sx-sys-color-text-primary);
  }

  .role-card__desc {
    margin: 0;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.5;
    color: var(--sx-sys-color-text-primary);
  }

  .role-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.125rem;
  }

  .role-card__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.5625rem;
    background: var(--sx-sys-color-beige);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 9999px;
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

   @media (max-width: 64rem) {
    .skills__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
