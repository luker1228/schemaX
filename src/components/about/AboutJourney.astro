---
import { milestones } from '../../data/about';
---

<section class="journey">
  <div class="journey__inner">
    <div class="journey__head">
      <h2 class="journey__title">个人履历</h2>
    </div>

    <div class="journey__timeline">
      {milestones.map((m) => (
        <div class="milestone">
          <div class="milestone__year-col">
            <span class="milestone__year">{m.year}</span>
            <span class="milestone__tag">{m.tag}</span>
          </div>
          <div class="milestone__copy">
            <h3 class="milestone__title">{m.title}</h3>
            <p class="milestone__desc">{m.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .journey {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .journey__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }

  .journey__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .journey__timeline {
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: 6px 6px 0 var(--sx-sys-color-border);
  }

  .milestone {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.75rem;
    border-bottom: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
  }

  .milestone:last-child {
    border-bottom: none;
  }

  .milestone__year-col {
    flex: 0 0 12.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .milestone__year {
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-3xl);
    font-weight: 800;
    line-height: 1;
    color: var(--sx-sys-color-text-primary);
  }

  .milestone__tag {
    align-self: flex-start;
    padding: 0.25rem 0.5rem;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 800;
    letter-spacing: 0.0375em;
    color: var(--sx-sys-color-text-primary);
  }

  .milestone__copy {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .milestone__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    line-height: 1.15;
    color: var(--sx-sys-color-text-primary);
  }

  .milestone__desc {
    margin: 0;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-lg);
    line-height: 1.5;
    color: var(--sx-sys-color-text-soft);
  }

   @media (max-width: 36rem) {
    .milestone {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .milestone__year-col {
      flex-basis: auto;
    }
  }
</style>
