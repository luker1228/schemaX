---
import { nowCards, accentToken } from '../../data/about';
---

<section class="now">
  <div class="now__inner">
    <div class="now__head">
      <div class="now__title-col">
        <h2 class="now__title">此刻在做什么</h2>
        <p class="now__sub">
          一个持续更新的状态快照，记录我此刻正在构建、书写与探索的事情。
        </p>
      </div>

      <div class="now__prompt" aria-hidden="true">
        <span class="now__prompt-dollar">$</span>
        <span class="now__prompt-cmd">luke --status=now</span>
      </div>
    </div>

    <div class="now__grid">
      {nowCards.map((card) => (
        <article class="now-card">
          <div class="now-card__status">
            <span
              class="now-card__dot"
              style={`--sx-accent: ${accentToken[card.accent]}`}
            ></span>
            <span
              class="now-card__label"
              style={`--sx-accent: ${accentToken[card.accent]}`}
            >
              {card.status}
            </span>
          </div>
          <h3 class="now-card__title">{card.title}</h3>
          <p class="now-card__desc">{card.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .now {
    background: var(--sx-sys-color-terminal-bg);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .now__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* —— Head —— */
  .now__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .now__title-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .now__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-terminal-text);
  }

  .now__sub {
    margin: 0;
    max-width: 28.75rem;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sx-sys-color-terminal-muted);
  }

  .now__prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    background: var(--sx-sys-color-terminal-elevated);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-terminal-border);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.875rem;
  }

  .now__prompt-dollar {
    font-weight: 800;
    color: var(--sx-sys-color-mint);
  }

  .now__prompt-cmd {
    font-weight: 700;
    color: var(--sx-sys-color-terminal-text);
  }

  /* —— Grid —— */
  .now__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .now-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.375rem;
    background: var(--sx-sys-color-terminal-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-terminal-border);
  }

  .now-card__status {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .now-card__dot {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--sx-accent, var(--sx-sys-color-accent));
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .now-card__label {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--sx-accent, var(--sx-sys-color-accent));
  }

  .now-card__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--sx-sys-color-terminal-text);
  }

  .now-card__desc {
    margin: 0;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sx-sys-color-terminal-muted);
  }

  @media (max-width: 56rem) {
    .now__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 32rem) {
    .now__grid {
      grid-template-columns: 1fr;
    }

    .now__prompt {
      display: none;
    }
  }
</style>
