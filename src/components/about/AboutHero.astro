---
import { profile } from '../../data/profile';

const identities = [
  {
    emoji: '🔨',
    title: 'Builder',
    description: '构建 AI Agent、开发平台与开源工具',
    color: 'var(--sx-sys-color-accent)',
  },
  {
    emoji: '✍️',
    title: 'Writer',
    description: '记录系统设计、工程实践与技术思考',
    color: 'var(--sx-sys-color-mint)',
  },
  {
    emoji: '📚',
    title: 'Teacher',
    description: '把复杂知识整理成可学习、可实践的课程',
    color: 'var(--sx-sys-color-lavender)',
  },
] as const;
---

<section class="about-hero">
  <div class="about-hero__inner">
    <div class="about-hero__avatar">
      <span class="avatar-placeholder">{profile.name[0]}</span>
    </div>

    <div class="about-hero__content">
      <h1 class="about-hero__title">
        你好，我是 <span class="about-hero__name">{profile.name}</span>
      </h1>

      <p class="about-hero__role">{profile.role} & 独立构建者</p>

      <p class="about-hero__bio">
        我关注 AI Agent、Schema 驱动的设计与后端工程。SchemaX 是我的个人知识与作品平台：用结构连接课程、思考、代码、设计与 AI 执行。
      </p>

      <div class="about-hero__identities">
        {identities.map((identity) => (
          <div class="identity-card">
            <span class="identity-card__emoji" style={`--card-bg: ${identity.color}`}>
              {identity.emoji}
            </span>
            <div class="identity-card__content">
              <h3 class="identity-card__title">{identity.title}</h3>
              <p class="identity-card__desc">{identity.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(3rem, 7vw, 5rem);
    padding-inline: var(--sx-ref-space-6);
  }

  .about-hero__inner {
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--sx-ref-space-12);
    align-items: start;
  }

  /* —— 头像区域 —— */
  .about-hero__avatar {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .avatar-placeholder {
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: 4rem;
    font-weight: 700;
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-ink);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-lg);
  }

  /* —— 内容区域 —— */
  .about-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-6);
  }

  .about-hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .about-hero__name {
    background: var(--sx-sys-color-accent);
    padding: 0 0.1em;
  }

  .about-hero__role {
    margin: -0.5rem 0 0 0;
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sx-sys-color-text-soft);
  }

  .about-hero__bio {
    margin: 0;
    max-width: 45ch;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--sx-sys-color-text-soft);
  }

  /* —— 身份卡片 —— */
  .about-hero__identities {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .identity-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    background: var(--sx-sys-color-bg-page);
    box-shadow: var(--sx-sys-shadow-sm);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .identity-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--sx-sys-shadow-md);
  }

  .identity-card__emoji {
    flex: 0 0 auto;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    background: var(--card-bg, var(--sx-sys-color-accent));
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
  }

  .identity-card__content {
    flex: 1;
    min-width: 0;
  }

  .identity-card__title {
    margin: 0 0 0.25rem 0;
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: 1rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-primary);
  }

  .identity-card__desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--sx-sys-color-text-soft);
  }

  @media (max-width: 64rem) {
    .about-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--sx-ref-space-8);
    }

    .about-hero__avatar {
      position: static;
      flex-direction: row;
      justify-content: center;
    }

    .avatar-placeholder {
      max-width: 8rem;
      font-size: 3rem;
    }
  }
</style>
