---
import { aboutHero, accentToken } from '../../data/about';
---

<section class="hero">
  <img
    class="hero__deco hero__deco--graphql"
    src="/images/icons/graphql.svg"
    alt=""
    aria-hidden="true"
  />
  <img
    class="hero__deco hero__deco--python"
    src="/images/icons/python.svg"
    alt=""
    aria-hidden="true"
  />
  <img
    class="hero__deco hero__deco--docker"
    src="/images/icons/docker.svg"
    alt=""
    aria-hidden="true"
  />
  <img
    class="hero__deco hero__deco--k8s"
    src="/images/icons/k8s-official.svg"
    alt=""
    aria-hidden="true"
  />

  <div class="hero__inner">
    <nav class="hero__crumb" aria-label="Breadcrumb">
      <span class="hero__crumb-item hero__crumb-item--muted">Home</span>
      <span class="hero__crumb-sep">/</span>
      <span class="hero__crumb-item" aria-current="page">关于我</span>
    </nav>

    <h1 class="hero__title">{aboutHero.title}</h1>

    <div class="hero__principles">
      {aboutHero.principles.map((p) => (
        <span
          class="hero__principle"
          style={`--sx-accent: ${accentToken[p.accent]}`}
        >
          {p.label}
        </span>
      ))}
    </div>

    <p class="hero__intro">{aboutHero.intro}</p>
    <p class="hero__copy">{aboutHero.copy}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(2.75rem, 6vw, 3.5rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
    min-height: clamp(24rem, 50vh, 30rem);
    overflow: hidden;
  }

  /* —— 装饰图标：四角散落（设计稿 graphql/python/docker/k8s） —— */
  .hero__deco {
    position: absolute;
    pointer-events: none;
    object-fit: contain;
    z-index: 0;
  }

  /* 四角散落（对照设计稿 graphql/python/docker/k8s 的绝对坐标，转百分比） */
  .hero__deco--graphql {
    top: 20%;
    left: 8%;
    width: 4.25rem;
    height: 4.5rem;
  }

  .hero__deco--python {
    top: 30%;
    right: 8%;
    width: 4.25rem;
    height: 4.25rem;
  }

  .hero__deco--docker {
    bottom: 18%;
    left: 12%;
    width: 3.75rem;
    height: 3rem;
  }

  .hero__deco--k8s {
    bottom: 18%;
    right: 14%;
    width: 3.5rem;
    height: 3.5625rem;
  }

  /* —— 内容 —— */
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: left;
  }

  .hero__crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-sm);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-md);
    font-weight: 700;
  }

  .hero__crumb-item {
    color: var(--sx-sys-color-text-primary);
  }

  .hero__crumb-item--muted,
  .hero__crumb-sep {
    color: var(--sx-sys-color-text-soft);
  }

  .hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-lg);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .hero__principles {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block: 0.25rem;
  }

  .hero__principle {
    display: inline-flex;
    align-items: center;
    padding: 0.5625rem 0.8125rem;
    background: var(--sx-accent, var(--sx-sys-color-bg-surface));
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

  .hero__intro {
    margin: 0;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-sm);
    font-weight: 600;
    line-height: 1.25;
    color: var(--sx-sys-color-text-primary);
  }

  .hero__copy {
    margin: 0;
    max-width: 35rem;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: auto;
    }

    .hero__deco {
      display: none;
    }
  }
</style>
