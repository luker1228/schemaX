---
import { contactCta } from '../../data/about';
---

<section class="contact">
  <div class="contact__inner">
    <div class="contact__card">
      <div class="contact__eyebrow-row">
        <span class="contact__eyebrow-mark"></span>
      </div>

      <h2 class="contact__title">{contactCta.title}</h2>
      <p class="contact__sub">{contactCta.sub}</p>

      <div class="contact__actions">
        <a
          class="contact__btn contact__btn--primary"
          href={`mailto:${contactCta.email}`}
        >
          <span class="contact__btn-icon" aria-hidden="true">✉</span>
          <span class="contact__btn-label">{contactCta.email}</span>
        </a>
        <a
          class="contact__btn"
          href={contactCta.github}
          target="_blank"
          rel="me noopener"
        >
          <span class="contact__btn-label">GitHub →</span>
        </a>
        <a class="contact__btn" href={contactCta.rss}>
          <span class="contact__btn-label">RSS</span>
        </a>
      </div>

      <div class="contact__meta">
        <span class="contact__meta-item">{contactCta.meta.response}</span>
        <span class="contact__meta-item">{contactCta.meta.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--sx-sys-color-bg-page);
    padding-block: clamp(2.5rem, 5vw, 3.5rem) clamp(3rem, 5vw, 4rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .contact__inner {
    max-width: 80rem;
    margin-inline: auto;
  }

  /* —— CTA 卡片：8px 黄色硬阴影 —— */
  .contact__card {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: 9px 9px 0 var(--sx-sys-color-accent);
  }

  .contact__eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .contact__eyebrow-mark {
    width: 1.375rem;
    height: 0.5rem;
    background: var(--sx-sys-color-border);
  }

  .contact__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .contact__sub {
    margin: 0;
    max-width: 48rem;
    font-family: var(--sx-sys-font-family-body), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.6;
    color: var(--sx-sys-color-text-soft);
  }

  /* —— 按钮 —— */
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .contact__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.125rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-lg);
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-base);
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
    text-decoration: none;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .contact__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: none;
    color: var(--sx-sys-color-text-primary);
  }

  .contact__btn--primary {
    background: var(--sx-sys-color-accent);
  }

  .contact__btn-icon {
    font-size: var(--sx-sys-font-size-lg);
    font-weight: 800;
  }

  /* —— 底部 Meta —— */
  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
  }

  .contact__meta-item {
    font-family: var(--sx-sys-font-family-mono), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 800;
    letter-spacing: 0.0375em;
    color: var(--sx-sys-color-text-soft);
  }
</style>
