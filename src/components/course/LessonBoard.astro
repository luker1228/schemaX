---
// LessonBoard —— 课时白板（presentation: board）
// 结构：.lboard-root（逻辑根）
//   · .lboard（有边框的内容方框：topbar + stage）
//   · .lboard__pager（方框外、下方居中）
// 末页 next → 下一章（若有）。

import LessonHero from './LessonHero.astro';

interface Cover {
  line1: string;
  line2?: string;
  badge?: string;
  pillFill?: string;
  pillOutline?: string;
}

interface ChapterLink {
  title: string;
  href: string;
}

interface Props {
  /** 封面 Hero；有值时作为第 1 页 */
  cover?: Cover;
  /** 封面顶栏标签，默认「封面 · 开篇」 */
  coverLabel?: string;
  /** 阅读时长（仅封面展示） */
  readTime?: string;
  /** 本课最后一页后的下一章 */
  nextChapter?: ChapterLink | null;
  /**
   * 渲染模式：
   * - board（默认）：一屏约束 + 垂直居中（老行为）
   * - stepper：概念单元内可滚动 + sticky chrome + 切单元滚到顶（Khan / Codecademy 风）
   */
  mode?: 'board' | 'stepper';
}

const {
  cover,
  coverLabel = '封面 · 开篇',
  readTime,
  nextChapter = null,
  mode = 'board',
} = Astro.props;
const hasCover = Boolean(cover);
---

<div
  class="lboard-root"
  data-lboard
  data-mode={mode}
  data-has-cover={hasCover ? 'true' : 'false'}
  data-next-chapter-href={nextChapter?.href ?? ''}
  data-next-chapter-title={nextChapter?.title ?? ''}
>
  <div class="lboard">
    <header class="lboard__topbar">
      {/* 节切换：点 chip 展开目录，选中即跳转 */}
      <details class="lboard__sec" data-lboard-sec>
        <summary class="lboard__chip" data-lboard-sec-trigger>
          <span class="lboard__num" data-lboard-num aria-hidden="true">
            {hasCover ? 'START' : '—'}
          </span>
          <span class="lboard__section" data-lboard-section>
            {hasCover ? coverLabel : '…'}
          </span>
          <svg
            class="lboard__sec-chevron"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 9l6 6 6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="lboard__sec-panel" role="listbox" aria-label="本课章节">
          <p class="lboard__sec-hint">跳转到</p>
          <ul class="lboard__sec-list" data-lboard-sec-list></ul>
        </div>
      </details>
      <span class="lboard__page" data-lboard-page aria-live="polite">1 / 1</span>
    </header>

    <div class="lboard__stage" data-lboard-stage>
      {
        cover ? (
          <section
            class="lboard__slide lboard__slide--cover"
            data-lboard-slide
            data-num="START"
            data-label={coverLabel}
            data-active="true"
            id="cover"
          >
            <LessonHero
              line1={cover.line1}
              line2={cover.line2}
              badge={cover.badge}
              pillFill={cover.pillFill}
              pillOutline={cover.pillOutline}
              readTime={readTime}
            />
          </section>
        ) : null
      }
      <div class="lboard__body" data-lboard-body data-pagefind-body>
        <slot />
      </div>
    </div>
  </div>

  {/* 分页器在内容方框外 */}
  <nav class="lboard__pager" aria-label="章节导航" data-lboard-pager>
    <button
      type="button"
      class="lboard__nav lboard__nav--prev"
      data-lboard-prev
      disabled
    >
      <span class="lboard__nav-end" data-lboard-prev-end>已是第一页</span>
      <span class="lboard__nav-pair" data-lboard-prev-pair hidden>
        <svg
          class="lboard__arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M19 12H5m6-6l-6 6 6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="lboard__nav-text">
          <span class="lboard__nav-eyebrow">上一节</span>
          <span class="lboard__nav-title" data-lboard-prev-title></span>
        </span>
      </span>
    </button>

    <div class="lboard__pager-center">
      <div
        class="lboard__dots"
        data-lboard-dots
        role="tablist"
        aria-label="页码"
      >
      </div>
    </div>

    <button type="button" class="lboard__nav lboard__nav--next" data-lboard-next>
      <span class="lboard__nav-pair" data-lboard-next-pair>
        <span class="lboard__nav-text lboard__nav-text--end">
          <span class="lboard__nav-eyebrow" data-lboard-next-eyebrow>下一节</span>
          <span class="lboard__nav-title" data-lboard-next-title></span>
        </span>
        <svg
          class="lboard__arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 12h14m-6-6l6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="lboard__nav-end" data-lboard-next-end hidden>已是最后一页</span>
    </button>
  </nav>
</div>

<script>
  type SlideMeta = {
    el: HTMLElement;
    num: string;
    label: string;
    id: string;
  };

  function collectSlides(root: HTMLElement): SlideMeta[] {
    const nodes = root.querySelectorAll<HTMLElement>('[data-lboard-slide]');
    return Array.from(nodes).map((el) => ({
      el,
      num: el.dataset.num ?? '',
      label: el.dataset.label ?? '',
      id: el.id || el.dataset.num?.toLowerCase() || '',
    }));
  }

  function initBoard(root: HTMLElement) {
    if (root.dataset.ready === 'true') return;
    const slides = collectSlides(root);
    if (slides.length === 0) return;

    const numEl = root.querySelector<HTMLElement>('[data-lboard-num]');
    const sectionEl = root.querySelector<HTMLElement>('[data-lboard-section]');
    const pageEl = root.querySelector<HTMLElement>('[data-lboard-page]');
    const dotsEl = root.querySelector<HTMLElement>('[data-lboard-dots]');
    const secMenu = root.querySelector<HTMLDetailsElement>('[data-lboard-sec]');
    const secList = root.querySelector<HTMLElement>('[data-lboard-sec-list]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-lboard-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-lboard-next]');
    const prevEnd = root.querySelector<HTMLElement>('[data-lboard-prev-end]');
    const prevPair = root.querySelector<HTMLElement>('[data-lboard-prev-pair]');
    const prevTitle = root.querySelector<HTMLElement>('[data-lboard-prev-title]');
    const nextEnd = root.querySelector<HTMLElement>('[data-lboard-next-end]');
    const nextPair = root.querySelector<HTMLElement>('[data-lboard-next-pair]');
    const nextTitle = root.querySelector<HTMLElement>('[data-lboard-next-title]');
    const nextEyebrow = root.querySelector<HTMLElement>(
      '[data-lboard-next-eyebrow]',
    );

    const nextChapterHref = root.dataset.nextChapterHref?.trim() || '';
    const nextChapterTitle = root.dataset.nextChapterTitle?.trim() || '';
    const hasNextChapter = Boolean(nextChapterHref);

    let index = 0;
    const total = slides.length;

    // 底栏圆点
    if (dotsEl) {
      dotsEl.replaceChildren();
      slides.forEach((s, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'lboard__dot';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `第 ${i + 1} 页 · ${s.label}`);
        dot.dataset.lboardDot = String(i);
        dot.addEventListener('click', () => go(i));
        dotsEl.appendChild(dot);
      });
    }

    // 顶栏节目录（一点即跳）
    if (secList) {
      secList.replaceChildren();
      slides.forEach((s, i) => {
        const li = document.createElement('li');
        li.className = 'lboard__sec-item';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'lboard__sec-btn';
        btn.dataset.lboardSecIdx = String(i);
        btn.setAttribute('role', 'option');
        btn.innerHTML = `<span class="lboard__sec-btn-num"></span><span class="lboard__sec-btn-label"></span><span class="lboard__sec-btn-page"></span>`;
        const numSpan = btn.querySelector('.lboard__sec-btn-num');
        const labelSpan = btn.querySelector('.lboard__sec-btn-label');
        const pageSpan = btn.querySelector('.lboard__sec-btn-page');
        if (numSpan) numSpan.textContent = s.num || String(i + 1);
        if (labelSpan) labelSpan.textContent = s.label || `第 ${i + 1} 页`;
        if (pageSpan) pageSpan.textContent = `${i + 1}`;
        btn.addEventListener('click', () => {
          go(i);
          if (secMenu) secMenu.open = false;
        });
        li.appendChild(btn);
        secList.appendChild(li);
      });
    }

    // 点菜单外关闭
    const onDocClick = (e: MouseEvent) => {
      if (!secMenu?.open) return;
      const t = e.target as Node | null;
      if (t && !secMenu.contains(t)) secMenu.open = false;
    };
    document.addEventListener('click', onDocClick);

    function go(
      next: number,
      opts: { pushHash?: boolean; scrollIntoView?: boolean } = {},
    ) {
      const i = Math.max(0, Math.min(total - 1, next));
      index = i;
      const current = slides[i];
      if (!current) return;

      slides.forEach((s, j) => {
        const on = j === i;
        s.el.dataset.active = on ? 'true' : 'false';
        s.el.hidden = !on;
        s.el.setAttribute('aria-hidden', on ? 'false' : 'true');
      });

      if (numEl) numEl.textContent = current.num || '—';
      if (sectionEl) sectionEl.textContent = current.label || '';
      if (pageEl) pageEl.textContent = `${i + 1} / ${total}`;

      // dots
      dotsEl?.querySelectorAll<HTMLElement>('[data-lboard-dot]').forEach((dot) => {
        const on = Number(dot.dataset.lboardDot) === i;
        dot.dataset.active = on ? 'true' : 'false';
        dot.setAttribute('aria-selected', on ? 'true' : 'false');
        dot.tabIndex = on ? 0 : -1;
      });

      // 节菜单当前项
      secList
        ?.querySelectorAll<HTMLElement>('[data-lboard-sec-idx]')
        .forEach((btn) => {
          const on = Number(btn.dataset.lboardSecIdx) === i;
          btn.dataset.active = on ? 'true' : 'false';
          btn.setAttribute('aria-selected', on ? 'true' : 'false');
        });

      // prev
      const atStart = i === 0;
      if (prevBtn) prevBtn.disabled = atStart;
      if (prevEnd) prevEnd.hidden = !atStart;
      if (prevPair) prevPair.hidden = atStart;
      if (!atStart && prevTitle) {
        prevTitle.textContent = slides[i - 1]?.label ?? '';
      }

      // next：未到末页 → 下一节；末页有下一章 → 下一章；否则禁用
      const atEnd = i === total - 1;
      const nextIsChapter = atEnd && hasNextChapter;
      if (nextBtn) {
        nextBtn.disabled = atEnd && !hasNextChapter;
        nextBtn.dataset.mode = nextIsChapter ? 'chapter' : 'section';
      }
      if (nextEnd) nextEnd.hidden = !(atEnd && !hasNextChapter);
      if (nextPair) nextPair.hidden = atEnd && !hasNextChapter;
      if (nextEyebrow) {
        nextEyebrow.textContent = nextIsChapter ? '下一章' : '下一节';
      }
      if (nextTitle) {
        if (nextIsChapter) {
          nextTitle.textContent = nextChapterTitle;
        } else if (!atEnd) {
          nextTitle.textContent = slides[i + 1]?.label ?? '';
        } else {
          nextTitle.textContent = '';
        }
      }

      // hash（封面用 cover，步骤用 id）；board 不自动 scroll，保持当前视口
      if (opts.pushHash !== false && current.id) {
        const url = new URL(window.location.href);
        url.hash = current.id;
        history.replaceState(null, '', url);
      }

      // stepper：单元内允许滚动，切单元时滚到单元顶（避让 sticky 顶栏）。
      // board 模式 root.dataset.mode !== 'stepper'，保持原「不 scroll」行为。
      // rAF 等 inactive slide 的 hidden 生效、布局稳定后再滚，避免滚错位置。
      if (root.dataset.mode === 'stepper' && opts.scrollIntoView !== false) {
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        // 'instant' 是 CSSOM 合法值（离散跳转、无动画）；部分 TS lib 的
        // ScrollBehavior 联合类型尚未收录，故以联合字面量断言规避类型报错。
        const behavior = (reduceMotion ? 'auto' : 'instant') as ScrollBehavior;
        requestAnimationFrame(() => {
          current.el.scrollIntoView({ block: 'start', behavior });
        });
      }
    }

    prevBtn?.addEventListener('click', () => go(index - 1));
    nextBtn?.addEventListener('click', () => {
      if (index >= total - 1 && hasNextChapter) {
        window.location.href = nextChapterHref;
        return;
      }
      go(index + 1);
    });

    // 键盘：← → / PageUp PageDown / Home End（菜单打开时 Esc 关闭）
    const onKey = (e: KeyboardEvent) => {
      if (!root.isConnected) return;
      if (e.key === 'Escape' && secMenu?.open) {
        secMenu.open = false;
        return;
      }
      const t = e.target as HTMLElement | null;
      if (
        t &&
        (t.tagName === 'INPUT' ||
          t.tagName === 'TEXTAREA' ||
          t.tagName === 'SELECT' ||
          t.isContentEditable)
      ) {
        return;
      }
      // 菜单打开时用上下键选节
      if (secMenu?.open && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        e.preventDefault();
        go(e.key === 'ArrowDown' ? index + 1 : index - 1);
        return;
      }
      const active = document.activeElement as HTMLElement | null;
      const focusInBoard =
        !active || active === document.body || root.contains(active);
      if (!focusInBoard) return;

      if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        e.preventDefault();
        if (index >= total - 1 && hasNextChapter) {
          window.location.href = nextChapterHref;
          return;
        }
        go(index + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        go(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        go(total - 1);
      }
    };
    document.addEventListener('keydown', onKey);

    // 初始：hash 优先，否则封面 / 第一页
    let start = 0;
    const hash = window.location.hash.replace(/^#/, '');
    if (hash) {
      const hit = slides.findIndex((s) => s.id === hash || s.el.id === hash);
      if (hit >= 0) start = hit;
    }

    go(start, { pushHash: Boolean(hash), scrollIntoView: Boolean(hash) });
    root.dataset.ready = 'true';
    root.setAttribute('tabindex', '0');
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-lboard]').forEach(initBoard);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  /* 逻辑根：包住方框 + 框外分页 */
  .lboard-root {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0;
    outline: none;
  }

  .lboard-root:focus-visible {
    outline: 2px solid var(--sx-sys-color-action, #2f5bea);
    outline-offset: 3px;
  }

  /* 内容方框：1px 黑边 + 2px 圆角（分页器在框外） */
  .lboard {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* 有底高，短页才能在框内垂直居中；过高会显空 */
    min-height: min(60vh, 36rem);
    max-height: none;
    box-sizing: border-box;
    background: var(--sx-sys-color-bg-page);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 2px;
    box-shadow: none;
    overflow: visible;
    padding: 1rem 1.25rem 1.25rem;
  }

  /*
   * Topbar：元信息层，不抢正文重心
   * 无硬影 / 无黄底 pill / 无黑底号牌 —— 小字号 + 软色 + 透明底
   */
  .lboard__topbar {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    flex-shrink: 0;
    padding: 0 0 0.5rem;
    margin: 0 0 0.25rem;
    background: transparent;
    border-bottom: none;
    position: relative;
    z-index: 5;
  }

  /* 节切换菜单（原生 details，零 React） */
  .lboard__sec {
    position: relative;
    max-width: min(100%, 22rem);
  }

  .lboard__sec > summary {
    list-style: none;
  }

  .lboard__sec > summary::-webkit-details-marker {
    display: none;
  }

  .lboard__chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.1rem;
    background: transparent;
    border: none;
    border-radius: 2px;
    box-shadow: none;
    cursor: pointer;
    user-select: none;
    color: var(--sx-sys-color-text-soft);
    transition: color 120ms ease;
  }

  .lboard__chip:hover {
    color: var(--sx-sys-color-text-primary);
  }

  .lboard__chip:focus-visible {
    outline: 2px solid var(--sx-sys-color-action, #2f5bea);
    outline-offset: 2px;
  }

  .lboard__sec[open] .lboard__chip {
    color: var(--sx-sys-color-text-primary);
  }

  .lboard__sec-chevron {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    opacity: 0.55;
    transition:
      transform 120ms ease,
      opacity 120ms ease;
  }

  .lboard__chip:hover .lboard__sec-chevron,
  .lboard__sec[open] .lboard__sec-chevron {
    opacity: 0.9;
  }

  .lboard__sec[open] .lboard__sec-chevron {
    transform: rotate(180deg);
  }

  .lboard__num {
    display: inline-block;
    padding: 0;
    background: transparent;
    color: inherit;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    white-space: nowrap;
    line-height: 1.3;
    opacity: 0.75;
  }

  .lboard__sec[open] .lboard__num {
    opacity: 0.9;
  }

  .lboard__section {
    font-family: var(--sx-sys-font-family-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* 页码：纯等宽软字，无黄 pill */
  .lboard__page {
    display: inline-block;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--sx-sys-color-text-soft);
    white-space: nowrap;
    line-height: 1.3;
    letter-spacing: 0.03em;
    opacity: 0.85;
  }

  .lboard__sec-panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 20;
    min-width: min(16rem, 85vw);
    max-width: min(22rem, 92vw);
    max-height: min(18rem, 45vh);
    overflow: auto;
    padding: 0.4rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 2px;
    box-shadow: var(--sx-sys-shadow-sm);
    scrollbar-width: thin;
  }

  .lboard__sec-hint {
    margin: 0;
    padding: 0.25rem 0.5rem 0.4rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-soft);
  }

  .lboard__sec-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* 动态节点：:global */
  .lboard__sec-list :global(.lboard__sec-item) {
    margin: 0;
    padding: 0;
  }

  .lboard__sec-list :global(.lboard__sec-btn) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    margin: 0;
    padding: 0.5rem 0.6rem;
    border: var(--sx-sys-border-width) solid transparent;
    background: transparent;
    color: var(--sx-sys-color-text-primary);
    cursor: pointer;
    font: inherit;
    text-align: left;
    box-sizing: border-box;
  }

  .lboard__sec-list :global(.lboard__sec-btn:hover) {
    background: var(--sx-sys-color-bg-page);
    border-color: var(--sx-sys-color-border);
  }

  .lboard__sec-list :global(.lboard__sec-btn:focus-visible) {
    outline: 2px solid var(--sx-sys-color-action, #2f5bea);
    outline-offset: 1px;
  }

  .lboard__sec-list :global(.lboard__sec-btn[data-active='true']) {
    background: var(--sx-sys-color-accent);
    border-color: var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .lboard__sec-list :global(.lboard__sec-btn-num) {
    flex-shrink: 0;
    min-width: 3.25rem;
    padding: 0.2rem 0.4rem;
    background: var(--sx-sys-color-border);
    color: var(--sx-sys-color-accent);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    line-height: 1.3;
  }

  .lboard__sec-list :global(.lboard__sec-btn[data-active='true'] .lboard__sec-btn-num) {
    background: var(--sx-sys-color-border);
  }

