---
// LayerPair —— 视觉图层树 ↔ HTML 标签树 并排对照
// 左：图层面板 mock（▾ + # / T + 缩进）
// 右：代码窗口（语法着色 + 同 data-key 高亮）
// 下：双视角说明
// 零 JS：:has([data-key]:hover) 左右联动
interface Props {
  id?: string;
  layersTitle?: string;
  fileName?: string;
}
const {
  id = 'htmlPair',
  layersTitle = '图层 · LAYERS',
  fileName = 'card.html',
} = Astro.props;

type LayerKind = 'frame' | 'text';

type LayerRow = {
  key: string;
  depth: 0 | 1 | 2;
  kind: LayerKind;
  label: string;
  /** 有子层 → 展开三角；叶子留空位对齐 */
  expanded?: boolean;
};

const layers: LayerRow[] = [
  { key: 'card', depth: 0, kind: 'frame', label: 'Card', expanded: true },
  { key: 'header', depth: 1, kind: 'frame', label: 'Header', expanded: true },
  { key: 'title', depth: 2, kind: 'text', label: 'Title' },
  { key: 'desc', depth: 2, kind: 'text', label: 'Description' },
  { key: 'btn', depth: 1, kind: 'frame', label: 'Button' },
];

type CodePart = { kind: 'tag' | 'attr' | 'str' | 'text'; text: string };

type CodeLine = {
  key: string;
  /** 嵌套深度，用 padding 表达缩进（避免 pre 内空格节点被模板空白弄乱） */
  depth: 0 | 1 | 2;
  parts: CodePart[];
};

const codeLines: CodeLine[] = [
  {
    key: 'card',
    depth: 0,
    parts: [
      { kind: 'tag', text: '<div' },
      { kind: 'text', text: ' ' },
      { kind: 'attr', text: 'class' },
      { kind: 'text', text: '=' },
      { kind: 'str', text: '"card"' },
      { kind: 'tag', text: '>' },
    ],
  },
  {
    key: 'header',
    depth: 1,
    parts: [
      { kind: 'tag', text: '<div' },
      { kind: 'text', text: ' ' },
      { kind: 'attr', text: 'class' },
      { kind: 'text', text: '=' },
      { kind: 'str', text: '"header"' },
      { kind: 'tag', text: '>' },
    ],
  },
  {
    key: 'title',
    depth: 2,
    parts: [
      { kind: 'tag', text: '<h3>' },
      { kind: 'text', text: '标题' },
      { kind: 'tag', text: '</h3>' },
    ],
  },
  {
    key: 'desc',
    depth: 2,
    parts: [
      { kind: 'tag', text: '<p>' },
      { kind: 'text', text: '一段描述…' },
      { kind: 'tag', text: '</p>' },
    ],
  },
  {
    key: 'header',
    depth: 1,
    parts: [{ kind: 'tag', text: '</div>' }],
  },
  {
    key: 'btn',
    depth: 1,
    parts: [
      { kind: 'tag', text: '<button>' },
      { kind: 'text', text: '了解更多' },
      { kind: 'tag', text: '</button>' },
    ],
  },
  {
    key: 'card',
    depth: 0,
    parts: [{ kind: 'tag', text: '</div>' }],
  },
];

const partClass: Record<CodePart['kind'], string | null> = {
  tag: 'layer-pair__ctag',
  attr: 'layer-pair__cattr',
  str: 'layer-pair__cstr',
  text: null,
};
---

<div class="layer-pair" id={id}>
  <div class="layer-pair__panels">
    {/* —— 左：图层面板 —— */}
    <section class="layer-pair__figma" aria-label="图层树">
      <header class="layer-pair__panel-bar">
        <span class="layer-pair__panel-label">{layersTitle}</span>
      </header>
      <div class="layer-pair__layers" role="tree" aria-label="图层列表">
        {
          layers.map((row) => (
            <div
              class:list={['layer-pair__layer', `layer-pair__layer--d${row.depth}`]}
              data-key={row.key}
              role="treeitem"
              aria-expanded={row.expanded ? 'true' : undefined}
              style={`--sx-layer-depth: ${row.depth}`}
            >
              <span
                class:list={['layer-pair__caret', row.expanded && 'layer-pair__caret--open']}
                aria-hidden="true"
              >
                {
                  row.expanded ? (
                    <svg
                      class="layer-pair__caret-svg"
                      viewBox="0 0 8 8"
                      width="8"
                      height="8"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M1.2 2.4 L4 5.6 L6.8 2.4 Z" />
                    </svg>
                  ) : null
                }
              </span>
              <span
                class:list={[
                  'layer-pair__ic',
                  row.kind === 'frame' ? 'layer-pair__ic--frame' : 'layer-pair__ic--text',
                ]}
                aria-hidden="true"
                title={row.kind === 'frame' ? 'Frame' : 'Text'}
              >
                {
                  row.kind === 'frame' ? (
                    <svg
                      class="layer-pair__svg"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M5.5 1.5v13M10.5 1.5v13M1.5 5.5h13M1.5 10.5h13"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="square"
                      />
                    </svg>
                  ) : (
                    <svg
                      class="layer-pair__svg"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3.25 3.5h9.5M8 3.5v9"
                        stroke="currentColor"
                        stroke-width="1.65"
                        stroke-linecap="square"
                      />
                    </svg>
                  )
                }
              </span>
              <span class="layer-pair__name">{row.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    {/* —— 右：代码窗口 —— */}
    <section class="layer-pair__code" aria-label="对应 HTML">
      <header class="layer-pair__panel-bar layer-pair__panel-bar--code">
        <span class="layer-pair__dots" aria-hidden="true">
          <span class="layer-pair__dot layer-pair__dot--red"></span>
          <span class="layer-pair__dot layer-pair__dot--yellow"></span>
          <span class="layer-pair__dot layer-pair__dot--green"></span>
        </span>
        <span class="layer-pair__fname">{fileName}</span>
        <span class="layer-pair__lang">html</span>
      </header>
      {/*
        行内不换行：pre + white-space:pre 时，模板缩进空白会变成真字符。
        缩进改由 --sx-code-depth + padding-left 承担。
      */}
      <pre class="layer-pair__pre" tabindex="0">{
        codeLines.map((line) => (
          <span
            class="layer-pair__cline"
            data-key={line.key}
            style={`--sx-code-depth: ${line.depth}`}
          >{line.parts.map((p) =>
              partClass[p.kind] ? (
                <span class={partClass[p.kind]!}>{p.text}</span>
              ) : (
                p.text
              ),
            )}</span>
        ))
      }</pre>
    </section>
  </div>

  {/* —— 底注 —— */}
  <div class="layer-pair__caption">
    <div class="layer-pair__cap">
      <div class="layer-pair__cap-k">
        <span class="layer-pair__cap-mark" aria-hidden="true"></span>
        视觉视角
      </div>
      <p>
        一棵<strong>图层树</strong>。框套框，每个图层有名字、有层级、有缩进。
      </p>
    </div>
    <div class="layer-pair__cap">
      <div class="layer-pair__cap-k">
        <span class="layer-pair__cap-mark" aria-hidden="true"></span>
        代码视角
      </div>
      <p>
        一棵<strong>标签树</strong>。<code>&lt;div&gt;</code> 套 <code>&lt;div&gt;</code>，每个标签有名字、有层级、有缩进——一模一样的事。
      </p>
    </div>
  </div>
</div>

<style>
  .layer-pair {
    --sx-lp-row-pad-y: 0.4rem;
    --sx-lp-indent: 1rem;
    --sx-lp-gap: 1rem;
    /* 选中 / 悬停联动：橙红（danger），不用 accent 黄 */
    --sx-lp-select: var(--sx-sys-color-danger);

    display: flex;
    flex-direction: column;
    gap: var(--sx-lp-gap);
    width: 100%;
    /* 外层不再包一整块：双栏各自成卡 */
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .layer-pair__panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: var(--sx-lp-gap);
    min-width: 0;
  }

  /* ── 共用顶栏：等高、同墨底 ── */
  .layer-pair__panel-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.5rem 0.875rem;
    box-sizing: border-box;
    background: var(--sx-sys-color-border);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .layer-pair__panel-label {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-accent);
  }
  .layer-pair__fname {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sx-sys-color-bg-surface);
  }
  .layer-pair__lang {
    margin-left: auto;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-accent);
    opacity: 0.9;
  }

  /* ── 左：图层面板（独立卡） ── */
  .layer-pair__figma {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: none;
    overflow: hidden;
  }
  .layer-pair__layers {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 0.125rem;
    padding: 0.625rem 0.5rem 0.75rem;
  }
  .layer-pair__layer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: var(--sx-lp-row-pad-y) 0.45rem;
    padding-left: calc(0.45rem + var(--sx-layer-depth, 0) * var(--sx-lp-indent));
    border-radius: 2px;
    font-family: var(--sx-sys-font-family-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--sx-sys-color-text-primary);
    cursor: default;
    transition: background 0.12s ease;
  }
  .layer-pair__caret {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.75rem;
    height: 0.75rem;
    color: var(--sx-sys-color-text-muted);
  }
  .layer-pair__caret-svg {
    display: block;
    width: 8px;
    height: 8px;
  }
  .layer-pair__ic {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    color: var(--sx-sys-color-text-muted);
  }
  .layer-pair__layer--d1 .layer-pair__ic,
  .layer-pair__layer--d2 .layer-pair__ic {
    color: var(--sx-sys-color-text-soft);
  }
  .layer-pair__svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .layer-pair__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── 右：代码（独立卡）—— 纯白底 ── */
  .layer-pair__code {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: none;
    overflow: hidden;
  }
  .layer-pair__dots {
    display: inline-flex;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .layer-pair__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .layer-pair__dot--red {
    background: var(--sx-sys-color-danger);
  }
  .layer-pair__dot--yellow {
    background: var(--sx-sys-color-accent);
  }
  .layer-pair__dot--green {
    background: var(--sx-sys-color-success);
  }
  .layer-pair__pre {
    margin: 0;
    padding: 0.75rem 0.5rem 0.875rem;
    flex: 1 1 auto;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--sx-sys-color-text-primary);
    overflow-x: auto;
    /* normal：折叠 map 行间空白节点；缩进靠 --sx-code-depth */
    white-space: normal;
    border: none;
    background: transparent;
  }
  .layer-pair__pre:focus {
    outline: none;
  }
  .layer-pair__pre:focus-visible {
    box-shadow: inset 0 0 0 2px var(--sx-sys-color-action-primary);
  }
  .layer-pair__cline {
    display: block;
    padding: 0.08rem 0.4rem;
    padding-left: calc(0.4rem + var(--sx-code-depth, 0) * 1.1rem);
    margin: 0;
    border-radius: 2px;
    transition: background 0.12s ease;
  }
  .layer-pair__ctag {
    color: var(--sx-sys-color-action-primary);
    font-weight: 700;
  }
  .layer-pair__cattr {
    color: var(--sx-sys-color-text-soft);
    font-weight: 600;
  }
  .layer-pair__cstr {
    color: var(--sx-sys-color-success);
    font-weight: 600;
  }

  /* ── 左右联动 ── */
  .layer-pair:has([data-key='card']:hover) [data-key='card'],
  .layer-pair:has([data-key='header']:hover) [data-key='header'],
  .layer-pair:has([data-key='title']:hover) [data-key='title'],
  .layer-pair:has([data-key='desc']:hover) [data-key='desc'],
  .layer-pair:has([data-key='btn']:hover) [data-key='btn'] {
    background: color-mix(in srgb, var(--sx-lp-select) 42%, transparent);
  }

  /* ── 底注：与上方面板同宽拆成两卡 ── */
  .layer-pair__caption {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sx-lp-gap);
    background: transparent;
  }
  .layer-pair__cap {
    padding: 1rem 1.125rem 1.125rem;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-page);
    box-shadow: none;
  }
  .layer-pair__cap-k {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.45rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
  }
  .layer-pair__cap-mark {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .layer-pair__cap p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sx-sys-color-text-soft);
  }
  .layer-pair__cap strong {
    color: var(--sx-sys-color-text-primary);
    font-weight: 700;
  }
  .layer-pair__cap :global(code) {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125em;
    font-weight: 700;
    padding: 0.05em 0.3em;
    color: var(--sx-sys-color-text-primary);
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  @media (max-width: 720px) {
    .layer-pair__panels,
    .layer-pair__caption {
      grid-template-columns: 1fr;
    }
  }
</style>
