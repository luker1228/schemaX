---
// StepSplit —— 课时「讲解 + 1～2 示意」三档布局（扫课统一）
//
// layout（请显式写上，少用 auto）:
//   aside —— 左文 · 右小图（单 Preview / 单 Card）
//   rail  —— 左窄讲解 · 右大舞台（交互岛 / 宽 Demo / 练习）
//   stack —— 上短文 · 下全宽（CodeCompare / LayerPair / 多 Preview）
//   auto  —— 按 figure 内容推断（兜底）
//   fill  —— 少用；讲解顶带 + figure 尽量满宽
//
// 兼容：wide → rail；stack 布尔 → stack
//
//   <StepSplit layout="aside">
//     <SectionHead ... />
//     <p>...</p>
//     <Preview slot="figure" />
//   </StepSplit>

export type StepSplitLayout = 'auto' | 'aside' | 'rail' | 'stack' | 'fill';

interface Props {
  /**
   * 布局模式。默认 auto：根据 figure 内是否出现
   * CodeCompare / LayerPair / Playground 等自动切换。
   */
  layout?: StepSplitLayout;
  /** @deprecated 用 layout="rail" */
  wide?: boolean;
  /** @deprecated 用 layout="stack"；布尔 true 时等价 stack */
  stack?: boolean;
  class?: string;
}

const {
  layout: layoutProp = 'auto',
  wide = false,
  stack: stackBool = false,
  class: className,
} = Astro.props;

/** 解析最终 layout：显式 stack/wide 布尔优先于 layout 字符串（兼容旧 MDX） */
const layout: StepSplitLayout = stackBool
  ? 'stack'
  : wide
    ? 'rail'
    : layoutProp;

const layoutClass = `step-split--${layout}`;
---

<div
  class:list={['step-split', layoutClass, className]}
  data-layout={layout}
>
  <div class="step-split__copy">
    <slot />
  </div>
  <div class="step-split__figure">
    <slot name="figure" />
  </div>
</div>

<style>
  /*
   * 拓扑约定（≥900px）：
   *   aside  1fr | 16–20rem
   *   rail   13–17rem | 1fr
   *   stack  1fr（上下）
   *   fill   1fr（上下，figure 更疏）
   *   auto   默认 aside，再用 :has() 升格
   */

  .step-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    width: 100%;
    min-width: 0;
  }

  .step-split__copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .step-split__copy > :global(p + p) {
    margin-block-start: 0;
  }

  .step-split__copy > :global(.sec-head + *) {
    margin-block-start: 0;
  }

  .step-split__copy > :global(p) {
    max-width: 42rem;
  }

  .step-split__figure {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
    width: 100%;
  }

  .step-split__figure > :global(*) {
    max-width: 100%;
  }

  .step-split__figure > :global(.cmp),
  .step-split__figure > :global(.doc-code),
  .step-split__figure > :global(.doc-playground),
  .step-split__figure > :global(.layer-pair),
  .step-split__figure > :global(.props-pair) {
    width: 100%;
  }

  /* —— stack / fill：上下结构（小屏也是） —— */
  .step-split--stack,
  .step-split--fill {
    gap: 1.125rem;
  }

  .step-split--stack .step-split__copy,
  .step-split--fill .step-split__copy {
    gap: 0.625rem;
    max-width: 48rem;
  }

  .step-split--fill .step-split__figure {
    gap: 1rem;
  }

  /* —— auto：小屏一律纵排；大屏按内容升格 —— */
   @media (min-width: 64rem) {
    /* 默认 / aside / auto 基线：左文右小图 */
    .step-split--aside,
    .step-split--auto {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      gap: 1.5rem 1.75rem;
    }

    /* rail：讲解窄轨 + 示意吃剩余 */
    .step-split--rail {
      grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
      gap: 1.5rem 1.5rem;
    }

    .step-split--rail .step-split__copy > :global(p) {
      max-width: none;
    }

    /* stack / fill 保持全宽单列 */
    .step-split--stack,
    .step-split--fill {
      grid-template-columns: minmax(0, 1fr);
    }

    .step-split--fill .step-split__copy {
      max-width: 40rem;
    }

    /*
     * auto 升格规则（只读 figure 子树，作者可不写 layout）：
     * 1) 双窗对照 / 图层对 → stack（需要整行横宽）
     * 2) 交互岛 / LIVE 舞台 → rail（示意主导）
     * 3) 其余保持 aside
     */
    .step-split--auto:has(
      .step-split__figure :is(.cmp, .layer-pair, .props-pair)
    ) {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.125rem;
    }

    .step-split--auto:has(
      .step-split__figure :is(.cmp, .layer-pair, .props-pair)
    )
      .step-split__copy {
      max-width: 48rem;
      gap: 0.625rem;
    }

    .step-split--auto:has(
      .step-split__figure
        :is(
          .doc-playground,
          .shop-nerve,
          .card.shop-nerve,
          [class*='Drill'],
          [class*='Quiz']
        )
    ):not(
      :has(.step-split__figure :is(.cmp, .layer-pair, .props-pair))
    ) {
      grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
      gap: 1.5rem 1.5rem;
    }

    .step-split--auto:has(
      .step-split__figure
        :is(
          .doc-playground,
          .shop-nerve,
          .card.shop-nerve,
          [class*='Drill'],
          [class*='Quiz']
        )
    ):not(
      :has(.step-split__figure :is(.cmp, .layer-pair, .props-pair))
    )
      .step-split__copy
      > :global(p) {
      max-width: none;
    }
  }

  /*
   * centered 修饰：讲解块水平居中（用于 stack 下「上文 + 居中交互」，
   * 如练习题：讲解居中与下方 quiz 卡片对齐）。显式传入 class 才生效，
   * 不影响其它 stack 页面。
   */
  .step-split--centered .step-split__copy {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .step-split--centered :global(.sec-head__title) {
    align-items: center;
  }
</style>
