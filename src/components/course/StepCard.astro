---
// StepCard —— 课时内步骤分区（轻量）
// 无白底/硬阴影/分隔线；靠编号徽章 + 标签分节。
// 演示块（Preview / Note / 交互岛）各自保留硬边，不在外壳再套一层重卡。
// presentation=board 时：外壳成为白板一页（data-lboard-slide），顶栏接管 num/label。
interface Props {
  /** 步骤编号，如 "HTML-01" "CSS-03"；同时作为锚点 id（小写） */
  num: string;
  /** 步骤标签，如 "核心" "标题" "练习" */
  label: string;
}
const { num, label } = Astro.props;
const anchorId = num.toLowerCase();
---

<section
  class="step"
  id={anchorId}
  data-lboard-slide
  data-num={num}
  data-label={label}
>
  <header class="step__head">
    <span class="step__num">{num}</span>
    <span class="step__label">{label}</span>
  </header>
  <div class="step__body">
    <slot />
  </div>
</section>

<style>
  .step {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    width: 100%;
    box-sizing: border-box;
    scroll-margin-top: calc(
      var(--sx-comp-header-logo-size) + 2 * var(--sx-comp-header-padding-block) +
        1rem
    );
  }

  .step__head {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .step__num {
    display: inline-block;
    padding: 5px 10px;
    background: var(--sx-sys-color-border);
    color: var(--sx-sys-color-accent);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    white-space: nowrap;
  }

  .step__label {
    font-family: var(--sx-sys-font-family-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--sx-sys-color-text-primary);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .step__body > :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--sx-sys-color-text-soft);
    margin: 0;
  }
</style>
