---
// PropsPair —— Figma 属性面板 ↔ CSS 声明 并排对照
// 左：Design 属性 mock（Layout / Fill / Text + data-key）
// 右：代码窗口（语法着色 + 同 data-key 高亮）
// 下：双视角说明
// 零 JS：:has([data-key]:hover) 左右联动
interface Props {
  id?: string;
  propsTitle?: string;
  fileName?: string;
}
const {
  id = 'cssPair',
  propsTitle = 'Design · 属性',
  fileName = 'style.css',
} = Astro.props;

type PropKind = 'number' | 'color';

type PropRow = {
  key: string;
  kind: PropKind;
  prefix?: string;
  value: string;
  hint: string;
  /** 色块用 token（仅 color 行） */
  chipVar?: string;
  /** 色块是否需要描边（浅色字色时） */
  chipBorder?: boolean;
};

type PropSection = {
  title: string;
  rows: PropRow[];
};

const sections: PropSection[] = [
  {
    title: 'Layout · 布局',
    rows: [
      { key: 'padding', kind: 'number', prefix: 'P', value: '20', hint: '内边距' },
      { key: 'radius', kind: 'number', prefix: '⌒', value: '8', hint: '圆角' },
    ],
  },
  {
    title: 'Fill · 填充',
    rows: [
      {
        key: 'bg',
        kind: 'color',
        value: 'FFDC58',
        hint: '100%',
        chipVar: 'var(--sx-sys-color-accent)',
      },
    ],
  },
  {
    title: 'Text · 文字',
    rows: [
      { key: 'font-size', kind: 'number', prefix: 'Aa', value: '14', hint: '字号' },
      {
        key: 'color',
        kind: 'color',
        value: '000000',
        hint: '字色',
        chipVar: 'var(--sx-sys-color-text-primary)',
        chipBorder: true,
      },
    ],
  },
];

type CodePart =
  | { kind: 'sel'; text: string }
  | { kind: 'plain'; text: string }
  | { kind: 'key'; text: string }
  | { kind: 'num'; text: string }
  | { kind: 'str'; text: string };

type CodeLine =
  | { type: 'open'; parts: CodePart[] }
  | { type: 'close' }
  | { type: 'decl'; key: string; parts: CodePart[] };

// 声明顺序与左侧属性面板一致：Layout → Fill → Text
const codeLines: CodeLine[] = [
  {
    type: 'open',
    parts: [
      { kind: 'sel', text: '.button' },
      { kind: 'plain', text: ' {' },
    ],
  },
  {
    type: 'decl',
    key: 'padding',
    parts: [
      { kind: 'key', text: 'padding' },
      { kind: 'plain', text: ': ' },
      { kind: 'num', text: '20' },
      { kind: 'str', text: 'px' },
      { kind: 'plain', text: ';' },
    ],
  },
  {
    type: 'decl',
    key: 'radius',
    parts: [
      { kind: 'key', text: 'border-radius' },
      { kind: 'plain', text: ': ' },
      { kind: 'num', text: '8' },
      { kind: 'str', text: 'px' },
      { kind: 'plain', text: ';' },
    ],
  },
  {
    type: 'decl',
    key: 'bg',
    parts: [
      { kind: 'key', text: 'background' },
      { kind: 'plain', text: ': ' },
      { kind: 'str', text: '#FFDC58' },
      { kind: 'plain', text: ';' },
    ],
  },
  {
    type: 'decl',
    key: 'font-size',
    parts: [
      { kind: 'key', text: 'font-size' },
      { kind: 'plain', text: ': ' },
      { kind: 'num', text: '14' },
      { kind: 'str', text: 'px' },
      { kind: 'plain', text: ';' },
    ],
  },
  {
    type: 'decl',
    key: 'color',
    parts: [
      { kind: 'key', text: 'color' },
      { kind: 'plain', text: ': ' },
      { kind: 'str', text: '#000000' },
      { kind: 'plain', text: ';' },
    ],
  },
  { type: 'close' },
];

const partClass: Record<CodePart['kind'], string | null> = {
  sel: 'props-pair__csel',
  plain: null,
  key: 'props-pair__ckey',
  num: 'props-pair__cnum',
  str: 'props-pair__cstr',
};
---

<div class="props-pair" id={id}>
  <div class="props-pair__panels">
    {/* —— 左：Figma 属性面板 —— */}
    <section class="props-pair__figma" aria-label="Figma 属性面板">
      <header class="props-pair__panel-bar">
        <span class="props-pair__panel-label">{propsTitle}</span>
      </header>
      <div class="props-pair__props">
        {
          sections.map((section) => (
            <div class="props-pair__section">
              <div class="props-pair__section-title">{section.title}</div>
              {section.rows.map((row) => (
                <div class="props-pair__row" data-key={row.key}>
                  {row.kind === 'number' ? (
                    <>
                      <span class="props-pair__prefix" aria-hidden="true">
                        {row.prefix}
                      </span>
                      <span class="props-pair__input">{row.value}</span>
                      <span class="props-pair__hint">{row.hint}</span>
                    </>
                  ) : (
                    <>
                      <span
                        class:list={[
                          'props-pair__chip',
                          row.chipBorder && 'props-pair__chip--bordered',
                        ]}
                        style={row.chipVar ? `background: ${row.chipVar}` : undefined}
                        aria-hidden="true"
                      />
                      <span class="props-pair__hex">{row.value}</span>
                      <span class="props-pair__hint">{row.hint}</span>
                    </>
                  )}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    {/* —— 右：CSS 代码窗口 —— */}
    <section class="props-pair__code" aria-label="对应 CSS">
      <header class="props-pair__panel-bar props-pair__panel-bar--code">
        <span class="props-pair__dots" aria-hidden="true">
          <span class="props-pair__dot props-pair__dot--red"></span>
          <span class="props-pair__dot props-pair__dot--yellow"></span>
          <span class="props-pair__dot props-pair__dot--green"></span>
        </span>
        <span class="props-pair__fname">{fileName}</span>
        <span class="props-pair__lang">css</span>
      </header>
      <pre class="props-pair__pre" tabindex="0">{
        codeLines.map((line) => {
          if (line.type === 'open') {
            return (
              <span class="props-pair__cline props-pair__cline--shell">
                {line.parts.map((p) =>
                  partClass[p.kind] ? (
                    <span class={partClass[p.kind]!}>{p.text}</span>
                  ) : (
                    p.text
                  ),
                )}
              </span>
            );
          }
          if (line.type === 'close') {
            return <span class="props-pair__cline props-pair__cline--shell">{'}'}</span>;
          }
          return (
            <span class="props-pair__cline" data-key={line.key}>
              {line.parts.map((p) =>
                partClass[p.kind] ? (
                  <span class={partClass[p.kind]!}>{p.text}</span>
                ) : (
                  p.text
                ),
              )}
            </span>
          );
        })
      }</pre>
    </section>
  </div>

  {/* —— 底注 —— */}
  <div class="props-pair__caption">
    <div class="props-pair__cap">
      <div class="props-pair__cap-k">
        <span class="props-pair__cap-mark" aria-hidden="true"></span>
        Figma 视角
      </div>
      <p>
        选中一个图层，<strong>右侧属性面板</strong>就是它「长什么样」的全部信息。
      </p>
    </div>
    <div class="props-pair__cap">
      <div class="props-pair__cap-k">
        <span class="props-pair__cap-mark" aria-hidden="true"></span>
        代码视角
      </div>
      <p>
        一组 <code>属性: 值</code>。属性名几乎跟 Figma 一样：
        <code>padding</code> = 内边距、<code>border-radius</code> = 圆角。
      </p>
    </div>
  </div>
</div>

<style>
  .props-pair {
    --sx-pp-gap: 1rem;
    --sx-pp-select: var(--sx-sys-color-danger);

    display: flex;
    flex-direction: column;
    gap: var(--sx-pp-gap);
    width: 100%;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .props-pair__panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: var(--sx-pp-gap);
    min-width: 0;
  }

  /* ── 共用顶栏 ── */
  .props-pair__panel-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.5rem 0.875rem;
    box-sizing: border-box;
    background: var(--sx-sys-color-border);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .props-pair__panel-label {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-accent);
  }
  .props-pair__fname {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sx-sys-color-bg-surface);
  }
  .props-pair__lang {
    margin-left: auto;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-accent);
    opacity: 0.9;
  }

  /* ── 左：属性面板 ── */
  .props-pair__figma {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    overflow: hidden;
  }
  .props-pair__props {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 0.875rem;
    padding: 0.75rem 0.625rem 0.875rem;
  }
  .props-pair__section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .props-pair__section-title {
    padding: 0 0.35rem 0.35rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }
  .props-pair__row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 1.875rem;
    padding: 0.3rem 0.45rem;
    border-radius: 2px;
    cursor: default;
    transition: background 0.12s ease;
  }
  .props-pair__prefix {
    flex-shrink: 0;
    width: 1.25rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    color: var(--sx-sys-color-text-soft);
  }
  .props-pair__input {
    flex: 0 0 auto;
    min-width: 2.5rem;
    padding: 0.2rem 0.4rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--sx-sys-color-text-primary);
    background: var(--sx-sys-color-bg-page);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .props-pair__chip {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 2px;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .props-pair__chip--bordered {
    /* 深色字色色块在浅底上仍可辨 */
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sx-sys-color-bg-surface) 40%, transparent);
  }
  .props-pair__hex {
    flex: 0 0 auto;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--sx-sys-color-text-primary);
  }
  .props-pair__hint {
    margin-left: auto;
    font-family: var(--sx-sys-font-family-body);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--sx-sys-color-text-muted);
    white-space: nowrap;
  }

  /* ── 右：代码 ── */
  .props-pair__code {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    overflow: hidden;
  }
  .props-pair__dots {
    display: inline-flex;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .props-pair__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .props-pair__dot--red {
    background: var(--sx-sys-color-danger);
  }
  .props-pair__dot--yellow {
    background: var(--sx-sys-color-accent);
  }
  .props-pair__dot--green {
    background: var(--sx-sys-color-success);
  }
  .props-pair__pre {
    margin: 0;
    padding: 0.75rem 0.5rem 0.875rem;
    flex: 1 1 auto;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--sx-sys-color-text-primary);
    overflow-x: auto;
    white-space: normal;
    border: none;
    background: transparent;
  }
  .props-pair__pre:focus {
    outline: none;
  }
  .props-pair__pre:focus-visible {
    box-shadow: inset 0 0 0 2px var(--sx-sys-color-action-primary);
  }
  .props-pair__cline {
    display: block;
    padding: 0.08rem 0.4rem;
    padding-left: calc(0.4rem + 1.1rem);
    margin: 0;
    border-radius: 2px;
    transition: background 0.12s ease;
  }
  .props-pair__cline--shell {
    padding-left: 0.4rem;
  }
  .props-pair__csel {
    color: var(--sx-sys-color-action-primary);
    font-weight: 700;
  }
  .props-pair__ckey {
    color: var(--sx-sys-color-text-soft);
    font-weight: 600;
  }
  .props-pair__cnum {
    color: var(--sx-sys-color-danger);
    font-weight: 700;
  }
  .props-pair__cstr {
    color: var(--sx-sys-color-success);
    font-weight: 600;
  }

  /* ── 左右联动 ── */
  .props-pair:has([data-key='padding']:hover) [data-key='padding'],
  .props-pair:has([data-key='radius']:hover) [data-key='radius'],
  .props-pair:has([data-key='bg']:hover) [data-key='bg'],
  .props-pair:has([data-key='font-size']:hover) [data-key='font-size'],
  .props-pair:has([data-key='color']:hover) [data-key='color'] {
    background: color-mix(in srgb, var(--sx-pp-select) 42%, transparent);
  }

  /* ── 底注 ── */
  .props-pair__caption {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sx-pp-gap);
    background: transparent;
  }
  .props-pair__cap {
    padding: 1rem 1.125rem 1.125rem;
    min-width: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-page);
  }
  .props-pair__cap-k {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.45rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
  }
  .props-pair__cap-mark {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .props-pair__cap p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sx-sys-color-text-soft);
  }
  .props-pair__cap strong {
    color: var(--sx-sys-color-text-primary);
    font-weight: 700;
  }
  .props-pair__cap :global(code) {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125em;
    font-weight: 700;
    padding: 0.05em 0.3em;
    color: var(--sx-sys-color-text-primary);
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  @media (max-width: 720px) {
    .props-pair__panels,
    .props-pair__caption {
      grid-template-columns: 1fr;
    }
  }
</style>
