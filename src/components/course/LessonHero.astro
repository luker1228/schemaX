---
// LessonHero —— 课时页大标题区
// 双行 display 标题（第二行可嵌黄底徽章贴纸）+ 右侧 meta pills + 阅读时长。
// 零 JS。视觉：编辑式左标题 / 右 meta；黄徽章带硬边硬影；底部分隔接正文。

interface Props {
  /** 第一行大标题，如 "Html可以看做" */
  line1: string;
  /** 第二行前缀文字，如 "怎么翻成"；可省略 */
  line2?: string;
  /** 高亮徽章文字，如 "Markdown"；不传则无徽章 */
  badge?: string;
  /** 实心黄 pill 文案，如 "MARKDOWN 对照 · COMPARE" */
  pillFill?: string;
  /** 描边白 pill 文案，如 "HTML 第一课 · 语法对照" */
  pillOutline?: string;
  /** 阅读时长文案，如 "阅读时长 ≈ 12 分钟" */
  readTime?: string;
}

const { line1, line2, badge, pillFill, pillOutline, readTime } = Astro.props;
const hasLine2Row = Boolean(line2) || Boolean(badge);
const hasMeta = Boolean(pillFill || pillOutline || readTime);
---

<header class="lhero">
  <h1 class="lhero__title">
    <span class="lhero__line1">{line1}</span>
    {
      hasLine2Row && (
        <span class="lhero__line2">
          {line2 ? <span class="lhero__line2-pre">{line2}</span> : null}
          {badge ? <span class="lhero__badge">{badge}</span> : null}
        </span>
      )
    }
  </h1>

  {
    hasMeta && (
      <div class="lhero__meta">
        {(pillFill || pillOutline) && (
          <div class="lhero__pills">
            {pillFill && (
              <span class="lhero__pill lhero__pill--fill">{pillFill}</span>
            )}
            {pillOutline && (
              <span class="lhero__pill lhero__pill--outline">{pillOutline}</span>
            )}
          </div>
        )}
        {readTime && <span class="lhero__time">{readTime}</span>}
      </div>
    )
  }
</header>

<style>
  .lhero {
    display: flex;
    flex-flow: row wrap;
    gap: 1.5rem 2.5rem;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    margin: 0;
    padding: 1.75rem 0 1.75rem;
    box-sizing: border-box;
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .lhero__title {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    margin: 0;
    flex: 1 1 14rem;
    min-width: 0;
    max-width: 38rem;
    font-family: var(--sx-sys-font-family-display);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--sx-sys-color-text-primary);
    text-wrap: balance;
  }

  .lhero__line1,
  .lhero__line2-pre {
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
  }

  .lhero__line2 {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    gap: 0.12em 0.2em;
  }

  /* 黄底贴纸：黑边 + 硬影，课时签名点 */
  .lhero__badge {
    display: inline-block;
    padding: 0.08em 0.28em 0.1em;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-sm);
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--sx-sys-color-text-primary);
    vertical-align: middle;
  }

  .lhero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    align-items: flex-end;
    flex: 0 1 auto;
    min-width: 0;
    padding-block-end: 0.2rem;
  }

  .lhero__pills {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .lhero__pill {
    display: inline-block;
    max-width: 100%;
    padding: 0.4rem 0.75rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 999px;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lhero__pill--fill {
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-text-primary);
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .lhero__pill--outline {
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
  }

  .lhero__time {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--sx-sys-color-text-soft);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .lhero {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem 0 1.5rem;
    }
    .lhero__title {
      max-width: none;
    }
    .lhero__meta,
    .lhero__pills {
      align-items: flex-start;
      width: 100%;
    }
    .lhero__pill {
      white-space: normal;
    }
  }
</style>
