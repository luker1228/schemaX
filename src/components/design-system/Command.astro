---
// Command 组件 —— SchemaX UI
// 一个仿终端窗口外观的纯展示容器：标题栏（红黄绿圆点 + 标题）+ 屏幕主体。
// 它不是终端模拟器，不解析命令、不区分成功 / 错误 / 光标 —— 内容完全由使用者
// 通过默认 slot 自由决定（可以是命令、输出、任意文本 / 标记）。
//
// 两个主题：
//   light —— 屏幕为暖纸背景（浅色）
//   dark  —— 屏幕为深底（黑色），文字默认浅色
//
// 设计语言：1px 黑边 + 黄色硬阴影（brutalist），等宽字体。

export type CommandTheme = 'light' | 'dark';

interface Props {
  /** 屏幕主题。light = 浅色屏幕；dark = 黑色屏幕（默认） */
  theme?: CommandTheme;
  /** 标题栏显示的文件名 / shell 名 */
  title?: string;
}

const {
  theme = 'dark',
  title = 'bash',
} = Astro.props;
---

<figure class:list={['term', `term--${theme}`]}>
  <figcaption class="term__bar">
    <span class="term__dots" aria-hidden="true">
      <span class="term__dot term__dot--red"></span>
      <span class="term__dot term__dot--yellow"></span>
      <span class="term__dot term__dot--green"></span>
    </span>
    <span class="term__title">{title}</span>
  </figcaption>

  <div class="term__screen">
    <slot />
  </div>
</figure>

<style>
  .term {
    margin: 0;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    /* 黄色硬阴影（Command 组件私有令牌，区别于站点默认的纯黑阴影） */
    box-shadow: var(--sx-comp-term-shadow);
    background: var(--sx-sys-color-bg-surface);
    overflow: hidden;
    max-width: 100%;
  }

  /* 标题栏：暖纸背景 + 底部 1px 分隔线 */
  .term__bar {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
    padding: 0.45rem var(--sx-ref-space-3);
    background: var(--sx-sys-color-bg-page);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .term__dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .term__dot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 50%;
  }
  .term__dot--red {
    background: var(--sx-sys-color-danger);
  }
  .term__dot--yellow {
    background: var(--sx-sys-color-accent);
  }
  .term__dot--green {
    background: var(--sx-sys-color-success);
  }
  .term__title {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    opacity: 0.7;
  }

  /* 屏幕主体：等宽字体；颜色由主题切换 */
  .term__screen {
    padding: var(--sx-ref-space-3) var(--sx-ref-space-4);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.65;
    overflow-x: auto;
  }

  /* light 主题：浅色屏幕，黑字（组件级令牌） */
  .term--light .term__screen {
    background: var(--sx-comp-term-light-screen-bg);
    color: var(--sx-comp-term-light-text);
  }

  /* dark 主题：黑色屏幕，浅字（组件级令牌） */
  .term--dark .term__screen {
    background: var(--sx-comp-term-screen-bg);
    color: var(--sx-comp-term-text);
  }
</style>
