---
// Command 组件 —— SchemaX UI
// 一个仿终端窗口外观的纯展示容器：标题栏（红黄绿圆点 + 标题）+ 屏幕主体。
// 它不是终端模拟器，不解析命令、不区分成功 / 错误 / 光标 —— 内容完全由使用者
// 通过默认 slot 自由决定（可以是命令、输出、任意文本 / 标记）。
//
// 两个主题：
//   light —— 屏幕为暖纸背景（浅色），默认
//   dark  —— 屏幕为深底（黑色），文字默认浅色（opt-in）
//
// 设计语言：1px 黑边 + 黄色硬阴影（brutalist），等宽字体。

export type CommandTheme = 'light' | 'dark';

interface Props {
  /** 屏幕主题。light = 浅色屏幕（默认）；dark = 黑色屏幕（opt-in） */
  theme?: CommandTheme;
  /** 标题栏显示的文件名 / shell 名 */
  title?: string;
}

const { theme = 'light', title = 'bash' } = Astro.props;
---

<figure class:list={['term', `term--${theme}`]}>
  <figcaption class="term__bar">
    <span class="term__dots" aria-hidden="true">
      <span class="term__dot term__dot--red"></span>
      <span class="term__dot term__dot--yellow"></span>
      <span class="term__dot term__dot--green"></span>
    </span>
    <span class="term__title">{title}</span>
  </figcaption>

  <div class="term__screen">
    <slot />
  </div>
</figure>

<!--
  样式提升到全局：src/styles/components.css 的 .term 系列。
  Command（本组件）与 HeroTerminal（React island）共享同一套终端外观，
  避免两处 scoped 副本。Command 默认 light 主题、屏幕 overflow-x auto。
-->
