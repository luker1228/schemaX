---
// Badge 组件 —— SchemaX UI
// 状态标记。样式来自全局 .badge 类（src/styles/components.css），
// 本组件只做 props → 类名映射。
//
// 变体（variant）：
//   default  白底黑字 —— 中性标签（type / level 等无特定语义）
//   accent   黄底黑字 —— 强调 / 活跃（active）
//   action   蓝底白字 —— 计划中 / 进行中（planned / planning / writing / experimental / draft）
//   danger   红底白字 —— 危险 / 停用（archived / paused）
//   success  绿底白字 —— 成功 / 完成（completed / published / maintained）

export type BadgeVariant =
  'default' | 'accent' | 'action' | 'danger' | 'success';

interface Props {
  variant?: BadgeVariant;
}

const { variant = 'default' } = Astro.props;

const classes = ['badge', variant !== 'default' ? `badge--${variant}` : '']
  .filter(Boolean)
  .join(' ');
---

<span class={classes}><slot /></span>
