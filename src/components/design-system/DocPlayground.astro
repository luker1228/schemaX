---
// DocPlayground —— 文档/课程「可玩」演示壳
//
// 与 Preview（.doc-code）并列：
//   · doc-code        → 静态代码 / 静态渲染，用来「看」
//   · doc-playground  → 可点、可输入、可改状态，用来「练」
//
// 样式在 src/styles/doc.css（.doc-playground*）。本组件只负责壳与语义，
// 不自带浏览器状态——交互内容放默认 slot（通常是 React island）。
//
// 宽度：整壳收敛并水平居中，用 size 控制：
//   · sm（默认）— 课内小练习，约 24rem
//   · md           — 列表 / 多控件，约 32rem
//
// 用法：
//   <DocPlayground label="点击改状态" hint="点两个按钮，看文字怎么变" size="sm">
//     <JsDrillDemoIsland drill="status" />
//   </DocPlayground>
//
// 岛内结构：.doc-playground__panel > controls + trace
// 状态主读数用 .doc-playground__readout；双按钮用 .doc-playground__actions--split

export type DocPlaygroundSize = 'sm' | 'md';

interface Props {
  /** 顶栏左侧标题，如「点击改状态」 */
  label?: string;
  /** 顶栏副文案，如「点两个按钮试试」 */
  hint?: string;
  /** 顶栏右侧徽章，默认 LIVE */
  badge?: string;
  /**
   * 整壳最大宽度：
   * - sm（默认）：点一下 / 输一行
   * - md：列表 / 多控件
   */
  size?: DocPlaygroundSize;
  /** 额外 class */
  class?: string;
}

const {
  label = 'Playground',
  hint,
  badge = 'LIVE',
  size = 'sm',
  class: className,
} = Astro.props;
---

<figure class:list={['doc-playground', `doc-playground--${size}`, className]}>
  <figcaption class="doc-playground__bar">
    <div class="doc-playground__meta">
      <span class="doc-playground__file">{label}</span>
      {hint ? <span class="doc-playground__hint">{hint}</span> : null}
    </div>
    <span class="doc-playground__badge">{badge}</span>
  </figcaption>
  <div class="doc-playground__stage">
    <slot />
  </div>
</figure>
