---
// FeatureCard 组件 —— SchemaX UI
// 交互介绍卡：撞色 icon 方块 + 标题 + 描述 + 撞色偏移硬影（neubrutalism 贴纸堆）。
// 与首页 Entry（HomeEntries）同款视觉——可点、hover 抬起影涨。
// 静态纯展示卡请用 StaticCard（独立组件，满色底无 hover）。
//
// 维度：
//   title        必填，卡片标题
//   description  描述文字（可选）
//   href         提供则渲染为 <a>（可点、hover 抬起）；否则 <div>（静态）
//   iconBg       icon 方块底色（--sx-* token），默认品牌强调黄
//   shadowColor  撞色偏移硬影色（--sx-* token），默认黑
//   class        透传额外类名

interface Props {
  /** 卡片标题（必填） */
  title: string;
  /** 描述文字 */
  description?: string;
  /** 提供则渲染为 <a>（可点），否则 <div>（静态） */
  href?: string;
  /** icon 方块底色（--sx-* token）。默认品牌强调黄 */
  iconBg?: string;
  /** 撞色偏移硬影色（--sx-* token）。默认黑 */
  shadowColor?: string;
  /** 透传到根元素的额外类名 */
  class?: string;
}

const {
  title,
  description,
  href,
  iconBg = 'var(--sx-sys-color-accent)',
  shadowColor = 'var(--sx-sys-color-border)',
  class: extra,
} = Astro.props;

// 撞色机制：局部覆盖全局 --sx-sys-shadow-color，偏移量走 sys shadow token（3/6/9 ramp）。
const styleVars = `--sx-sys-shadow-color: ${shadowColor}; --sx-fc-icon-bg: ${iconBg}`;
const isLink = Boolean(href);
const classes = ['featurecard', extra].filter(Boolean).join(' ');
---

{
  isLink ? (
    <a class={classes} href={href} style={styleVars}>
      <span class="featurecard__icon">
        <slot />
      </span>
      <span class="featurecard__label">{title}</span>
      <span class="featurecard__desc">{description}</span>
    </a>
  ) : (
    <div class={classes} style={styleVars}>
      <span class="featurecard__icon">
        <slot />
      </span>
      <span class="featurecard__label">{title}</span>
      <span class="featurecard__desc">{description}</span>
    </div>
  )
}

<style>
  /* 卡片：3px 黑边 + 撞色偏移硬影（局部覆盖 --sx-sys-shadow-color），hover 抬起 + 影涨 */
  .featurecard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-3);
    min-height: 13.5rem;
    padding: 1.25rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-surface);
    box-shadow: var(--sx-sys-shadow-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.1s ease,
      box-shadow 0.1s ease;
  }
  a.featurecard:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--sx-sys-shadow-lg);
  }
  a.featurecard:focus-visible {
    outline: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  /* icon 容器：撞色底方块 + 黑边 + 小硬影（贴纸印泥戳） */
  .featurecard__icon {
    display: flex;
    width: 5rem;
    height: 5rem;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-fc-icon-bg);

    /* 重置回黑：抵消卡片根上覆盖的撞色 shadow-color，icon 保持黑色小硬影 */
    --sx-sys-shadow-color: var(--sx-sys-color-border);

    box-shadow: var(--sx-sys-shadow-sm);
  }

  /* 标题贴底（margin-top auto 让标题 + 描述沉底，icon 顶） */
  .featurecard__label {
    margin-top: auto;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

  .featurecard__desc {
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.55;
    color: var(--sx-sys-color-text-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    a.featurecard:hover {
      transform: none;
    }
  }
</style>
