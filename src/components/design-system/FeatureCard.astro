---
// FeatureCard 组件 —— SchemaX UI
// 设计系统区域介绍卡：彩色媒体条（含图标）+ 标题 + 描述 + 状态胶囊。
// 视觉真相：tokens/design_system.pen 中的 DS Feature Card 节点。
//
// 结构：
//   <a|div class="featurecard">
//     <div class="featurecard__media" style="background: mediaColor">…默认 slot（图标 / SVG）…</div>
//     <div class="featurecard__body">
//       <div class="featurecard__head">
//         <h3 + 状态胶囊>
//       </div>
//       <p description>
//     </div>
//   </a|div>
//
// 维度：
//   title       必填，卡片标题
//   description 描述文字（可选；命名 slot "description" 覆盖它）
//   status      'live'（默认）/ 'planned'
//                  live    → 黄底 Live 胶囊 + href 透传 → interactive 链接卡
//                  planned → 米底 Planned 胶囊 + 强制静态（不可点）
//   href        live 卡片跳转地址。planned 时忽略
//   mediaColor  媒体条背景，传 --sx-* token（如 'var(--sx-sys-color-accent)'）。
//               默认品牌强调黄。
//   target / rel / class 透传

type FeatureStatus = 'live' | 'planned';

interface Props {
  /** 卡片标题（必填） */
  title: string;
  /** 描述文字。可选；命名 slot "description" 会覆盖它 */
  description?: string;
  /** 状态：live（可点）/ planned（静态占位）。默认 live */
  status?: FeatureStatus;
  /** live 卡片跳转地址。planned 时忽略 */
  href?: string;
  /** <a> 的 target */
  target?: '_blank' | '_self' | '_parent' | '_top';
  /** <a> 的 rel */
  rel?: string;
  /** 媒体条背景（--sx-* token 字符串）。默认品牌强调黄 */
  mediaColor?: string;
  /** 透传到根元素的额外类名 */
  class?: string;
}

const {
  title,
  description,
  status = 'live',
  href,
  target,
  rel,
  mediaColor = 'var(--sx-sys-color-accent)',
  class: extraClass,
} = Astro.props;

const isLive = status === 'live';
// planned 强制无 href（即便传了也不渲染为链接，保持「未开放」语义）
const resolvedHref = isLive ? href : undefined;
const isLink = Boolean(resolvedHref);
const statusLabel = isLive ? 'Live' : 'Planned';

const classes = [
  'featurecard',
  isLive ? 'featurecard--live' : 'featurecard--planned',
  isLink ? 'featurecard--interactive' : '',
  extraClass ?? '',
]
  .filter(Boolean)
  .join(' ');
---

{
  isLink ? (
    <a class={classes} href={resolvedHref} target={target} rel={rel}>
      <div class="featurecard__media" style={`background:${mediaColor}`}>
        <slot />
      </div>
      <div class="featurecard__body">
        <div class="featurecard__head">
          <h3 class="featurecard__title">{title}</h3>
          <span class={`featurecard__status featurecard__status--${status}`}>
            {statusLabel}
          </span>
        </div>
        <div class="featurecard__desc">
          <slot name="description">{description}</slot>
        </div>
      </div>
    </a>
  ) : (
    <div class={classes}>
      <div class="featurecard__media" style={`background:${mediaColor}`}>
        <slot />
      </div>
      <div class="featurecard__body">
        <div class="featurecard__head">
          <h3 class="featurecard__title">{title}</h3>
          <span class={`featurecard__status featurecard__status--${status}`}>
            {statusLabel}
          </span>
        </div>
        <div class="featurecard__desc">
          <slot name="description">{description}</slot>
        </div>
      </div>
    </div>
  )
}

<style>
  /* Card 容器：自身掌握边框 / 阴影 / overflow。
     display:flex + column 让 media/body 上下排列；
     overflow:hidden 让 media 沿卡片边缘裁剪。
     不给 padding —— padding 移到 body 内部，media 才能贴到卡片四边。
     width/height 100%：填满 grid 单元格，同排卡等高、底边对齐
     （body 的 flex:1 吃掉多余高度，描述长短不再把卡撑得参差）。 */
  .featurecard {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    box-sizing: border-box;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  /* interactive 卡片：hover 抬起（向左上位移 3px） */
  .featurecard--interactive:hover {
    transform: translate(-3px, -3px);
  }

  /* Media 条：固定高度彩色区，居中放图标 / 装饰内容。
     border-bottom 是上下两区的分割线，贯穿卡片整个宽度。
     color 设为墨黑，让 currentColor 的图标自动呈黑色。 */
  .featurecard__media {
    height: 8.25rem;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: var(--sx-sys-border-width-strong) solid
      var(--sx-sys-color-border);
    color: var(--sx-sys-color-text-primary);
  }
  /* media 内 SVG / img：统一图标尺寸，居中 */
  .featurecard__media :global(svg),
  .featurecard__media :global(img) {
    width: 4rem;
    height: 4rem;
    display: block;
  }

  /* Body 区：padding 在这里 */
  .featurecard__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: var(--sx-comp-card-padding);
    flex: 1;
  }

  .featurecard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .featurecard__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.1;
  }

  /* 状态胶囊：pill 形（9999px），2px 黑边，等宽小字。
     live = 品牌强调黄；planned = 米色（未开放）。 */
  .featurecard__status {
    flex-shrink: 0;
    display: inline-block;
    padding: 0.35rem 0.55rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: 9999px;
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .featurecard__status--planned {
    background: var(--sx-sys-color-beige);
  }

  .featurecard__desc {
    flex: 1;
    color: var(--sx-sys-color-text-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .featurecard__desc :global(p) {
    margin: 0;
  }
</style>
