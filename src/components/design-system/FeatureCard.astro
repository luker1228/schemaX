---
// FeatureCard 组件 —— SchemaX UI
// 介绍卡片：缩略图（media slot）+ 标题 + 描述 + 状态徽章，可链接或静态。
//
// 结构（标准 Card 模式）：
//   <a|div class="featurecard">
//     <div class="featurecard__media">…默认 slot…</div>
//     <div class="featurecard__body">
//       <h3 + badge>
//       <description>
//     </div>
//   </a|div>
//
// 关键：featurecard 自身就是 flex column + overflow:hidden，
// 边框 / 阴影 / padding 全部由本组件直接控制（不复用 <Card>）。
// 原因：media 需要贴到卡片四边（让 border-bottom 贯穿），
// 若复用全局 <Card> 的 padding，media 永远到不了边。
//
// 维度：
//   title       必填，卡片标题
//   description 描述文字（可选；命名 slot "description" 覆盖它）
//   status      'live'（默认）/ 'planned'
//                  live    → 黄底 Live 徽章 + href 透传 → interactive 链接卡
//                  planned → 普通 Planned 徽章 + 强制静态（不可点）
//   href        live 卡片跳转地址。planned 时忽略

type FeatureStatus = 'live' | 'planned';

interface Props {
  /** 卡片标题（必填） */
  title: string;
  /** 描述文字。可选；命名 slot "description" 会覆盖它 */
  description?: string;
  /** 状态：live（可点）/ planned（静态占位）。默认 live */
  status?: FeatureStatus;
  /** live 卡片跳转地址。planned 时忽略 */
  href?: string;
  /** <a> 的 target */
  target?: '_blank' | '_self' | '_parent' | '_top';
  /** <a> 的 rel */
  rel?: string;
  /** 透传到根元素的额外类名 */
  class?: string;
}

const {
  title,
  description,
  status = 'live',
  href,
  target,
  rel,
  class: extraClass,
} = Astro.props;

const isLive = status === 'live';
// planned 强制无 href（即便传了也不渲染为链接，保持「未开放」语义）
const resolvedHref = isLive ? href : undefined;
const isLink = Boolean(resolvedHref);
const statusLabel = isLive ? 'Live' : 'Planned';

const classes = [
  'featurecard',
  isLive ? 'featurecard--live' : 'featurecard--planned',
  isLink ? 'featurecard--interactive' : '',
  extraClass ?? '',
]
  .filter(Boolean)
  .join(' ');
---

{
  isLink ? (
    <a class={classes} href={resolvedHref} target={target} rel={rel}>
      <div class="featurecard__media">
        <slot />
      </div>
      <div class="featurecard__body">
        <div class="featurecard__head">
          <h3 class="featurecard__title">{title}</h3>
          <span class={`badge${isLive ? ' badge--accent' : ''}`}>
            {statusLabel}
          </span>
        </div>
        <div class="featurecard__desc">
          <slot name="description">{description}</slot>
        </div>
      </div>
    </a>
  ) : (
    <div class={classes}>
      <div class="featurecard__media">
        <slot />
      </div>
      <div class="featurecard__body">
        <div class="featurecard__head">
          <h3 class="featurecard__title">{title}</h3>
          <span class={`badge${isLive ? ' badge--accent' : ''}`}>
            {statusLabel}
          </span>
        </div>
        <div class="featurecard__desc">
          <slot name="description">{description}</slot>
        </div>
      </div>
    </div>
  )
}

<style>
  /* Card 容器：自身掌握边框 / 阴影 / overflow。
     display:flex + column 让 media/body 上下排列；
     overflow:hidden 让 media 沿卡片边缘裁剪（圆角场景也适用）。
     注意：不给 padding —— padding 移到 body 内部，
     这样 media 能贴到卡片四边，border-bottom 才能贯穿。 */
  .featurecard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: var(--sx-comp-card-radius);
    box-shadow: var(--sx-sys-shadow-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  /* interactive 卡片：hover 抬起（向左上位移 3px）。
     默认已是 lg（6px）最大档位，阴影不再升级，仅靠位移产生抬起感。 */
  .featurecard--interactive:hover {
    transform: translate(-3px, -3px);
  }

  /* Media 区：16:9 比例，纸色背景兜底。
     border-bottom 就是上下两区的分割线，天然贯穿卡片整个宽度。 */
  .featurecard__media {
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--sx-sys-color-bg-page);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sx-ref-space-4);
    overflow: hidden;
  }
  /* media 内 SVG / img：限制尺寸、居中、留白 */
  .featurecard__media :global(svg),
  .featurecard__media :global(img) {
    width: auto;
    height: auto;
    max-width: 60%;
    max-height: 100%;
    display: block;
  }

  /* Body 区：padding 在这里，不在外层卡片 */
  .featurecard__body {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    padding: var(--sx-comp-card-padding);
    flex: 1;
  }

  .featurecard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sx-ref-space-2);
  }

  .featurecard__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .featurecard__desc {
    flex: 1;
    opacity: 0.85;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .featurecard__desc :global(p) {
    margin: 0;
  }

  /* planned 卡片：SVG 降透明度，强化「未开放」视觉。
     背景（纸色）不变，靠图形本身变淡区分。 */
  .featurecard--planned .featurecard__media :global(svg),
  .featurecard--planned .featurecard__media :global(img) {
    opacity: 0.5;
  }
</style>
