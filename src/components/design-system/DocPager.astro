---
// DocPager —— 文档/课时顶部三段式横向导航条：prev / 中心目录 / next。
// 数据驱动、零 JS。prev/next 为 null（首/末项）时渲染空占位，保持三段布局对称。
// 设计系统组件页与课程课时页共用本组件。

export interface DocPagerLink {
  /** 展示标题 */
  title: string;
  /** 跳转地址 */
  href: string;
}

interface Props {
  prev: DocPagerLink | null;
  next: DocPagerLink | null;
  /** 中间「目录」按钮链接 */
  centerHref: string;
  /** 中间按钮文案，默认「目录」 */
  centerLabel?: string;
  /** nav 的 aria-label */
  label?: string;
}

const {
  prev,
  next,
  centerHref,
  centerLabel = '目录',
  label = '前后导航',
} = Astro.props;
---

<nav class="docs-nav" aria-label={label}>
  {
    prev ? (
      <a
        class="docs-nav__slot docs-nav__slot--prev"
        href={prev.href}
        rel="prev"
      >
        <svg
          class="docs-nav__arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5 M11 6L5 12L11 18" />
        </svg>
        <span class="docs-nav__title">{prev.title}</span>
      </a>
    ) : (
      <span
        class="docs-nav__slot docs-nav__slot--prev docs-nav__slot--placeholder"
        aria-hidden="true"
      />
    )
  }

  <a class="docs-nav__slot docs-nav__slot--center" href={centerHref}>
    <svg
      class="docs-nav__index-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="7" height="7" rx="1" />
      <rect x="14" y="3" width="7" height="7" rx="1" />
      <rect x="3" y="14" width="7" height="7" rx="1" />
      <rect x="14" y="14" width="7" height="7" rx="1" />
    </svg>
    {centerLabel}
  </a>

  {
    next ? (
      <a
        class="docs-nav__slot docs-nav__slot--next"
        href={next.href}
        rel="next"
      >
        <span class="docs-nav__title">{next.title}</span>
        <svg
          class="docs-nav__arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12H19 M13 6L19 12L13 18" />
        </svg>
      </a>
    ) : (
      <span
        class="docs-nav__slot docs-nav__slot--next docs-nav__slot--placeholder"
        aria-hidden="true"
      />
    )
  }
</nav>

<style>
  /* —— 三段式条：白底 + 2px 黑边 + 圆角 + 硬阴影 —— */
  /* 父容器 .sx-doc-main 是 flex column，默认 align-items:stretch 会把横向撑满，
     用 align-self + 明确 width 控制宽度。 */
  .docs-nav {
    display: flex;
    align-items: stretch;
    align-self: center;
    width: 75%;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-sm);
  }
  .docs-nav__slot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6875rem 1rem;
    text-decoration: none;
    color: var(--sx-sys-color-text-primary);
    transition: background-color 120ms ease;
    min-width: 0;
  }
  .docs-nav__slot--prev,
  .docs-nav__slot--next {
    flex: 1 1 0;
  }
  .docs-nav__slot--prev {
    justify-content: flex-start;
    border-right: var(--sx-sys-border-width-strong) solid
      var(--sx-sys-color-border);
  }
  .docs-nav__slot--next {
    justify-content: flex-end;
    border-left: var(--sx-sys-border-width-strong) solid
      var(--sx-sys-color-border);
  }
  .docs-nav__slot--center {
    flex: 0 0 auto;
    justify-content: center;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  a.docs-nav__slot:hover {
    background: var(--sx-sys-color-bg-page);
  }

  .docs-nav__title {
    font-family: var(--sx-sys-font-family-display);
    font-size: 0.9375rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .docs-nav__arrow {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .docs-nav__index-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex: 0 0 auto;
  }

  /* placeholder：首/末项时 prev/next 为空的占位。
     完全塌缩不占空间，让有内容的一端完整展开。 */
  .docs-nav__slot--placeholder {
    flex: 0 0 0;
    padding: 0;
    pointer-events: none;
  }
  .docs-nav__slot--placeholder.docs-nav__slot--prev {
    border-right: none;
  }
  .docs-nav__slot--placeholder.docs-nav__slot--next {
    border-left: none;
  }

  @media (max-width: 600px) {
    .docs-nav__title {
      display: none;
    }
    .docs-nav__slot {
      padding: 0.875rem;
    }
  }
</style>
