---
// DocSide 组件 —— SchemaX UI
// 文档 / 设计系统左侧边栏：可多组导航，每组有 eyebrow 标题 + 链接列表。
//
// 状态（通过 item 字段，非类名驱动）：
//   - current  → aria-current="page"，指示条加宽 + label 黄底徽章
//   - planned  → 灰显不可点（span + aria-disabled）
//   - 默认     → 可点链接，hover 加深
//
// 零 JS，纯静态。设计语言：等宽字体、accent 色块 eyebrow、细指示条。
//
// 浮动（sticky）不在本组件内实现：必须由页面布局提供「全高槽位」
// （.sx-doc-side-slot，见 layout.css），在槽上设 sticky。组件只管内容高度。

export interface DocSideItem {
  /** 显示文本 */
  label: string;
  /** 链接地址。planned 项可不传 */
  href?: string;
  /** 是否为当前页 */
  current?: boolean;
  /** 是否为计划中（灰显、不可点） */
  planned?: boolean;
}

export interface DocSideGroup {
  /** 分组标题（eyebrow 文案） */
  title: string;
  /** 分组 nav 的 aria-label，默认用 title */
  ariaLabel?: string;
  /** 该组链接项 */
  items: DocSideItem[];
}

interface Props {
  /** 导航分组列表 */
  groups: DocSideGroup[];
  /** 整个 aside 的 aria-label */
  label?: string;
}

const { groups, label = '文档目录' } = Astro.props;
---

<aside class="doc-side" aria-label={label}>
  {
    groups.map((group) => (
      <nav class="doc-side__group" aria-label={group.ariaLabel ?? group.title}>
        <p class="doc-side__eyebrow">
          <span class="doc-side__mark" aria-hidden="true" />
          {group.title}
        </p>
        <div class="doc-side__nav">
          {group.items.map((item) => {
            if (item.planned) {
              return (
                <span class="doc-side__link is-planned" aria-disabled="true">
                  <span class="doc-side__label">{item.label}</span>
                </span>
              );
            }
            return (
              <a
                class="doc-side__link"
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
              >
                <span class="doc-side__label">{item.label}</span>
              </a>
            );
          })}
        </div>
      </nav>
    ))
  }
</aside>

<style>
  /* —— 容器：纵向堆叠各组（浮动由外层 .sx-doc-side-slot 负责） —— */
  .doc-side {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
    width: 100%;
    box-sizing: border-box;
  }
  .doc-side__group {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* —— 分组标题：小色块 + 大写 mono 小字 —— */
  .doc-side__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-soft);
  }
  .doc-side__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    flex: 0 0 auto;
  }

  /* —— 链接列表 —— */
  .doc-side__nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .doc-side__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.125rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--sx-sys-color-text-soft);
    transition: color 120ms ease;
  }
  /* 指示条（::before）：默认细灰横条；current 时加宽变 accent */
  .doc-side__link::before {
    content: '';
    width: 0.5rem;
    height: 2px;
    background: var(--sx-sys-color-text-soft);
    border-radius: 1px;
    flex: 0 0 auto;
    transition:
      width 120ms ease,
      background-color 120ms ease;
  }
  .doc-side__link:hover {
    color: var(--sx-sys-color-text-primary);
  }
  .doc-side__link:hover::before {
    background: var(--sx-sys-color-text-primary);
  }

  /* —— 当前页：指示条加宽 + label 变 accent badge —— */
  .doc-side__link[aria-current='page'] {
    color: var(--sx-sys-color-text-primary);
  }
  .doc-side__link[aria-current='page']::before {
    width: 0.75rem;
    height: 4px;
    background: var(--sx-sys-color-accent);
  }
  .doc-side__link[aria-current='page'] .doc-side__label {
    display: inline-block;
    padding: 2px 8px;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 3px;
    font-weight: 800;
  }

  /* —— planned：灰显、不可点 —— */
  .doc-side__link.is-planned {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
