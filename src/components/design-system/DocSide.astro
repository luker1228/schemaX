---
// DocSide 组件 —— SchemaX UI
// 文档 / 设计系统左侧边栏：可多组导航，每组有 eyebrow 标题 + 链接列表。
//
// 状态（通过 item 字段，非类名驱动）：
//   - current  → aria-current="page"，指示条加宽 + label 黄底徽章
//   - planned  → 灰显不可点（span + aria-disabled）
//   - 默认     → 可点链接，hover 加深
//
// 可收起：原生 checkbox + CSS :has（零 JS）。收起后侧栏只留「目录」把手，
// 主区由 .sx-doc-layout:has(...) 扩宽（见 layout.css）。
//
// 浮动（sticky）不在本组件内实现：必须由页面布局提供「全高槽位」
// （.sx-doc-side-slot，见 layout.css），在槽上设 sticky。组件只管内容高度。

export interface DocSideItem {
  /** 显示文本 */
  label: string;
  /** 链接地址。planned 项可不传 */
  href?: string;
  /** 是否为当前页 */
  current?: boolean;
  /** 是否为计划中（灰显、不可点） */
  planned?: boolean;
}

export interface DocSideGroup {
  /** 分组标题（eyebrow 文案） */
  title: string;
  /** 分组 nav 的 aria-label，默认用 title */
  ariaLabel?: string;
  /** 该组链接项 */
  items: DocSideItem[];
}

interface Props {
  /** 导航分组列表 */
  groups: DocSideGroup[];
  /** 整个 aside 的 aria-label */
  label?: string;
  /** 是否可收起（默认 true）。Demo 多实例可关，避免布局跳动 */
  collapsible?: boolean;
}

const { groups, label = '文档目录', collapsible = true } = Astro.props;
// 同页多实例（设计系统 Demo）时需唯一 id
const collapseId = `doc-side-${crypto.randomUUID().slice(0, 8)}`;
---

<aside class:list={['doc-side', collapsible && 'doc-side--collapsible']} aria-label={label}>
  {
    collapsible ? (
      <input
        type="checkbox"
        id={collapseId}
        class="doc-side__check"
        checked
        aria-controls={`${collapseId}-body`}
      />
    ) : null
  }

  {
    collapsible ? (
      <div class="doc-side__chrome">
        <span class="doc-side__chrome-title">{label}</span>
        <label
          for={collapseId}
          class="doc-side__toggle"
          title="收起或展开目录"
        >
          <span class="doc-side__toggle-hide" aria-hidden="true">
            收起
          </span>
          <span class="doc-side__toggle-show" aria-hidden="true">
            目录
          </span>
          <span class="sr-only">收起或展开侧栏目录</span>
        </label>
      </div>
    ) : null
  }

  <div
    class="doc-side__body"
    id={collapsible ? `${collapseId}-body` : undefined}
  >
    {
      groups.map((group) => (
        <nav class="doc-side__group" aria-label={group.ariaLabel ?? group.title}>
          <p class="doc-side__eyebrow">
            <span class="doc-side__mark" aria-hidden="true" />
            {group.title}
          </p>
          <div class="doc-side__nav">
            {group.items.map((item) => {
              if (item.planned) {
                return (
                  <span class="doc-side__link is-planned" aria-disabled="true">
                    <span class="doc-side__label">{item.label}</span>
                  </span>
                );
              }
              return (
                <a
                  class="doc-side__link"
                  href={item.href}
                  aria-current={item.current ? 'page' : undefined}
                >
                  <span class="doc-side__label">{item.label}</span>
                </a>
              );
            })}
          </div>
        </nav>
      ))
    }
  </div>
</aside>

<style>
  /* —— 容器：纵向堆叠各组（浮动由外层 .sx-doc-side-slot 负责） —— */
  .doc-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 视觉隐藏 checkbox，仍可被 label 切换、键盘可达 */
  .doc-side__check {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .doc-side__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.75rem;
  }
  .doc-side__chrome-title {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-soft);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .doc-side__toggle {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.2;
    cursor: pointer;
    user-select: none;
    box-shadow: var(--sx-sys-shadow-sm);
  }
  .doc-side__toggle:hover {
    background: var(--sx-sys-color-accent);
  }
  .doc-side__toggle:active {
    transform: translate(1px, 1px);
    box-shadow: none;
  }
  .doc-side__check:focus-visible + .doc-side__chrome .doc-side__toggle {
    outline: 2px solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  /* checked = 展开：显示「收起」；未选中 = 收起：显示「目录」 */
  .doc-side__check:checked ~ .doc-side__chrome .doc-side__toggle-show {
    display: none;
  }
  .doc-side__check:not(:checked) ~ .doc-side__chrome .doc-side__toggle-hide {
    display: none;
  }
  .doc-side__check:not(:checked) ~ .doc-side__body {
    display: none;
  }
  .doc-side__check:not(:checked) ~ .doc-side__chrome .doc-side__chrome-title {
    display: none;
  }
  /* 收起时 chrome 只留把手，居中竖条感 */
  .doc-side__check:not(:checked) ~ .doc-side__chrome {
    justify-content: center;
  }
  .doc-side__check:not(:checked) ~ .doc-side__chrome .doc-side__toggle {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    letter-spacing: 0.12em;
    padding: 0.625rem 0.375rem;
    min-height: 4.5rem;
  }

  .doc-side__body {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }
  .doc-side__group {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* —— 分组标题：小色块 + 大写 mono 小字 —— */
  .doc-side__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-soft);
  }
  .doc-side__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    flex: 0 0 auto;
  }

  /* —— 链接列表 —— */
  .doc-side__nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .doc-side__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.125rem;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--sx-sys-color-text-soft);
    transition: color 120ms ease;
  }
  /* 指示条（::before）：默认细灰横条；current 时加宽变 accent */
  .doc-side__link::before {
    content: '';
    width: 0.5rem;
    height: 2px;
    background: var(--sx-sys-color-text-soft);
    border-radius: 1px;
    flex: 0 0 auto;
    transition:
      width 120ms ease,
      background-color 120ms ease;
  }
  .doc-side__link:hover {
    color: var(--sx-sys-color-text-primary);
  }
  .doc-side__link:hover::before {
    background: var(--sx-sys-color-text-primary);
  }

  /* —— 当前页：指示条加宽 + label 变 accent badge —— */
  .doc-side__link[aria-current='page'] {
    color: var(--sx-sys-color-text-primary);
  }
  .doc-side__link[aria-current='page']::before {
    width: 0.75rem;
    height: 4px;
    background: var(--sx-sys-color-accent);
  }
  .doc-side__link[aria-current='page'] .doc-side__label {
    display: inline-block;
    padding: 2px 8px;
    background: var(--sx-sys-color-accent);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 3px;
    font-weight: 800;
  }

  /* —— planned：灰显、不可点 —— */
  .doc-side__link.is-planned {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
