---
// Breadcrumb 演示 —— 左 code-block，右 live demo（浅层 / 深层路径）。
import Breadcrumb from '../Breadcrumb.astro';
import type { BreadcrumbItem } from '../Breadcrumb.astro';

const D = 'javascript:void(0)';
const simpleItems: BreadcrumbItem[] = [
  { label: 'Home', href: D },
  { label: 'Design System', href: D },
  { label: 'Components' },
];
const deepItems: BreadcrumbItem[] = [
  { label: 'Home', href: D },
  { label: 'Courses', href: D },
  { label: 'Astro 实战', href: D },
  { label: '内容集合', href: D },
  { label: '定义 Schema' },
];

const crumbCode = `<span class="sel">.breadcrumb__link</span> {
  <span class="prop">opacity</span>: <span class="val">0.6</span>;
}
<span class="sel">.breadcrumb__link:hover</span> {
  <span class="prop">opacity</span>: <span class="val">1</span>;
  <span class="prop">background</span>: <span class="val">var(--sx-sys-color-accent)</span>;
}

<span class="com">/* 最后一项 = 当前页（黄底常驻，不可点 span） */</span>
<span class="sel">.breadcrumb__current</span> {
  <span class="prop">background</span>: <span class="val">var(--sx-sys-color-accent)</span>;
  <span class="prop">color</span>: <span class="val">var(--sx-sys-color-text-primary)</span>;
}`;
---

<div class="nb-grid2">
  <div class="nb-codewrap">
    <span class="nb-codelabel">CSS</span>
    <pre class="nb-codeblock"><button class="nb-copy" type="button" data-copy="">Copy</button><code set:html={crumbCode} /></pre>
  </div>
  <div class="nb-demobox">
    <div class="nb-stack">
      <Breadcrumb items={simpleItems} />
      <Breadcrumb items={deepItems} />
    </div>
  </div>
</div>
