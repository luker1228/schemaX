---
// Form 演示 —— neubrutalism 表单控件全家桶（对齐 neubrutalism.com Form Elements）。
// 全局 .field / .check / .toggle（components.css）+ nb-demobox / nb-formgrid / nb-checkrow（nb.css）。
// 不再需要组件本体或 Demo 封装——原生元素 + 全局类即可。
---

<div class="nb-demobox">
  <div class="nb-formgrid">
    <div class="nb-stack">
      <label class="field__label" for="f-text">Text Input</label>
      <input
        class="field"
        id="f-text"
        type="text"
        placeholder="Type something bold..."
      />
    </div>

    <div class="nb-stack">
      <label class="field__label" for="f-email">Email Input</label>
      <input
        class="field"
        id="f-email"
        type="email"
        placeholder="you@schemax.dev"
      />
    </div>

    <div class="nb-stack">
      <label class="field__label" for="f-select">Select</label>
      <select class="field" id="f-select">
        <option value="">Choose a shadow size...</option>
        <option>Small (3px 3px 0 0)</option>
        <option>Medium (6px 6px 0 0)</option>
        <option>Large (9px 9px 0 0)</option>
        <option>Extra Large (12px 12px 0 0)</option>
      </select>
    </div>

    <div class="nb-stack">
      <label class="field__label" for="f-area">Textarea</label>
      <textarea
        class="field"
        id="f-area"
        placeholder="Describe your design system..."
      ></textarea>
    </div>

    <div class="nb-stack">
      <span class="field__label">Checkboxes</span>
      <div class="nb-stack">
        <label class="nb-checkrow">
          <input class="check" type="checkbox" checked />
          <span>Thick borders</span>
        </label>
        <label class="nb-checkrow">
          <input class="check" type="checkbox" checked />
          <span>Hard shadows</span>
        </label>
        <label class="nb-checkrow">
          <input class="check" type="checkbox" />
          <span>Border radius (no!)</span>
        </label>
      </div>
    </div>

    <div class="nb-stack">
      <span class="field__label">Radio Buttons</span>
      <div class="nb-stack">
        <label class="nb-checkrow">
          <input class="check" type="radio" name="f-radio" checked />
          <span>Bold</span>
        </label>
        <label class="nb-checkrow">
          <input class="check" type="radio" name="f-radio" />
          <span>Bolder</span>
        </label>
        <label class="nb-checkrow">
          <input class="check" type="radio" name="f-radio" />
          <span>Boldest</span>
        </label>
      </div>
    </div>

    <div class="nb-stack">
      <span class="field__label">Toggle Switches</span>
      <div class="nb-stack">
        <label class="nb-checkrow">
          <input class="toggle" type="checkbox" checked />
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span>Dark mode</span>
        </label>
        <label class="nb-checkrow">
          <input class="toggle" type="checkbox" />
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span>Gradients (please no)</span>
        </label>
      </div>
    </div>
  </div>
</div>
