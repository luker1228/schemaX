---
import Demo from '../Demo.astro';
import Doodle from '../Doodle.astro';
import Rough from '../Rough.astro';
import { doodleMarkKinds } from '../../../lib/doodle';

const icons = doodleMarkKinds.filter((k) => k.startsWith('icon-'));
const rules = ['wave', 'pencil', 'dash', 'underline'] as const;
const ornaments = ['star', 'spark', 'arrow', 'brace', 'frame'] as const;
---

<section class="doodle-demo">
  <Demo label="命名 Mark · 图标" attr='kind="icon-*" size="lg"' stageClass="wrap">
    {
      icons.map((k) => (
        <div class="doodle-demo__cell">
          <Doodle kind={k} size="lg" />
          <code class="doodle-demo__code">{k}</code>
        </div>
      ))
    }
    <div slot="note">
      <p>
        图标经 <code>RoughGenerator</code> 在 SSR
        产出 SVG，零客户端 JS。色值使用
        <code>var(--sx-sys-*)</code>，与令牌同步。
      </p>
    </div>
  </Demo>

  <Demo label="命名 Mark · 装饰" attr='kind="star|arrow|…"' stageClass="wrap">
    {
      ornaments.map((k) => (
        <div class="doodle-demo__cell">
          <Doodle kind={k} size="md" animated={k === 'star' || k === 'spark'} />
          <code class="doodle-demo__code">{k}</code>
        </div>
      ))
    }
  </Demo>

  <Demo label="分割线" attr='kind="wave|pencil|dash|underline"'>
    <div class="doodle-demo__rules">
      {
        rules.map((k) => (
          <div class="doodle-demo__rule">
            <code class="doodle-demo__code">{k}</code>
            <Doodle kind={k} />
          </div>
        ))
      }
    </div>
  </Demo>

  <Demo label="Rough 原语" attr='shape="rect|circle|…"' stageClass="wrap">
    <Rough shape="rect" width={88} height={52} fill="accent" fillRecipe="hachure" />
    <Rough shape="circle" size={52} fill="action" fillRecipe="solid" stroke="ink" />
    <Rough shape="ellipse" width={90} height={40} tier="loose" />
    <Rough shape="line" width={100} stroke="action" strokeWidth={2} />
    <Rough
      shape="polygon"
      size={56}
      fill="accent"
      fillRecipe="solid"
      points={[
        [8, 48],
        [28, 8],
        [48, 48],
      ]}
    />
    <div slot="note">
      <p>
        低层 <code>&lt;Rough&gt;</code> 暴露 shape / tier / fillRecipe。业务界面优先用命名
        <code>&lt;Doodle kind&gt;</code>，保持全站涂鸦词汇一致。
      </p>
    </div>
  </Demo>
</section>

<style>
  .doodle-demo {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-8);
  }

  .doodle-demo__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sx-ref-space-2);
    min-width: 5rem;
  }

  .doodle-demo__code {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    color: var(--sx-sys-color-text-muted);
  }

  .doodle-demo__rules {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-4);
    width: min(36rem, 100%);
  }

  .doodle-demo__rule {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
  }
</style>
