---
// FeatureCard 演示 —— 仅供 /design-system/components 展示页使用。
import FeatureCard from '../FeatureCard.astro';
import Demo from '../Demo.astro';

// lucide 风格图标（内联 SVG，currentColor，尺寸由 FeatureCard 媒体区统一控制）
const iconAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 2,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
};

const iconBraces = `<svg ${Object.entries(iconAttrs)
  .map(([k, v]) => `${k}="${v}"`)
  .join(' ')} xmlns="http://www.w3.org/2000/svg">
  <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/>
  <path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>
</svg>`;

const iconComponent = `<svg ${Object.entries(iconAttrs)
  .map(([k, v]) => `${k}="${v}"`)
  .join(' ')} xmlns="http://www.w3.org/2000/svg">
  <path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"/>
  <path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"/>
  <path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"/>
  <path d="M12 15l3.5 3.5L12 22l-3.5-3.5L12 15Z"/>
</svg>`;

const iconFileText = `<svg ${Object.entries(iconAttrs)
  .map(([k, v]) => `${k}="${v}"`)
  .join(' ')} xmlns="http://www.w3.org/2000/svg">
  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
  <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
  <path d="M16 13H8"/>
  <path d="M16 17H8"/>
  <path d="M10 9H8"/>
</svg>`;

const iconNetwork = `<svg ${Object.entries(iconAttrs)
  .map(([k, v]) => `${k}="${v}"`)
  .join(' ')} xmlns="http://www.w3.org/2000/svg">
  <rect x="16" y="16" width="6" height="6" rx="1"/>
  <rect x="2" y="16" width="6" height="6" rx="1"/>
  <rect x="9" y="2" width="6" height="6" rx="1"/>
  <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/>
  <path d="M12 12V8"/>
</svg>`;

const apiRows = [
  {
    name: 'title',
    type: 'string',
    default: '—',
    desc: '卡片标题（必填）',
  },
  {
    name: 'description',
    type: 'string',
    default: '—',
    desc: '描述文字。可选；命名 slot "description" 会覆盖它',
  },
  {
    name: 'status',
    type: "'live' | 'planned'",
    default: "'live'",
    desc: 'live → 黄底 Live 胶囊 + 链接卡（interactive）；planned → 米底 Planned 胶囊 + 强制静态',
  },
  {
    name: 'href',
    type: 'string',
    default: '—',
    desc: 'live 卡片跳转地址。planned 时忽略',
  },
  {
    name: 'mediaColor',
    type: 'string (--sx-* token)',
    default: 'var(--sx-sys-color-accent)',
    desc: '媒体条背景色。传 --sx-* token 字符串，如品牌黄 / 米色 / 装饰色',
  },
  {
    name: 'target / rel / class',
    type: '透传',
    default: '—',
    desc: '分别透传到根 <a> 的 target / rel 与根元素额外类名',
  },
];

const slots = [
  {
    name: '默认 slot',
    desc: '媒体条内容：图标 / SVG / 图。媒体条固定高度（8.25rem），内容居中，图标自动以墨黑呈现',
  },
  {
    name: 'description',
    desc: '可选；覆盖 description prop，做富文本或更复杂的描述区',
  },
];

const usage = `<!-- Live：可点击跳转，黄底 Live 胶囊，hover 抬起 -->
<FeatureCard
  title="Tokens"
  description="Reference / Semantic / Article / Component Token。"
  status="live"
  href="/design-system/tokens"
  mediaColor="var(--sx-sys-color-accent)"
>
  <svg>…图标…</svg>
</FeatureCard>

<!-- Planned：静态占位，米底 Planned 胶囊，不可点 -->
<FeatureCard
  title="Patterns"
  description="文章头部、课程目录、项目 Hero 等组合模式。"
  status="planned"
  mediaColor="var(--sx-sys-color-beige)"
>
  <svg>…图标…</svg>
</FeatureCard>`;
---

<>
  <Demo label="Live（可点击）" attr='status="live"' stageClass="wrap">
    <FeatureCard
      title="Tokens"
      description="Reference / Semantic / Article / Component Token（读取生成产物）。"
      status="live"
      href="javascript:void(0)"
      mediaColor="var(--sx-sys-color-accent)"
    >
      <Fragment set:html={iconBraces} />
    </FeatureCard>
    <FeatureCard
      title="Components"
      description="Button / Card / Tag / Badge / Navigation 等。"
      status="live"
      href="javascript:void(0)"
      mediaColor="var(--sx-sys-color-accent)"
    >
      <Fragment set:html={iconComponent} />
    </FeatureCard>
    <Fragment slot="note">
      <p>
        <code>status="live"</code>：黄底 Live 胶囊，渲染为 <code>&lt;a&gt;</code
        >（提供 href 时）， hover 抬起，行为同全局 <code>.card--interactive</code>。
      </p>
    </Fragment>
  </Demo>

  <Demo label="Planned（静态占位）" attr='status="planned"' stageClass="wrap">
    <FeatureCard
      title="Content"
      description="Markdown 与 MDX 的真实排版规范。"
      status="planned"
      mediaColor="var(--sx-sys-color-beige)"
    >
      <Fragment set:html={iconFileText} />
    </FeatureCard>
    <FeatureCard
      title="Patterns"
      description="文章头部、课程目录、项目 Hero 等组合模式。"
      status="planned"
      mediaColor="var(--sx-sys-color-beige)"
    >
      <Fragment set:html={iconNetwork} />
    </FeatureCard>
    <Fragment slot="note">
      <p>
        <code>status="planned"</code>：米底 Planned 胶囊，强制渲染为 <code
          >&lt;div&gt;</code
        >（即便传了 href 也不生效），不可点击、hover 不抬起 —— 强化「未开放」语义。
      </p>
    </Fragment>
  </Demo>

  <Demo label="Media 可放任意内容" attr="默认 slot" stageClass="wrap">
    <FeatureCard
      title="默认色"
      description="不传 mediaColor 时，媒体条兜底为品牌强调黄。"
      status="live"
      href="javascript:void(0)"
    >
      <Fragment set:html={iconComponent} />
    </FeatureCard>
    <FeatureCard
      title="自定义色"
      description="mediaColor 传任意 --sx-* token，如薄荷装饰色。"
      status="live"
      href="javascript:void(0)"
      mediaColor="var(--sx-sys-color-mint)"
    >
      <Fragment set:html={iconBraces} />
    </FeatureCard>
    <Fragment slot="note">
      <p>
        默认 slot 可放图标 / SVG / <code>&lt;img&gt;</code> 等。留空则媒体条仅呈现纯色背景。
        <code>mediaColor</code> 传 <code>--sx-*</code> token 字符串即可换色。
      </p>
    </Fragment>
  </Demo>

  <h3 class="sub-title">Props</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Prop</th><th>类型</th><th>默认</th><th>说明</th></tr>
      </thead>
      <tbody>
        {
          apiRows.map((r) => (
            <tr>
              <td class="cell-name">
                <code>{r.name}</code>
              </td>
              <td>
                <code>{r.type}</code>
              </td>
              <td>
                <code>{r.default}</code>
              </td>
              <td class="cell-desc">{r.desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h3 class="sub-title">Slots</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Slot</th><th>说明</th></tr>
      </thead>
      <tbody>
        {
          slots.map((s) => (
            <tr>
              <td class="cell-name">
                <code>{s.name}</code>
              </td>
              <td class="cell-desc">{s.desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h3 class="sub-title">用法</h3>
  <pre class="usage"><code>{usage}</code></pre>
</>

<style>
  /* demo 卡片统一宽度，便于横向对比 */
  .demo__stage :global(.featurecard) {
    min-width: 13rem;
    max-width: 15rem;
  }
</style>
