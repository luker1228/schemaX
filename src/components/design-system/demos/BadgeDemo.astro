---
// Badge 演示 —— 左 code-block（.badge grammar + copy），右 live demo（5 变体）；
// 下方状态语义映射。砍掉 Props 表 / 用法卡 / 折叠说明。
import Badge from '../Badge.astro';
import type { BadgeVariant } from '../Badge.astro';

const variants: { name: string; value: BadgeVariant }[] = [
  { name: 'Default', value: 'default' },
  { name: 'Accent', value: 'accent' },
  { name: 'Action', value: 'action' },
  { name: 'Danger', value: 'danger' },
  { name: 'Success', value: 'success' },
];

const statusGroups: { variant: BadgeVariant; label: string; statuses: string[] }[] = [
  { variant: 'action', label: '计划 / 进行中', statuses: ['planned', 'planning', 'writing', 'draft'] },
  { variant: 'accent', label: '活跃', statuses: ['active'] },
  { variant: 'danger', label: '停用 / 归档', statuses: ['archived', 'paused'] },
  { variant: 'success', label: '完成 / 已发布', statuses: ['completed', 'published', 'maintained'] },
];

const badgeCode = `<span class="sel">.badge</span> {
  <span class="prop">border</span>: <span class="val">3px solid var(--sx-sys-color-border)</span>;
  <span class="prop">background</span>: <span class="val">var(--sx-sys-color-bg-surface)</span>;
  <span class="prop">box-shadow</span>: <span class="val">var(--sx-sys-shadow-sm)</span>;
  <span class="prop">text-transform</span>: <span class="val">uppercase</span>;
}

<span class="sel">.badge--accent</span>  { <span class="prop">background</span>: <span class="val">var(--sx-sys-color-accent)</span>; }
<span class="sel">.badge--success</span> { <span class="prop">background</span>: <span class="val">var(--sx-sys-color-success)</span>; }`;
---

<div class="nb-grid2">
  <div class="nb-codewrap">
    <span class="nb-codelabel">CSS</span>
    <pre class="nb-codeblock"><button class="nb-copy" type="button" data-copy="">Copy</button><code set:html={badgeCode} /></pre>
  </div>
  <div class="nb-demobox">
    <div class="nb-row">
      {variants.map((v) => <Badge variant={v.value}>{v.name}</Badge>)}
    </div>
  </div>
</div>

<div class="nb-demobox">
  <div class="nb-stack">
    {
      statusGroups.map((g) => (
        <div class="status-row">
          <Badge variant={g.variant}>{g.label}</Badge>
          <span class="status-vals">
            {g.statuses.map((s) => (<code>{s}</code>))}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sx-ref-space-3);
  }
  .status-vals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .status-vals code {
    font-family: var(--sx-sys-font-family-mono);
    font-size: var(--sx-sys-font-size-sm);
    background: var(--sx-sys-color-bg-page);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    padding: 0.05em 0.4em;
  }
</style>
