---
// CodeCompare 演示 —— 双窗口代码转换（深 / 浅顶栏），下方 code-block。
// CodeCompare 本身较宽，用全宽 nb-demobox 而非 grid2 并排。
import CodeCompare from '../CodeCompare.astro';

const cmpCode = `<span class="sel">.cmp</span> {
  <span class="prop">display</span>: <span class="val">flex</span>;
  <span class="prop">gap</span>: <span class="val">1.25rem</span>;
}
<span class="sel">.win</span> {
  <span class="prop">border</span>: <span class="val">2px solid var(--sx-sys-color-border)</span>;
  <span class="prop">background</span>: <span class="val">var(--sx-sys-color-beige)</span>;
}

<span class="com">/* 中间黑底黄箭头连接源 ↔ 目标 */</span>`;
---

<div class="nb-demobox">
  <CodeCompare from="MARKDOWN.MD" to="INDEX.HTML" bar="dark">
    <Fragment slot="source">{'# 标题\n## 副标题\n- 项目一\n- 项目二'}</Fragment>
    <Fragment slot="target">{'<h1>标题</h1>\n<h2>副标题</h2>\n<ul>\n  <li>项目一</li>\n  <li>项目二</li>\n</ul>'}</Fragment>
  </CodeCompare>
</div>

<div class="nb-demobox">
  <CodeCompare from="MARKDOWN.MD" to="INDEX.HTML" bar="light">
    <Fragment slot="source">{'**粗体** _斜体_ `code`'}</Fragment>
    <Fragment slot="target">{'<strong>粗体</strong>\n<em>斜体</em>\n<code>code</code>'}</Fragment>
  </CodeCompare>
</div>

<div class="nb-codewrap">
  <span class="nb-codelabel">CSS</span>
  <pre class="nb-codeblock"><button class="nb-copy" type="button" data-copy="">Copy</button><code set:html={cmpCode} /></pre>
</div>
