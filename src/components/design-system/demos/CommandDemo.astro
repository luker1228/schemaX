---
// Command 演示 —— 仅供 /design-system/components 展示页使用。
// 展示页通过 import.meta.glob 自动捕获本文件。
// 共享样式（.demo / .demo__head / .demo__stage 等）由展示页用 :global() 注入。
import Command from '../Command.astro';
import Demo from '../Demo.astro';

const example = 'npx run this-is-example';

const apiRows = [
  {
    name: 'theme',
    type: "'light' | 'dark'",
    default: "'dark'",
    desc: '屏幕主题。light = 浅色屏幕；dark = 黑色屏幕',
  },
  {
    name: 'title',
    type: 'string',
    default: "'bash'",
    desc: '标题栏显示的文件名 / shell 名',
  },
];

const usage = `---
import Command from '@/components/design-system/Command.astro';
---

<!-- 默认 dark -->
<Command>
  <code>npx run this-is-example</code>
</Command>

<!-- light -->
<Command theme="light" title="output.log">
  <code>ready in 1.2s</code>
</Command>`;
---

<>
  <Demo label="Dark（默认）" attr='theme="dark"'>
    <Command title="bash">
      <code>{example}</code>
    </Command>
    <Fragment slot="note">
      <p>
        黑色屏幕。内容完全由默认 slot 自由决定 —— 命令、输出、任意文本都行。
      </p>
    </Fragment>
  </Demo>

  <Demo label="Light" attr='theme="light"'>
    <Command theme="light" title="output.log">
      <code>{example}</code>
    </Command>
    <Fragment slot="note">
      <p>浅色（暖纸）屏幕，黑字。两种主题共享同一外观与标题栏。</p>
    </Fragment>
  </Demo>

  <h3 class="sub-title">Props</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Prop</th><th>类型</th><th>默认</th><th>说明</th></tr>
      </thead>
      <tbody>
        {apiRows.map((r) => (
          <tr>
            <td class="cell-name"><code>{r.name}</code></td>
            <td><code>{r.type}</code></td>
            <td><code>{r.default}</code></td>
            <td class="cell-desc">{r.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class="sub-title">用法</h3>
  <pre class="usage"><code>{usage}</code></pre>
</>
