---
// CompareToggle 演示 —— Standard SaaS ↔ Neubrutalist 同内容切换。
// 左 code-block（三属性对照），右 live demo（toggle 切换看气质反转）。
import CompareToggleIsland from '../CompareToggleIsland.astro';

const code = `<span class="com">/* 同一张卡片，只改三个属性 */</span>
<span class="prop">border-radius</span>  <span class="val">12px</span>            → <span class="val">0</span>
<span class="prop">box-shadow</span>     <span class="val">0 4px 12px rgba()</span> → <span class="val">var(--sx-sys-shadow-md)</span>
<span class="prop">border</span>         <span class="val">1px solid #d4d4d8</span> → <span class="val">3px solid #000</span>`;
---

<div class="nb-grid2">
  <div class="nb-codewrap">
    <span class="nb-codelabel">DIFF</span>
    <pre class="nb-codeblock"><button class="nb-copy" type="button" data-copy="">Copy</button><code set:html={code} /></pre>
  </div>
  <div class="nb-demobox">
    <CompareToggleIsland />
  </div>
</div>
