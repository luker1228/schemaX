---
// Demo 组件 —— 设计系统展示页的标准演示块
// 封装：标题栏（label + attr 代码）+ 舞台（默认 slot）+ 折叠说明（note slot）
// 用法：
//   <Demo label="默认态" attr='class="nav__link"'>
//     <Nav items={items} />
//     <Fragment slot="note">说明文字...</Fragment>
//   </Demo>

interface Props {
  /** 演示的状态名，如「默认态」「激活态」 */
  label: string;
  /** 头部右侧显示的代码片段，如 'aria-current="page"' */
  attr?: string;
  /** 舞台容器的额外类名：'wrap'（换行排列）/ 'align'（底对齐） */
  stageClass?: 'wrap' | 'align';
}

const { label, attr, stageClass } = Astro.props;
const stageClasses = ['demo__stage'];
if (stageClass === 'wrap') {
  stageClasses.push('demo__stage--wrap');
}
if (stageClass === 'align') {
  stageClasses.push('demo__stage--align');
}
---

<div class="demo">
  <div class="demo__head">
    <span class="demo__label">{label}</span>
    {attr && <code class="demo__attr">{attr}</code>}
  </div>

  <div class={stageClasses.join(' ')}>
    <slot />
  </div>

  <details class="demo__details">
    <summary class="demo__summary">说明</summary>
    <div class="demo__note">
      <slot name="note" />
    </div>
  </details>
</div>

<style>
  .demo {
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-comp-demo-shadow);
    margin-block-end: var(--sx-ref-space-4);
  }

  /* 头部：状态名 + 代码片段 */
  .demo__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sx-ref-space-3);
    padding: var(--sx-ref-space-2) var(--sx-ref-space-3);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-page);
    flex-wrap: wrap;
  }
  .demo__label {
    font-weight: 800;
    font-size: 0.9rem;
  }
  .demo__attr {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    background: var(--sx-sys-color-bg-surface);
    padding: 0.05em 0.4em;
  }

  /* 舞台：演示内容区 */
  .demo__stage {
    padding: var(--sx-ref-space-6);
    display: flex;
    justify-content: center;
  }
  /* 舞台里的 nav 默认居中 */
  .demo__stage :global(.nav) {
    justify-content: center;
  }
  .demo__stage--wrap {
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sx-ref-space-3);
  }
  .demo__stage--align {
    align-items: flex-end;
  }

  /* 折叠说明：默认收起，点击展开。零 JS（原生 <details>）。 */
  .demo__details {
    border-top: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    font-size: 0.85rem;
  }
  .demo__summary {
    padding: var(--sx-ref-space-2) var(--sx-ref-space-3);
    cursor: pointer;
    user-select: none;
    opacity: 0.7;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    list-style: none;
    transition:
      opacity 120ms ease,
      background-color 120ms ease;
  }
  .demo__summary:hover {
    opacity: 1;
    background: var(--sx-sys-color-bg-page);
  }
  /* 隐藏原生 marker，用自定义 ▸/▾ */
  .demo__summary::-webkit-details-marker {
    display: none;
  }
  .demo__summary::before {
    content: '▸ ';
  }
  .demo__details[open] > .demo__summary::before {
    content: '▾ ';
  }
  .demo__note {
    padding: var(--sx-ref-space-2) var(--sx-ref-space-3) var(--sx-ref-space-3);
    opacity: 0.75;
  }
  .demo__note :global(p) {
    margin: 0;
  }
  .demo__note :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    background: var(--sx-sys-color-bg-page);
    padding: 0.05em 0.35em;
  }
</style>
