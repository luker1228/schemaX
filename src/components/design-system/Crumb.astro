---
// Crumb 组件 —— SchemaX UI
// 胶囊样式面包屑：白底 + 2px 黑边 + 小硬阴影，等宽小字。
// 用于页面 hero 顶部的层级路径。与 Breadcrumb.astro（居中链接、hover 黄底）
// 是两种视觉变体：本组件强调「带边框的胶囊标签」质感。
//
// 对齐：nav 默认占满父容器宽度并居中放置胶囊 —— 这样在居中的 PageHeader
// 上方能与标题对齐；在 flex 居中的 hero 里也能正确居中。
//
// 数据驱动：items 数组描述每一级。最后一项自动渲染为 aria-current="page"
// （不可点、无 href），其余渲染为链接。

export interface CrumbItem {
  /** 显示文字 */
  label: string;
  /** 链接地址；最后一项会忽略此字段（当前页不可点） */
  href?: string;
}

interface Props {
  /** 层级路径，按从根到当前页顺序。最后一项 = 当前页 */
  items: CrumbItem[];
  /** nav 的可访问性标签，默认 'Breadcrumb' */
  ariaLabel?: string;
  /**
   * 胶囊水平对齐。
   * - center（默认）：列表页 + 居中 PageHeader
   * - start：详情页左对齐内容（课程 / 作品 / 文章）
   */
  align?: 'center' | 'start';
}

const { items, ariaLabel = 'Breadcrumb', align = 'center' } = Astro.props;
const alignClass = align === 'start' ? 'crumb--start' : '';
---

<nav class:list={['crumb', alignClass]} aria-label={ariaLabel}>
  <div class="crumb__pill">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <Fragment>
            {isLast ? (
              <span class="crumb__current" aria-current="page">
                {item.label}
              </span>
            ) : (
              <a class="crumb__link" href={item.href}>
                {item.label}
              </a>
            )}
            {!isLast && (
              <span class="crumb__sep" aria-hidden="true">
                /
              </span>
            )}
          </Fragment>
        );
      })
    }
  </div>
</nav>

<style>
  /* nav 占满父容器宽度；默认居中（列表页 PageHeader），详情页用 --start 左对齐 */
  .crumb {
    display: flex;
    justify-content: center;
  }
  .crumb--start {
    justify-content: flex-start;
  }

  /* 胶囊：白底 + 2px 黑边 + 小硬阴影 */
  .crumb__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-md);
    box-shadow: var(--sx-sys-shadow-sm);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .crumb__link {
    color: var(--sx-sys-color-text-soft);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .crumb__link:hover,
  .crumb__link:focus-visible {
    color: var(--sx-sys-color-text-primary);
  }
  .crumb__sep {
    color: var(--sx-sys-color-text-soft);
    opacity: 0.55;
  }
  .crumb__current {
    color: var(--sx-sys-color-text-primary);
  }
</style>
