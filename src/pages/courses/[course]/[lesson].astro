---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocSide from '../../../components/design-system/DocSide';
import type { DocSideGroup } from '../../../components/design-system/DocSide';
import DocPager from '../../../components/design-system/DocPager';
import LessonHero from '../../../components/course/LessonHero';
import LessonBoard from '../../../components/course/LessonBoard';
import { getCollection, render } from 'astro:content';
import { courseIdOf } from '../../../lib/content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { course: courseIdOf(lesson.data.course), lesson: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const courseId = Astro.params.course as string;
const { Content } = await render(lesson);
const {
  title,
  description,
  durationMinutes,
  objectives,
  hero,
  presentation = 'scroll',
} = lesson.data;
const isBoard = presentation === 'board';
const isStepper = presentation === 'stepper';
const usesBoardShell = isBoard || isStepper;

const siblings = (await getCollection('lessons'))
  .filter((l) => courseIdOf(l.data.course) === courseId)
  .sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((l) => l.id === lesson.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];

const lessonHref = (id: string) => `/courses/${courseId}/${id}`;
const pagerPrev = prev
  ? { title: prev.data.title, href: lessonHref(prev.id) }
  : null;
const pagerNext = next
  ? { title: next.data.title, href: lessonHref(next.id) }
  : null;

const readTime = durationMinutes
  ? `阅读时长 ≈ ${durationMinutes} 分钟`
  : undefined;

// 侧栏：基础篇 / 进阶篇分组（当前课高亮）
const partLabel = { basics: '基础篇', advanced: '进阶篇' } as const;
const partOrder = ['basics', 'advanced'] as const;
const sideGroups: DocSideGroup[] = partOrder
  .map((part): DocSideGroup | null => {
    const items = siblings
      .filter((l) => (l.data.part ?? 'basics') === part)
      .map((l) => ({
        label: `${l.data.order}. ${l.data.title}`,
        href: lessonHref(l.id),
        current: l.id === lesson.id,
      }));
    if (items.length === 0) return null;
    return {
      title: partLabel[part],
      ariaLabel: `${partLabel[part]}课时`,
      items,
    };
  })
  .filter((g): g is DocSideGroup => g !== null);
---

<BaseLayout title={title} description={description} type="article">
  {/* 双栏壳与设计系统组件页共用：.sx-doc-layout（layout.css + sys.layout.*） */}
  <article class="sx-doc-layout">
    <div class="sx-doc-side-slot">
      <DocSide groups={sideGroups} label="课时目录" />
    </div>

    <div class="sx-doc-main">
      {
        usesBoardShell ? (
          /* 白板 / 引导式 stepper：无顶部 DocPager；末页可进下一章 */
          <LessonBoard client:load
            mode={isStepper ? 'stepper' : 'board'}
            cover={hero}
            readTime={readTime}
            nextChapter={pagerNext}
          >
            <div class="lesson-body lesson-body--board sx-article sx-article--lesson">
              <Content />
            </div>
          </LessonBoard>
        ) : (
          <>
            <div class="lesson-pager">
              <DocPager
                prev={pagerPrev}
                next={pagerNext}
                centerHref="/courses"
                centerLabel="全部课程"
                label="课时前后导航"
              />
            </div>
            {hero ? (
              <LessonHero
                line1={hero.line1}
                line2={hero.line2}
                badge={hero.badge}
                pillFill={hero.pillFill}
                pillOutline={hero.pillOutline}
                readTime={readTime}
              />
            ) : (
              <header class="lhead">
                <h1 class="lhead__title">{title}</h1>
                <p class="lhead__desc">{description}</p>
                {objectives.length > 0 && (
                  <details class="lhead__obj">
                    <summary>本节目标</summary>
                    <ul>
                      {objectives.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </header>
            )}

            <div
              class="lesson-body sx-article sx-article--lesson"
              data-pagefind-body
            >
              <Content />
            </div>

            {/* 末尾前后导航：读完一节即可继续翻页，与顶部同款 DocPager */}
            <div class="lesson-pager lesson-pager--end">
              <DocPager
                prev={pagerPrev}
                next={pagerNext}
                centerHref="/courses"
                centerLabel="全部课程"
                label="课时前后导航"
              />
            </div>
          </>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  /* —— 页面专属：默认标题 / 正文间距（双栏壳见 layout.css；导航见 DocPager） —— */

  .lhead {
    /* 吃满主区宽度（与正文 / hero / pager 对齐），不锁阅读栏 */
    margin-inline: auto;
    margin-block-end: 0.5rem;
    padding-block-end: var(--sx-ref-space-6);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  /* 顶部前后导航条：对齐到同一阅读栏（包裹 DocPager，覆盖其默认 75% 宽，
     不改共享组件本身）。特异性 .lesson-pager[cid] .docs-nav (0,3,0) 盖过
     DocPager 自身的 .docs-nav[cid] (0,2,0)。 */
  .lesson-pager {
    width: 100%;
    margin-inline: auto;
  }
  .lesson-pager :global(.docs-nav) {
    width: 100%;
  }
  .lhead__title {
    font-family: var(--sx-sys-font-family-display);
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 var(--sx-ref-space-2);
  }
  .lhead__desc {
    font-size: var(--sx-sys-font-size-reading);
    opacity: 0.85;
    margin: 0;
  }
  .lhead__obj {
    margin-block-start: var(--sx-ref-space-4);
  }
  .lhead__obj ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-block-start: var(--sx-ref-space-2);
  }

  .lesson-body {
    display: flex;
    flex-direction: column;
    /* 节与节明显换气：编号徽章认节 + 大留白分段 */
    gap: clamp(3rem, 5.5vw, 4rem);
    width: 100%;
    /* scroll 模式：吃满主区宽度（遵循 .sx-article--lesson 的 max-width:none 本意），
       不锁阅读栏；行长由 StepSplit 的 .step-split__copy > p{max-width:42rem} 控制。
       board 模式走 .lesson-body--board（display:contents，无盒），不影响分页 slide 宽度。 */
    margin-inline: auto;
  }

  /* 白板模式：节间距交给板内 stage，body 用 contents 把 step 提成 slide */
  .lesson-body--board {
    display: contents;
    gap: 0;
  }

  /* 纯文字提示块限阅读栏宽（保中文行长可读）；StepSplit 双列 / 卡片 / 代码 / island
     仍吃满主区（它们自身已有 copy 42rem 等内层限宽）。仅课程页，不影响设计系统页。 */
  .lesson-body :global(.doc-note) {
    max-width: var(--sx-article-width-reading);
  }

  .lesson-body :global(.step),
  .lesson-body :global(.lhero) {
    max-width: none;
  }
</style>
