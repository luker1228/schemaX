---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocSide from '../../../components/design-system/DocSide.astro';
import type { DocSideGroup } from '../../../components/design-system/DocSide.astro';
import DocPager from '../../../components/design-system/DocPager.astro';
import LessonHero from '../../../components/course/LessonHero.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { courseIdOf } from '../../../lib/content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { course: courseIdOf(lesson.data.course), lesson: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const courseId = Astro.params.course as string;
const course = await getEntry('courses', courseId);
const { Content } = await render(lesson);
const { title, description, durationMinutes, objectives, hero } = lesson.data;

const siblings = (await getCollection('lessons'))
  .filter((l) => courseIdOf(l.data.course) === courseId)
  .sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((l) => l.id === lesson.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];

const lessonHref = (id: string) => `/courses/${courseId}/${id}`;
const pagerPrev = prev
  ? { title: prev.data.title, href: lessonHref(prev.id) }
  : null;
const pagerNext = next
  ? { title: next.data.title, href: lessonHref(next.id) }
  : null;

const readTime = durationMinutes
  ? `阅读时长 ≈ ${durationMinutes} 分钟`
  : undefined;

// 侧栏：课程课时目录（当前课高亮）
const sideGroups: DocSideGroup[] = [
  {
    title: course?.data.title ?? '课时',
    ariaLabel: '课时目录',
    items: siblings.map((l) => ({
      label: `${l.data.order}. ${l.data.title}`,
      href: lessonHref(l.id),
      current: l.id === lesson.id,
    })),
  },
];
---

<BaseLayout title={title} description={description} type="article">
  {/* 双栏壳与设计系统组件页共用：.sx-doc-layout（layout.css + sys.layout.*） */}
  <article class="sx-doc-layout">
    <div class="sx-doc-side-slot">
      <DocSide groups={sideGroups} label="课时目录" />
    </div>

    <div class="sx-doc-main">
      {/* 与设计系统组件页同一 DocPager：prev / 课程目录 / next */}
      <DocPager
        prev={pagerPrev}
        next={pagerNext}
        centerHref={`/courses/${courseId}`}
        centerLabel="课程目录"
        label="课时前后导航"
      />

      {
        hero ? (
          <LessonHero
            line1={hero.line1}
            line2={hero.line2}
            badge={hero.badge}
            pillFill={hero.pillFill}
            pillOutline={hero.pillOutline}
            readTime={readTime}
          />
        ) : (
          <header class="lhead">
            <h1 class="lhead__title">{title}</h1>
            <p class="lhead__desc">{description}</p>
            {objectives.length > 0 && (
              <details class="lhead__obj">
                <summary>本节目标</summary>
                <ul>
                  {objectives.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </details>
            )}
          </header>
        )
      }

      <div class="lesson-body sx-article sx-article--lesson" data-pagefind-body>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* —— 页面专属：默认标题 / 正文间距（双栏壳见 layout.css；导航见 DocPager） —— */

  .lhead {
    margin-block-end: 0.5rem;
    padding-block-end: var(--sx-ref-space-6);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .lhead__title {
    font-family: var(--sx-sys-font-family-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 var(--sx-ref-space-2);
  }
  .lhead__desc {
    font-size: 1.1rem;
    opacity: 0.85;
    margin: 0;
  }
  .lhead__obj {
    margin-block-start: var(--sx-ref-space-4);
  }
  .lhead__obj ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-block-start: var(--sx-ref-space-2);
  }

  .lesson-body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
    max-width: none;
    margin-inline: 0;
  }

  .lesson-body :global(.step),
  .lesson-body :global(.ta),
  .lesson-body :global(.lhero) {
    max-width: none;
  }
</style>
