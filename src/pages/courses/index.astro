---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/site/CourseCard';
import Crumb from '../../components/design-system/Crumb';
import { getCollection } from 'astro:content';

const courses = (
  await getCollection('courses', ({ data }) => data.status !== 'archived')
).sort((a, b) => {
  // active 优先，其余按标题
  const rank = (s: string) => (s === 'active' ? 0 : s === 'writing' ? 1 : 2);
  const d = rank(a.data.status) - rank(b.data.status);
  return d !== 0 ? d : a.data.title.localeCompare(b.data.title, 'zh');
});

const typeCount = new Set(courses.map((c) => c.data.type)).size;

const courseVars = [
  {
    name: 'surface',
    value: '#FFFFFF',
    token: 'var(--sx-sys-color-bg-surface)',
  },
  { name: 'lesson', value: 'MDX', token: 'var(--sx-sys-color-accent)' },
  { name: 'preview', value: 'React', token: 'var(--sx-sys-color-coral)' },
  { name: 'accent', value: '#74B9FF', token: 'var(--sx-sys-color-sky)' },
  {
    name: 'action',
    value: '#2F5BEA',
    token: 'var(--sx-sys-color-action-primary)',
  },
];
---

<BaseLayout title="Courses" description="体系化课程、章节与练习。">
  <header class="sx-section courses-hero">
    <div class="sx-container courses-hero__inner">
      <div class="courses-hero__copy">
        <Crumb items={[{ label: 'Home', href: '/' }, { label: 'Courses' }]} />
        <div class="courses-hero__meta">
          <span class="courses-stamp">SchemaX Academy</span>
          <span class="courses-clash" aria-hidden="true">
            <span class="courses-clash__dot"></span>
            <span class="courses-clash__dot"></span>
            <span class="courses-clash__dot"></span>
          </span>
        </div>
        <h1 class="courses-hero__title">
          体系化课程
          <span class="courses-hero__title-hl">与练习</span>
        </h1>
        <p class="courses-hero__desc">
          可验证的学习路径——不是播放列表。从骨架到装修，一步能复现；结构先行，再谈自动化。
        </p>
        <ul class="courses-hero__stack" aria-label="课程结构">
          <li>HTML · CSS · JavaScript · React</li>
          <li>Schema · Agent · API · Engineering Practice</li>
        </ul>
        <div class="courses-hero__pills" aria-label="课程主题">
          <span class="courses-pill courses-pill--accent">Frontend</span>
          <span class="courses-pill courses-pill--action">AI Agent</span>
          <span class="courses-pill">Practice</span>
        </div>
      </div>
      <div class="courses-vars" aria-hidden="true">
        <div class="courses-vars__panel">
          <div class="courses-vars__head">
            <span class="courses-vars__title">◆ COURSE SYSTEM</span>
            <span class="courses-vars__add">+</span>
          </div>
          <span class="courses-vars__divider"></span>
          <span class="courses-vars__collection">learning / modules</span>
          {
            courseVars.map((v) => (
              <div class="courses-vars__row">
                <span class="courses-vars__rowleft">
                  <span
                    class="courses-vars__chip"
                    style={`background:${v.token}`}
                  />
                  <span class="courses-vars__name">{v.name}</span>
                </span>
                <span class="courses-vars__value">{v.value}</span>
              </div>
            ))
          }
          <span class="courses-vars__divider"></span>
          <div class="courses-vars__mode">
            <span class="courses-vars__modeicon">◐</span>
            <span class="courses-vars__modelabel">Mode · Learn</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="sx-band sx-band--sky" aria-hidden="true"></div>

  <section
    class="sx-section courses-catalog"
    aria-labelledby="courses-catalog-title"
  >
    <div class="sx-container">
      <div class="courses-catalog__head">
        <h2 class="courses-catalog__title" id="courses-catalog-title">
          全部课程
        </h2>
        <p class="courses-catalog__sub">按当前状态与标题排序</p>
      </div>
      {
        courses.length > 0 ? (
          <div class="sx-grid">
            {courses.map((c) => (
              <CourseCard course={c} />
            ))}
          </div>
        ) : (
          <p class="empty">还没有课程。</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* 撞色 hero（sky 蓝，区分首页黄 / blog 紫）。黑字（天蓝底黑字 ~8:1）。 */
  .courses-hero {
    background-color: color-mix(
      in srgb,
      var(--sx-sys-color-sky) 22%,
      var(--sx-sys-color-bg-surface)
    );
  }
  .courses-hero__inner {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sx-ref-space-3);
  }
  .courses-hero__kicker {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
    opacity: 0.7;
  }
  .courses-hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-md);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--sx-sys-color-text-primary);
  }
  .courses-hero__desc {
    margin: 0;
    max-width: 46rem;
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.55;
    color: var(--sx-sys-color-text-primary);
    opacity: 0.85;
  }
  .courses-hero__stat {
    margin: 0;
    margin-top: var(--sx-ref-space-2);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
    opacity: 0.7;
  }
  .courses-catalog__head {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    margin-bottom: var(--sx-ref-space-6);
  }
  .courses-catalog__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-sm);
    font-weight: 800;
    line-height: 1.05;
    color: var(--sx-sys-color-text-primary);
  }
  .courses-catalog__sub {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }
  .empty {
    border: var(--sx-sys-border-width) dashed var(--sx-sys-color-border);
    padding: var(--sx-ref-space-8);
    text-align: center;
    opacity: 0.7;
  }
</style>

<style>
  .courses-hero {
    position: relative;
  }

  .courses-hero__inner {
    position: relative;
    padding-block: var(--sx-ref-space-4) var(--sx-ref-space-12);
  }

  .courses-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sx-ref-space-6);
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .courses-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
  }

  .courses-stamp {
    display: inline-flex;
    padding: 0.4rem 0.7rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-md);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--sx-sys-shadow-sm);
    transform: rotate(1.2deg);
  }

  .courses-hero__title {
    font-size: var(--sx-sys-font-display-lg);
  }

  .courses-hero__title-hl {
    display: inline-block;
    margin-left: 0.15em;
    padding: 0 0.12em;
    background: var(--sx-sys-color-accent);
  }

  .courses-hero__desc {
    max-width: 40ch;
    line-height: 1.7;
    opacity: 1;
  }

  .courses-hero__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .courses-hero__stack li {
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    line-height: 1.55;
  }

  .courses-hero__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sx-ref-space-3);
  }

  .courses-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.75rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: var(--sx-sys-shadow-sm);
  }

  .courses-pill--accent {
    background: var(--sx-sys-color-accent);
  }

  .courses-pill--action {
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
  }

  .courses-clash {
    display: inline-flex;
    gap: 0.25rem;
  }

  .courses-clash__dot {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-accent);
  }

  .courses-clash__dot:nth-child(2) {
    background: var(--sx-sys-color-coral);
  }

  .courses-clash__dot:nth-child(3) {
    background: var(--sx-sys-color-action-primary);
  }

  .courses-vars {
    position: absolute;
    top: 0;
    right: 0;
    display: none;
    pointer-events: none;
  }

  .courses-vars__panel {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 13.5rem;
    padding: 0.75rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-md);
    transform: rotate(-8deg);
    transform-origin: top right;
  }

  .courses-vars__head,
  .courses-vars__row,
  .courses-vars__rowleft,
  .courses-vars__mode {
    display: flex;
    align-items: center;
  }

  .courses-vars__head,
  .courses-vars__row {
    justify-content: space-between;
  }

  .courses-vars__rowleft {
    gap: 0.5rem;
  }

  .courses-vars__title,
  .courses-vars__collection,
  .courses-vars__name,
  .courses-vars__value,
  .courses-vars__modelabel {
    font-family: var(--sx-sys-font-family-mono);
    font-size: var(--sx-sys-font-size-xs);
  }

  .courses-vars__title,
  .courses-vars__name,
  .courses-vars__modelabel {
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

  .courses-vars__add,
  .courses-vars__collection,
  .courses-vars__value,
  .courses-vars__modeicon {
    color: var(--sx-sys-color-text-soft);
  }

  .courses-vars__add {
    font-family: var(--sx-sys-font-family-mono);
    font-size: var(--sx-sys-font-size-base);
    font-weight: 800;
    line-height: 1;
  }

  .courses-vars__collection,
  .courses-vars__modelabel {
    letter-spacing: 0.04em;
  }

  .courses-vars__divider {
    height: 1px;
    background: var(--sx-sys-color-border);
  }

  .courses-vars__chip {
    width: 1rem;
    height: 1rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }

  .courses-vars__mode {
    gap: 0.375rem;
  }

  .courses-vars__modeicon {
    font-size: var(--sx-sys-font-size-xs);
    line-height: 1;
  }

  @media (min-width: 82rem) {
    .courses-vars {
      display: block;
    }
  }
</style>
