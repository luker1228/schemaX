---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/site/CourseCard.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import Breadcrumb from '../../components/design-system/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const courses = await getCollection(
  'courses',
  ({ data }) => data.status !== 'archived',
);
---

<BaseLayout title="Courses" description="体系化课程、章节与练习。">
  <section class="sx-section">
    <div class="sx-container">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Courses' },
        ]}
      />

      <PageHeader title="Courses" description="体系化课程、章节与练习。" />

      {
        courses.length > 0 ? (
          <div class="sx-grid">
            {courses.map((c) => (
              <CourseCard course={c} />
            ))}
          </div>
        ) : (
          <p class="empty">还没有课程。</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    border: var(--sx-sys-border-width) dashed var(--sx-sys-color-border);
    padding: var(--sx-ref-space-8);
    text-align: center;
    opacity: 0.7;
  }
</style>
