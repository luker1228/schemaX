---
/**
 * 课程入口 `/courses/:course` —— 不再渲染独立中间页。
 * 有课时时重定向到第一课；无课时时回退课程列表。
 *
 * 用组件内 Astro.redirect() 发起重定向（dev 与 SSG 下均为稳定的一等行为，
 * 比在 getStaticPaths 里返回 redirect 字段可靠——后者在 dev 下会产出空 200）。
 */
import { getCollection } from 'astro:content';
import { courseIdOf } from '../../lib/content';

export async function getStaticPaths() {
  const courses = await getCollection(
    'courses',
    ({ data }) => data.status !== 'archived',
  );
  const lessons = await getCollection('lessons');

  return courses.map((course) => {
    const first = lessons
      .filter((l) => courseIdOf(l.data.course) === course.id)
      .sort((a, b) => a.data.order - b.data.order)[0];

    return {
      params: { course: course.id },
      props: { firstLessonId: first?.id ?? null },
    };
  });
}

const { course } = Astro.params;
const { firstLessonId } = Astro.props;
return Astro.redirect(
  firstLessonId ? `/courses/${course}/${firstLessonId}` : '/courses',
);
---
