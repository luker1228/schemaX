---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumb from '../../components/design-system/Crumb.astro';
import Badge from '../../components/design-system/Badge.astro';
import Button from '../../components/design-system/Button.astro';
import Card from '../../components/design-system/Card.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { courseIdOf } from '../../lib/content';

export async function getStaticPaths() {
  const courses = await getCollection(
    'courses',
    ({ data }) => data.status !== 'archived',
  );
  return courses.map((course) => ({
    params: { course: course.id },
    props: { course },
  }));
}

interface Props {
  course: CollectionEntry<'courses'>;
}
const { course } = Astro.props;
const {
  title,
  description,
  type,
  level,
  objectives,
  prerequisites,
  estimatedHours,
} = course.data;

const { Content } = await render(course);

const lessons = (await getCollection('lessons'))
  .filter((l) => courseIdOf(l.data.course) === course.id)
  .sort((a, b) => a.data.order - b.data.order);

const firstLesson = lessons[0];
const lessonCount = lessons.length;

const partLabel = { basics: '基础篇', advanced: '进阶篇' } as const;
const partOrder = ['basics', 'advanced'] as const;
const lessonParts = partOrder
  .map((part) => ({
    part,
    title: partLabel[part],
    lessons: lessons.filter((l) => (l.data.part ?? 'basics') === part),
  }))
  .filter((g) => g.lessons.length > 0);

const hasMeta = objectives.length > 0 || prerequisites.length > 0;
---

<BaseLayout title={title} description={description} type="course">
  <section class="sx-section">
    <div class="sx-container">
      <Crumb
        align="start"
        items={[
          { label: 'Home', href: '/' },
          { label: 'Courses', href: '/courses' },
          { label: title },
        ]}
      />

      <header class="chead">
        <div class="chead__tags">
          <Badge variant="accent">{type}</Badge>
          <Badge>{level}</Badge>
          {
            estimatedHours && (
              <span class="chead__stat" title="预计学习时长">
                ≈ {estimatedHours} 小时
              </span>
            )
          }
          {
            lessonCount > 0 && (
              <span class="chead__stat" title="章节数量">
                {lessonCount} 章
              </span>
            )
          }
        </div>
        <h1 class="chead__title">{title}</h1>
        <p class="chead__desc">{description}</p>
        {
          firstLesson && (
            <div class="chead__actions">
              <Button
                variant="primary"
                size="lg"
                href={`/courses/${course.id}/${firstLesson.id}`}
              >
                开始学习
              </Button>
              <a class="chead__skip" href="#chapters">
                浏览章节 ↓
              </a>
            </div>
          )
        }
      </header>

      {
        hasMeta && (
          <div class="cmeta">
            {objectives.length > 0 && (
              <Card class="cmeta__card" shadow="sm" interactive={false}>
                <h2 class="cmeta__label">学习目标</h2>
                <ul class="cmeta__list">
                  {objectives.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </Card>
            )}
            {prerequisites.length > 0 && (
              <Card class="cmeta__card" shadow="sm" interactive={false}>
                <h2 class="cmeta__label">前置知识</h2>
                <ul class="cmeta__list">
                  {prerequisites.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
              </Card>
            )}
          </div>
        )
      }

      <div class="cbody sx-article" data-pagefind-body>
        <Content />
      </div>

      <div class="chapters" id="chapters">
        <div class="chapters__head">
          <h2 class="chapters__title">章节</h2>
          {
            lessonCount > 0 && (
              <span class="chapters__count">{lessonCount} 节</span>
            )
          }
        </div>
        {
          lessonParts.length > 0 ? (
            lessonParts.map((group) => (
              <div class="lesson-part">
                <div class="lesson-part__head">
                  <h3 class="lesson-part__title">{group.title}</h3>
                  <span class="lesson-part__count">
                    {group.lessons.length} 节
                  </span>
                </div>
                <ol class="lessons">
                  {group.lessons.map((l) => (
                    <li>
                      <a href={`/courses/${course.id}/${l.id}`}>
                        <span class="lessons__n">
                          {String(l.data.order).padStart(2, '0')}
                        </span>
                        <span class="lessons__t">{l.data.title}</span>
                        {l.data.durationMinutes ? (
                          <span class="lessons__dur">
                            {l.data.durationMinutes} 分
                          </span>
                        ) : null}
                        <span class="lessons__go" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          ) : (
            <p class="empty">章节即将上线。</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chead {
    margin-block: var(--sx-ref-space-4) var(--sx-ref-space-8);
    padding-block-end: var(--sx-ref-space-6);
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .chead__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sx-ref-space-2);
  }
  .chead__stat {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--sx-sys-color-text-soft);
    padding: 0.15em 0.55em;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    background: var(--sx-sys-color-bg-surface);
    line-height: 1.4;
  }
  .chead__title {
    font-family: var(--sx-sys-font-family-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-block: var(--sx-ref-space-3) var(--sx-ref-space-3);
    text-wrap: balance;
  }
  .chead__desc {
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 42rem;
    color: var(--sx-sys-color-text-soft);
    margin: 0;
  }
  .chead__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sx-ref-space-4);
    margin-block-start: var(--sx-ref-space-5);
  }
  .chead__skip {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
    text-decoration: none;
    border-bottom: var(--sx-sys-border-width) solid transparent;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .chead__skip:hover,
  .chead__skip:focus-visible {
    color: var(--sx-sys-color-text-primary);
    border-bottom-color: var(--sx-sys-color-border);
  }

  .cmeta {
    display: grid;
    gap: var(--sx-ref-space-4);
    grid-template-columns: 1fr;
    margin-block-end: var(--sx-ref-space-8);
  }
  @media (min-width: 40rem) {
    .cmeta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Card 根节点在子组件作用域；用 :global 保证等高与内部节奏 */
  .cmeta :global(.cmeta__card) {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-3);
    height: 100%;
    min-width: 0;
  }
  .cmeta__label {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-soft);
  }
  .cmeta__list {
    margin: 0;
    padding-left: 1.15rem;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cbody {
    max-width: 42rem;
    margin-block-end: var(--sx-ref-space-10);
  }
  .cbody :global(p:first-child) {
    margin-block-start: 0;
  }
  .cbody :global(p:last-child) {
    margin-block-end: 0;
  }

  .chapters {
    scroll-margin-top: 5rem;
  }
  .chapters__head {
    display: flex;
    align-items: baseline;
    gap: var(--sx-ref-space-3);
    margin-block-end: var(--sx-ref-space-5);
  }
  .chapters__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .chapters__count {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
  }

  .lesson-part {
    margin-block-end: var(--sx-ref-space-6);
  }
  .lesson-part:last-child {
    margin-block-end: 0;
  }
  .lesson-part__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sx-ref-space-3);
    margin-block-end: var(--sx-ref-space-2);
  }
  .lesson-part__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-primary);
  }
  .lesson-part__count {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
  }

  .lessons {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    box-shadow: var(--sx-sys-shadow-sm);
  }
  .lessons li {
    border-bottom: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
  }
  .lessons li:last-child {
    border-bottom: none;
  }
  .lessons a {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: var(--sx-ref-space-3);
    align-items: center;
    padding: 0.85rem 1rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    transition: background-color 120ms ease;
  }
  .lessons a:hover {
    background: var(--sx-sys-color-accent);
    color: var(--sx-sys-color-text-primary);
  }
  .lessons a:focus-visible {
    outline: var(--sx-sys-border-width) solid var(--sx-sys-color-action-primary);
    outline-offset: -2px;
    z-index: 1;
    position: relative;
  }
  .lessons__n {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--sx-sys-color-action-primary);
    min-width: 1.75rem;
  }
  .lessons a:hover .lessons__n {
    color: var(--sx-sys-color-text-primary);
  }
  .lessons__t {
    min-width: 0;
    line-height: 1.35;
  }
  .lessons__dur {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
    white-space: nowrap;
  }
  .lessons a:hover .lessons__dur {
    color: var(--sx-sys-color-text-primary);
  }
  .lessons__go {
    font-family: var(--sx-sys-font-family-mono);
    font-weight: 800;
    color: var(--sx-sys-color-text-soft);
    transition: transform 120ms ease;
  }
  .lessons a:hover .lessons__go {
    color: var(--sx-sys-color-text-primary);
    transform: translateX(2px);
  }

  .empty {
    border: var(--sx-sys-border-width) dashed var(--sx-sys-color-border);
    padding: var(--sx-ref-space-8);
    text-align: center;
    color: var(--sx-sys-color-text-soft);
    background: var(--sx-sys-color-bg-surface);
  }

  @media (max-width: 40rem) {
    .lessons a {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'n t go'
        'n d go';
      column-gap: var(--sx-ref-space-3);
      row-gap: 0.15rem;
      align-items: center;
    }
    .lessons__n {
      grid-area: n;
      align-self: center;
    }
    .lessons__t {
      grid-area: t;
    }
    .lessons__dur {
      grid-area: d;
    }
    .lessons__go {
      grid-area: go;
      align-self: center;
    }
  }
</style>
