---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/design-system/FeatureCard.astro';
import Crumb from '../../components/design-system/Crumb.astro';
import Doodle from '../../components/design-system/Doodle.astro';

/**
 * 设计系统枢纽页 —— SchemaX UI 作为作品本身的入口。
 * 视觉：RetroUI 硬卡底座 + Rough 涂鸦媒体 + 蓝/黄强调（不用彩虹装饰）。
 */

// Figma Variables 装饰面板色块：语义 token + 文档 hex（纯装饰，非业务色）
const figmaVars = [
  { name: 'bg', value: '#FFF7E8', token: 'var(--sx-sys-color-bg-page)' },
  { name: 'ink', value: '#000000', token: 'var(--sx-sys-color-text-primary)' },
  { name: 'accent', value: '#FFDC58', token: 'var(--sx-sys-color-accent)' },
  {
    name: 'action',
    value: '#2F5BEA',
    token: 'var(--sx-sys-color-action-primary)',
  },
  { name: 'mint', value: '#01FFCC', token: 'var(--sx-sys-color-mint)' },
];

type Entry = {
  title: string;
  desc: string;
  href?: string;
  status: 'live' | 'planned';
  /** FeatureCard 媒体条底色 */
  media: string;
  /** Rough 涂鸦 kind —— 与入口语义一一对应 */
  doodle:
    | 'icon-base'
    | 'icon-palette'
    | 'icon-component'
    | 'icon-blog'
    | 'icon-pattern';
};

// 阅读顺序：为什么 → 取值 → 零件 → 正文 → 模式
const entries: Entry[] = [
  {
    title: 'Foundations',
    desc: '设计语言的「为什么」：视觉方向、核心原则、基础取值。',
    href: '/design-system/foundations',
    status: 'live',
    media: 'var(--sx-sys-color-accent)',
    doodle: 'icon-base',
  },
  {
    title: 'Tokens',
    desc: 'Reference / Semantic / Article / Component —— 读取生成产物，不手抄文档。',
    href: '/design-system/tokens',
    status: 'live',
    media: 'var(--sx-sys-color-bg-page)',
    doodle: 'icon-palette',
  },
  {
    title: 'Components',
    desc: 'RetroUI 底座：Button、Card、Badge、Nav、Command……可按、可抬的实体控件。',
    href: '/design-system/components',
    status: 'live',
    media: 'var(--sx-sys-color-action-primary)',
    doodle: 'icon-component',
  },
  {
    title: 'Content',
    desc: 'Markdown / MDX 真实排版：阅读柱、代码块、引用与标注。',
    href: '/design-system/content',
    status: 'live',
    media: 'var(--sx-sys-color-accent)',
    doodle: 'icon-blog',
  },
  {
    title: 'Patterns',
    desc: '文章头、课程目录、项目 Hero、代码对比等组合模式。',
    status: 'planned',
    media: 'var(--sx-sys-color-beige)',
    doodle: 'icon-pattern',
  },
];

const layers = [
  {
    kicker: 'Components',
    title: 'RetroUI 底座',
    body: '硬边框、硬阴影、按下/抬起。交互控件与容器的结构层。',
    href: 'https://github.com/retroui/RetroUI',
  },
  {
    kicker: 'Drawing',
    title: 'Rough.js 绘制',
    body: '涂鸦图标、装饰线稿、影线填充。画图，不替代控件。',
    href: 'https://github.com/rough-stuff/rough',
  },
];
---

<BaseLayout
  title="Design System"
  description="SchemaX UI —— Token、组件与内容规范。RetroUI 底座 × Rough 涂鸦。"
>
  <section class="sx-section ds">
    <div class="sx-container ds__inner">
      {/* —— Hero：编辑式左文案 + 右 token 面板 —— */}
      <header class="ds-hero">
        <div class="ds-hero__copy">
          <Crumb
            items={[{ label: 'Home', href: '/' }, { label: 'Design System' }]}
          />

          <div class="ds-hero__meta">
            <span class="ds-stamp">SchemaX UI</span>
            <Doodle kind="spark" size="sm" />
          </div>

          <h1 class="ds-hero__title">
            设计系统
            <span class="ds-hero__title-hl">即作品</span>
          </h1>

          <p class="ds-hero__lead">
            设计系统是设计唯一真相，也是 SchemaX
            自身的一件作品：令牌生成、组件契约与阅读规范同一套结构。
          </p>

          <ul class="ds-hero__stack" aria-label="技术栈">
            <li>Style Dictionary · DTCG JSON 令牌 · 生成 CSS / TS</li>
            <li>Astro 静态 · RetroUI 组件 · Rough.js 涂鸦 · Tailwind 桥接</li>
          </ul>

          <div class="ds-hero__pills" aria-label="分区标签">
            <span class="ds-pill ds-pill--accent">Tokens</span>
            <span class="ds-pill ds-pill--action">Components</span>
            <span class="ds-pill">Content</span>
          </div>
        </div>

        {/* 倾斜的 Figma Variables 装饰面板（纯装饰，仅 ≥82rem 显示） */}
        <div class="ds-vars" aria-hidden="true">
          <div class="ds-vars__panel">
            <div class="ds-vars__head">
              <span class="ds-vars__title">◆ VARIABLES</span>
              <span class="ds-vars__add">+</span>
            </div>
            <span class="ds-vars__divider"></span>
            <span class="ds-vars__collection">color / primitives</span>
            {
              figmaVars.map((v) => (
                <div class="ds-vars__row">
                  <span class="ds-vars__rowleft">
                    <span
                      class="ds-vars__chip"
                      style={`background:${v.token}`}
                    />
                    <span class="ds-vars__name">{v.name}</span>
                  </span>
                  <span class="ds-vars__value">{v.value}</span>
                </div>
              ))
            }
            <span class="ds-vars__divider"></span>
            <div class="ds-vars__mode">
              <span class="ds-vars__modeicon">◐</span>
              <span class="ds-vars__modelabel">Mode · Light</span>
            </div>
          </div>
        </div>
      </header>

      {/* —— 双层架构说明 —— */}
      <section class="ds-layers" aria-labelledby="ds-layers-title">
        <div class="ds-layers__head">
          <h2 class="ds-layers__title" id="ds-layers-title">视觉双层</h2>
          <p class="ds-layers__sub">RetroUI 搭架子 · Rough.js 画图</p>
        </div>
        <div class="ds-layers__grid">
          {
            layers.map((layer) => (
              <a
                class="ds-layer"
                href={layer.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="ds-layer__kicker">{layer.kicker}</span>
                <h3 class="ds-layer__name">{layer.title}</h3>
                <p class="ds-layer__body">{layer.body}</p>
                <span class="ds-layer__go" aria-hidden="true">
                  <Doodle kind="icon-github" size="sm" />
                  <span>GitHub →</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      {/* —— 入口网格 —— */}
      <section class="ds-catalog" aria-labelledby="ds-catalog-title">
        <div class="ds-catalog__head">
          <h2 class="ds-catalog__title" id="ds-catalog-title">从这里进入</h2>
          <p class="ds-catalog__sub">按 Foundations → Tokens → Components → Content 阅读</p>
        </div>

        <div class="ds-cards">
          {
            entries.map((c) => (
              <FeatureCard
                title={c.title}
                description={c.desc}
                status={c.status}
                href={c.href}
                mediaColor={c.media}
              >
                <Doodle kind={c.doodle} size="lg" />
              </FeatureCard>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .ds__inner {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-16);
  }

  /* —— Hero：居中单栏 + 右侧倾斜 Figma 面板装饰。
     不设 overflow:hidden —— 旋转面板需向上/下越出 hero 边界正常显示 —— */
  .ds-hero {
    position: relative;
    padding-block: var(--sx-ref-space-4) var(--sx-ref-space-12);
  }

  .ds-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sx-ref-space-6);
    max-width: 46rem;
    margin-inline: auto;
  }

  .ds-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--sx-ref-space-3);
  }

  .ds-stamp {
    display: inline-flex;
    padding: 0.4rem 0.7rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-md);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--sx-sys-shadow-sm);
    transform: rotate(-1.2deg);
  }

  .ds-hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-lg);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .ds-hero__title-hl {
    display: inline-block;
    margin-left: 0.15em;
    background: var(--sx-sys-color-accent);
    padding: 0 0.12em;
  }

  .ds-hero__lead {
    margin: 0;
    margin-inline: auto;
    max-width: 40ch;
    color: var(--sx-sys-color-text-soft);
    font-size: var(--sx-sys-font-size-reading);
    line-height: 1.7;
  }

  .ds-hero__stack {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .ds-hero__stack li {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    line-height: 1.55;
    color: var(--sx-sys-color-text-muted);
  }

  .ds-hero__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sx-ref-space-3);
  }

  /* 纯展示标签：不可跳转，无 hover/按下动效 */
  .ds-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.75rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: var(--sx-sys-radius-sm);
    background: var(--sx-sys-color-bg-surface);
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: var(--sx-sys-shadow-sm);
    cursor: default;
  }

  .ds-pill--accent {
    background: var(--sx-sys-color-accent);
  }

  .ds-pill--action {
    background: var(--sx-sys-color-action-primary);
    color: var(--sx-sys-color-bg-surface);
  }

  /* —— Figma Variables 倾斜装饰面板（纯装饰，aria-hidden，≥82rem） —— */
  .ds-vars {
    position: absolute;
    top: 0;
    right: 0;
    display: none;
    pointer-events: none;
  }

  .ds-vars__panel {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 13.5rem;
    padding: 0.75rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: 0.375rem;
    box-shadow: var(--sx-sys-shadow-md);
    transform: rotate(-10deg);
    transform-origin: top right;
  }

  .ds-vars__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ds-vars__title {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--sx-sys-color-text-primary);
  }

  .ds-vars__add {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1;
    color: var(--sx-sys-color-text-soft);
  }

  .ds-vars__divider {
    height: 1px;
    background: var(--sx-sys-color-border);
  }

  .ds-vars__collection {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--sx-sys-color-text-soft);
  }

  .ds-vars__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ds-vars__rowleft {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ds-vars__chip {
    width: 1rem;
    height: 1rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 0.25rem;
  }

  .ds-vars__name {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

  .ds-vars__value {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
  }

  .ds-vars__mode {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .ds-vars__modeicon {
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--sx-sys-color-text-soft);
  }

  .ds-vars__modelabel {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--sx-sys-color-text-soft);
  }

  /* 仅大屏显示：跳过碰撞窗，避免旋转面板逼近居中 hero */
  @media (min-width: 82rem) {
    .ds-vars {
      display: block;
    }
  }

  /* —— 双层架构 —— */
  .ds-layers__head,
  .ds-catalog__head {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    margin-bottom: var(--sx-ref-space-6);
  }

  .ds-layers__title,
  .ds-catalog__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-display-sm);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  .ds-layers__sub,
  .ds-catalog__sub {
    margin: 0;
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }

  .ds-layers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sx-sys-border-width-strong);
    background: var(--sx-sys-color-border);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
  }

  .ds-layer {
    display: flex;
    flex-direction: column;
    gap: var(--sx-ref-space-2);
    padding: var(--sx-ref-space-6);
    background: var(--sx-sys-color-bg-surface);
    text-decoration: none;
    color: inherit;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .ds-layer:first-child {
    background: color-mix(
      in srgb,
      var(--sx-sys-color-accent) 22%,
      var(--sx-sys-color-bg-surface)
    );
  }

  .ds-layer:last-child {
    background: color-mix(
      in srgb,
      var(--sx-sys-color-action-primary) 10%,
      var(--sx-sys-color-bg-surface)
    );
  }

  .ds-layer:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--sx-sys-shadow-md);
  }

  .ds-layer:focus-visible {
    outline: var(--sx-sys-border-width) solid var(--sx-sys-color-action-primary);
    outline-offset: 2px;
  }

  .ds-layer__kicker {
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sx-sys-color-text-muted);
  }

  .ds-layer__name {
    margin: 0;
    font-family: var(--sx-sys-font-family-display), system-ui, sans-serif;
    font-size: var(--sx-sys-font-size-xl);
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }

  .ds-layer__body {
    margin: 0;
    font-size: var(--sx-sys-font-size-base);
    line-height: 1.55;
    color: var(--sx-sys-color-text-soft);
  }

  .ds-layer__go {
    display: inline-flex;
    align-items: center;
    gap: var(--sx-ref-space-2);
    margin-top: auto;
    padding-top: var(--sx-ref-space-3);
    font-family: var(--sx-sys-font-family-mono-system), ui-monospace, monospace;
    font-size: var(--sx-sys-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sx-sys-color-action-primary);
  }

  .ds-layer__go :global(.sx-doodle) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--sx-sys-color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-layer {
      transition: none;
    }

    .ds-layer:hover {
      transform: none;
    }
  }

  /* —— 入口卡网格：5 卡 → 3+2 宽屏 / 单列移动 —— */
  .ds-cards {
    display: grid;
    gap: var(--sx-ref-space-6);
    grid-template-columns: 1fr;
  }

  /* FeatureCard 内 Rough SVG：媒体条强制 4rem，涂鸦需 overflow visible */
  .ds-cards :global(.featurecard__media .sx-doodle) {
    width: 4rem;
    height: 4rem;
  }

  .ds-cards :global(.featurecard__media) {
    overflow: visible;
  }

  /* action 媒体条上白/浅色涂鸦对比：保持 ink 线稿可读 */
  .ds-cards :global(.featurecard) {
    border-radius: var(--sx-sys-radius-sm);
  }

  @media (min-width: 48rem) {
    .ds-cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    /* 前三张各占 2 列；后两张各占 3 列居中满宽 */
    .ds-cards > :global(:nth-child(1)),
    .ds-cards > :global(:nth-child(2)),
    .ds-cards > :global(:nth-child(3)) {
      grid-column: span 2;
    }

    .ds-cards > :global(:nth-child(4)),
    .ds-cards > :global(:nth-child(5)) {
      grid-column: span 3;
    }
  }

  @media (max-width: 48rem) {
    .ds-layers__grid {
      grid-template-columns: 1fr;
    }
  }

</style>
