---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/design-system/FeatureCard.astro';
import Crumb from '../../components/design-system/Crumb.astro';

// lucide 风格图标（内联 SVG，currentColor，尺寸由 FeatureCard 媒体条统一控制）。
// 项目无 lucide 依赖，沿用 HomeManifesto 的内联 SVG 约定。
const svgWrap = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">${inner}</svg>`;

const icons = {
  palette: svgWrap(
    '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>',
  ),
  braces: svgWrap(
    '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  ),
  component: svgWrap(
    '<path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"/><path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"/><path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"/><path d="M12 15l3.5 3.5L12 22l-3.5-3.5L12 15Z"/>',
  ),
  fileText: svgWrap(
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  ),
  network: svgWrap(
    '<rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>',
  ),
};

// Hero 彩色徽章（薄荷 / 灰 / 红）—— 呼应三大区域，纯装饰
const heroBadges = [
  { label: 'Tokens', color: 'var(--sx-sys-color-mint)' },
  { label: 'Components', color: 'var(--sx-sys-color-gray-light)' },
  { label: 'Content', color: 'var(--sx-sys-color-danger)' },
];

// Hero 文案（对齐设计稿）—— 叙述行 + 技术栈行（mono 呼应「协议是一等公民」）
const heroLead = '设计系统即是设计唯一真相，也是 SchemaX 的重要作品。';
const heroStack = [
  'Expressive Code · Pagefind · Style Dictionary（DTCG JSON 令牌）',
  '原生 CSS + Tailwind v4（token 桥接）· pnpm · 静态输出',
];

// Figma Variables 装饰面板 —— 模拟设计工具的 color primitives 面板，
// 强化「token 是设计真相」主题（呼应 SchemaX 协议一等公民）。
// 纯装饰、aria-hidden；色块跟随真实 token，hex 标注真实取值。
const figmaVars = [
  { name: 'bg', value: '#FFF7E8', token: 'var(--sx-sys-color-bg-page)' },
  {
    name: 'ink',
    value: '#000000',
    token: 'var(--sx-sys-color-text-primary)',
  },
  { name: 'accent', value: '#FFDC58', token: 'var(--sx-sys-color-accent)' },
  {
    name: 'action',
    value: '#2F5BEA',
    token: 'var(--sx-sys-color-action-primary)',
  },
  { name: 'mint', value: '#01FFCC', token: 'var(--sx-sys-color-mint)' },
];

// 第一行：三张 Live 卡（Foundations / Tokens / Components）
const rowOne = [
  {
    title: 'Foundations',
    desc: '设计语言的「为什么」：视觉方向、核心原则、基础取值。',
    href: '/design-system/foundations',
    icon: icons.palette,
  },
  {
    title: 'Tokens',
    desc: '真实使用的 Reference / Semantic / Article / Component Token，读取生成产物。',
    href: '/design-system/tokens',
    icon: icons.braces,
  },
  {
    title: 'Components',
    desc: 'Button / Card / Tag / Badge / Navigation / Tabs / Dialog / Callout 等。',
    href: '/design-system/components',
    icon: icons.component,
  },
];

const accent = 'var(--sx-sys-color-accent)';
---

<BaseLayout
  title="Design System"
  description="SchemaX UI —— Token、组件与内容规范。"
>
  <section class="sx-section ds">
    <div class="sx-container">
      {/* —— Hero —— */}
      <header class="ds-hero">
        {/* 倾斜的 Figma Variables 装饰面板（纯装饰，仅大屏显示） */}
        <div class="ds-vars" aria-hidden="true">
          <div class="ds-vars__panel">
            <div class="ds-vars__head">
              <span class="ds-vars__title">◆ VARIABLES</span>
              <span class="ds-vars__add">+</span>
            </div>
            <span class="ds-vars__divider"></span>
            <span class="ds-vars__collection">color / primitives</span>
            {
              figmaVars.map((v) => (
                <div class="ds-vars__row">
                  <span class="ds-vars__rowleft">
                    <span
                      class="ds-vars__chip"
                      style={`background:${v.token}`}
                    />
                    <span class="ds-vars__name">{v.name}</span>
                  </span>
                  <span class="ds-vars__value">{v.value}</span>
                </div>
              ))
            }
            <span class="ds-vars__divider"></span>
            <div class="ds-vars__mode">
              <span class="ds-vars__modeicon">◐</span>
              <span class="ds-vars__modelabel">Mode · Light</span>
            </div>
          </div>
        </div>

        <Crumb
          items={[{ label: 'Home', href: '/' }, { label: 'Design System' }]}
        />

        <h1 class="ds-hero__title">设计系统</h1>
        <div class="ds-hero__desc">
          <p class="ds-hero__lead">{heroLead}</p>
          {heroStack.map((line) => <p class="ds-hero__stack">{line}</p>)}
        </div>

        <div class="ds-hero__badges">
          {
            heroBadges.map((b) => (
              <span class="ds-badge" style={`background:${b.color}`}>
                {b.label}
              </span>
            ))
          }
        </div>
      </header>

      {/* —— 第一行：三张 Live 卡 —— */}
      <div class="ds-cards ds-cards--three">
        {
          rowOne.map((c) => (
            <FeatureCard
              title={c.title}
              description={c.desc}
              status="live"
              href={c.href}
              mediaColor={accent}
            >
              <Fragment set:html={c.icon} />
            </FeatureCard>
          ))
        }
      </div>

      {/* —— 第二行：两张卡居中（Content Live / Patterns Planned）—— */}
      <div class="ds-cards ds-cards--two">
        <FeatureCard
          title="Content"
          description="Markdown 与 MDX 的真实排版规范。"
          status="live"
          href="/design-system/content"
          mediaColor={accent}
        >
          <Fragment set:html={icons.fileText} />
        </FeatureCard>
        <FeatureCard
          title="Patterns"
          description="文章头部、课程目录、项目 Hero、代码对比等组合模式。"
          status="planned"
          mediaColor="var(--sx-sys-color-beige)"
        >
          <Fragment set:html={icons.network} />
        </FeatureCard>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* —— Hero —— 居中：面包屑胶囊 + 大标题 + 描述（叙述 + 技术栈）+ 彩色徽章。
     position:relative 承载右侧倾斜的 Figma Variables 装饰面板。 */
  .ds-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.375rem;
    padding-block-end: 3rem;
  }

  .ds-hero__title {
    margin: 0;
    font-family: var(--sx-sys-font-family-display);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--sx-sys-color-text-primary);
  }

  /* 描述区：叙述行（正文体）+ 技术栈行（mono）两档层次 */
  .ds-hero__desc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    max-width: 40rem;
  }
  .ds-hero__lead {
    margin: 0;
    color: var(--sx-sys-color-text-soft);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.55;
  }
  .ds-hero__stack {
    margin: 0;
    color: var(--sx-sys-color-text-muted);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    letter-spacing: 0.005em;
  }

  .ds-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* 彩色徽章：pill，2px 黑边，等宽小字，黑字 */
  .ds-badge {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: 9999px;
    color: var(--sx-sys-color-text-primary);
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* —— Figma Variables 装饰面板 —— 模拟设计工具的 color primitives 面板，
     倾斜浮于 hero 右侧，强化「token 是设计真相」主题。纯装饰，仅大屏显示。 */
  .ds-vars {
    position: absolute;
    top: 0;
    right: 0;
    display: none;
    pointer-events: none;
  }
  .ds-vars__panel {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 13.5rem;
    padding: 0.75rem;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width-strong) solid var(--sx-sys-color-border);
    border-radius: 0.375rem;
    box-shadow: var(--sx-sys-shadow-md);
    transform: rotate(-10deg);
    transform-origin: top right;
  }
  .ds-vars__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ds-vars__title {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--sx-sys-color-text-primary);
  }
  .ds-vars__add {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1;
    color: var(--sx-sys-color-text-soft);
  }
  .ds-vars__divider {
    height: 1px;
    background: var(--sx-sys-color-border);
  }
  .ds-vars__collection {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--sx-sys-color-text-soft);
  }
  .ds-vars__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ds-vars__rowleft {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ds-vars__chip {
    width: 1rem;
    height: 1rem;
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    border-radius: 0.25rem;
  }
  .ds-vars__name {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--sx-sys-color-text-primary);
  }
  .ds-vars__value {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--sx-sys-color-text-soft);
  }
  .ds-vars__mode {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .ds-vars__modeicon {
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--sx-sys-color-text-soft);
  }
  .ds-vars__modelabel {
    font-family: var(--sx-sys-font-family-mono);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--sx-sys-color-text-soft);
  }

  @media (min-width: 75rem) {
    .ds-vars {
      display: block;
    }
  }

  /* —— 卡片网格 —— 默认（移动端）单列堆叠 */
  .ds-cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  /* 第二行：两张卡居中，各约 1/3 宽（与第一行单卡等宽） */
  .ds-cards--two {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-block-start: 1.75rem;
  }
  .ds-cards--two > :global(*) {
    flex: 0 0 100%;
    max-width: 26rem;
  }

  @media (min-width: 48rem) {
    /* 第一行：三等分；第二行：两卡居中、各取 1/3 宽 */
    .ds-cards--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ds-cards--two > :global(*) {
      flex: 0 0 calc((100% - 3rem) / 3);
      max-width: none;
    }
  }
</style>
