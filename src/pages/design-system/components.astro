---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Command from '../../components/design-system/Command.astro';
import Crumb from '../../components/design-system/Crumb.astro';
import FeatureCard from '../../components/design-system/FeatureCard.astro';
import { componentsRegistry } from '../../data/components-registry';

// 本页现为「组件目录索引」：live 组件以卡片展示，点击进入详情页
// /design-system/components/<name>（详情页只渲染该组件的 <Demo/>）。
// glob 加载与 demo 渲染已移至 [name].astro；新增组件后本页自动出现卡片（数据驱动）。
const liveComponents = componentsRegistry.filter((c) => c.status === 'live');
const plannedComponents = componentsRegistry.filter(
  (c) => c.status === 'planned',
);

const BASE = '/design-system/components';
const detailHref = (name: string) => `${BASE}/${name.toLowerCase()}`;

// live 目录卡 media 装饰色轮换（呼应首页 bento 的装饰色系）
const MEDIA_COLORS = [
  'var(--sx-sys-color-accent)',
  'var(--sx-sys-color-mint)',
  'var(--sx-sys-color-lavender)',
  'var(--sx-sys-color-beige)',
  'var(--sx-sys-color-gray-light)',
];
const mediaColor = (i: number) => MEDIA_COLORS[i % MEDIA_COLORS.length];
---

<BaseLayout
  title="Design System · Components"
  description="SchemaX UI 组件库 —— 数据驱动展示。"
>
  <section class="sx-section">
    <div class="sx-container">
      <Crumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Design System', href: '/design-system' },
          { label: 'Components' },
        ]}
      />

      <header class="page-head">
        <p class="eyebrow">SchemaX UI</p>
        <h1>组件 Components</h1>
        <p>组件库按真实使用方式展示。新增组件：</p>
        <div class="page-head__cmd">
          <Command theme="light" title="bash">
            pnpm gen:component &lt;Name&gt;
          </Command>
        </div>
      </header>

      {/* —— Live 组件：卡片目录，点击进入详情页 —— */}
      <div class="sx-grid">
        {
          liveComponents.map((entry, i) => (
            <FeatureCard
              title={entry.title}
              description={entry.description}
              status="live"
              href={detailHref(entry.name)}
              mediaColor={mediaColor(i)}
            >
              <span class="comp-card__name">{entry.name}</span>
            </FeatureCard>
          ))
        }
      </div>

      {/* —— Planned 组件：占位卡（不可点），附生成命令 —— */}
      {
        plannedComponents.length > 0 && (
          <section class="planned-group">
            <h2 class="planned-group__title">Planned</h2>
            <div class="sx-grid">
              {plannedComponents.map((entry) => (
                <FeatureCard
                  title={entry.title}
                  status="planned"
                  mediaColor="var(--sx-sys-color-beige)"
                >
                  <span class="comp-card__name">{entry.name}</span>
                  <Fragment slot="description">
                    <p>{entry.description}</p>
                    <code class="comp-card__cmd">
                      pnpm gen:component {entry.name}
                    </code>
                  </Fragment>
                </FeatureCard>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* 本页内容容器收窄至 960px（默认全站 --sx-layout-width-page: 78rem）。
     用 :global() 穿透到 layout 层的 .sx-container；scoped style 处于更高层
     自动胜出，且只影响本页。 */
  :global(.sx-container) {
    max-width: 60rem;
  }

  .page-head {
    margin-block: var(--sx-ref-space-4) var(--sx-ref-space-8);
  }
  /* header 里的 Command：限制宽度，左对齐而非撑满容器。
     不覆盖阴影 —— Command 的黄色阴影是其固有特征，永远跟随组件自身。 */
  .page-head__cmd {
    margin-block-start: var(--sx-ref-space-3);
    max-width: 28rem;
  }
  .eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--sx-sys-color-action-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--sx-sys-font-size-md);
  }
  .page-head h1 {
    font-size: var(--sx-sys-font-size-4xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-block-start: var(--sx-ref-space-2);
  }
  .page-head p {
    opacity: 0.8;
    margin-block-start: var(--sx-ref-space-2);
  }
  .page-head code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: var(--sx-sys-color-bg-surface);
    border: var(--sx-sys-border-width) solid var(--sx-sys-color-border);
    padding: 0.05em 0.4em;
  }

  /* 目录卡 media：等宽大字组件名，契合 schema 视觉母题（字段名 / 类型标签）。
     span 由本页传入 FeatureCard 的 media slot，带本页 cid，故 scoped style 可匹配。 */
  .comp-card__name {
    font-family: var(--sx-sys-font-family-mono);
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  /* planned 卡 description slot 内的生成命令 */
  .comp-card__cmd {
    display: inline-block;
    margin-block-start: var(--sx-ref-space-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--sx-sys-font-size-md);
    background: var(--sx-sys-color-bg-page);
    padding: 0.05em 0.4em;
  }

  .planned-group {
    margin-block-start: var(--sx-ref-space-12);
  }
  .planned-group__title {
    font-size: var(--sx-sys-font-size-2xl);
    font-weight: 800;
    margin-block-end: var(--sx-ref-space-6);
  }
</style>
