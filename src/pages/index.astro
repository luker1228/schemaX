---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero';
import HomeEntries from '../components/home/HomeEntries';
import HomeManifesto from '../components/home/HomeManifesto';
import HomeLatestPosts from '../components/home/HomeLatestPosts';
import HomeProjects from '../components/home/HomeProjects';
import HomeTechNote from '../components/home/HomeTechNote';
import HomeTicker from '../components/home/HomeTicker';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import '../styles/home.css';

// 已发布文章，按发布时间倒序。前 4 篇：第 1 篇进最新文章大卡，其余进归档列表。
const posts = (
  await getCollection('posts', ({ data }) => data.status === 'published')
).sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
const recentPosts = posts.slice(0, 4);

// 非归档项目：优先 featured，否则取第一个作为代表作大卡。
const projects = await getCollection(
  'projects',
  ({ data }) => data.status !== 'archived',
);
const featuredProject = projects.find((p) => p.data.featured) ?? projects[0];
---

<BaseLayout title={site.name} type="profile">
  <div class="home">
    <HomeHero />
    <HomeTicker />
    <HomeEntries />
    <HomeManifesto />
    <HomeLatestPosts posts={recentPosts} />
    <HomeProjects project={featuredProject} />
    <HomeTechNote />
  </div>
</BaseLayout>
