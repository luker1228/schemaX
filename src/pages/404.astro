---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" noindex>
  <section class="sx-section nf">
    <div class="sx-container nf__inner">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Structure not found.</h1>
      <p class="nf__desc">
        这个路径没有对应的页面。也许它从未存在，也许它已被重组。
      </p>
      <a class="btn btn--primary" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sx-ref-space-4);
    padding-block: var(--sx-ref-space-24);
    max-width: 40rem;
  }
  .nf__code {
    font-family: ui-monospace, monospace;
    font-size: 4rem;
    font-weight: 800;
    color: var(--sx-sys-color-action-primary);
    line-height: 1;
  }
  .nf__title {
    font-size: 2rem;
    font-weight: 800;
  }
</style>
