---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/site/PostCard.astro';
import PageHeader from '../../components/site/PageHeader.astro';
import Crumb from '../../components/design-system/Crumb.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('posts', ({ data }) => data.status === 'published')
).sort(
  (a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
---

<BaseLayout title="Blog" description="技术文章、工程总结与观点记录。">
  <section class="sx-section">
    <div class="sx-container">
      <Crumb items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />

      <PageHeader title="Blog" description="技术文章、工程总结与观点记录。" />

      {
        posts.length > 0 ? (
          <div class="sx-grid">
            {posts.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        ) : (
          <p class="empty">还没有已发布的文章。</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    border: var(--sx-sys-border-width) dashed var(--sx-sys-color-border);
    padding: var(--sx-ref-space-8);
    text-align: center;
    opacity: 0.7;
  }
</style>
