                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "SyI8z",
                  "name": "Section Title",
                  "fill": "$--sx-sys-color-text-primary",
                  "content": "概述",
                  "lineHeight": 1.05,
                  "fontFamily": "$--sx-font-display",
                  "fontSize": 40,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "bPT1n",
                  "name": "Overview Body",
                  "width": 820,
                  "layout": "vertical",
                  "gap": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "MJPUm",
                      "name": "Para 1",
                      "fill": "$--sx-sys-color-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Nav 是 SchemaX 全站的顶部导航栏，作为页面的稳定锚点固定在视口顶部。它把品牌标识、主导航与高频操作集中在一条横向轨道上，让用户在任何页面都能快速辨识当前位置并完成跳转。",
                      "lineHeight": 1.7,
                      "fontFamily": "$--sx-font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "PVpLS",
                      "name": "Para 2",
                      "fill": "$--sx-sys-color-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "结构上，它由三组内容构成：左侧的品牌簇（Logo + 站名 + 标语）、居中的主导航项（课程、博客、作品、设计系统），以及右侧的头部操作（RSS、GitHub）。当前页对应的导航项以黄色高亮，承担「你在这里」的位置反馈。",
                      "lineHeight": 1.7,
                      "fontFamily": "$--sx-font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "C9oikw",
                      "name": "Para 3",
                      "fill": "$--sx-sys-color-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "它不只是跳转入口，更是整站信息架构的骨架——主导航项对应 SchemaX 的一级分区，头部操作则暴露订阅与源码入口。无论用户深入到哪一页，Nav 都提供一条回到主结构的退路。",
                      "lineHeight": 1.7,
                      "fontFamily": "$--sx-font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
