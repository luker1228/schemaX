{
  "$schema": "https://designtokens.org/TR/2025.10/format/",
  "ref": {
    "color": {
      "ink": { "$type": "color", "$value": "#000000" },
      "paper": { "$type": "color", "$value": "#FFF7E8" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "blue": {
        "500": { "$type": "color", "$value": "#2f5bea" }
      },
      "yellow": {
        "400": { "$type": "color", "$value": "#FFDC58" }
      },
      "red": {
        "500": { "$type": "color", "$value": "#f9575c" }
      },
      "green": {
        "500": { "$type": "color", "$value": "#35ad68" }
      },
      "mint": { "$type": "color", "$value": "#01FFCC" },
      "lavender": { "$type": "color", "$value": "#C7B7FF" },
      "beige": { "$type": "color", "$value": "#EFE7D6" },
      "warm-gray": { "$type": "color", "$value": "#6B6355" },
      "gray": {
        "200": { "$type": "color", "$value": "#CBCCC9" },
        "500": { "$type": "color", "$value": "#666666" }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" },
      "24": { "$type": "dimension", "$value": "6rem" }
    },
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "'Bricolage Grotesque'"
        },
        "body": { "$type": "fontFamily", "$value": "'Geist'" },
        "mono": { "$type": "fontFamily", "$value": "'Geist Mono'" }
      }
    }
  }
}
