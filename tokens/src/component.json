{
  "comp": {
    "card": {
      "padding": { "$type": "dimension", "$value": "{ref.space.4}" },
      "shadow": { "$type": "shadow", "$value": "{sys.shadow.sm}" },
      "radius": {
        "$type": "dimension",
        "$value": "{sys.radius.control}",
        "$description": "同源 sys.radius.control（neubrutalism 恒 0）。none 变体亦为 0。"
      },
      "hover-shadow": {
        "$type": "shadow",
        "$value": "{sys.shadow.lg}",
        "$description": "interactive 卡片 hover 时的阴影（neubrutalism 抬升 + 影涨到 lg）。"
      },
      "colored-shadow": {
        "$type": "shadow",
        "$value": "5px 5px 0 {sys.color.coral}",
        "$description": "Card Colored Shadow 变体：珊瑚色边框与珊瑚色偏移影。"
      },
      "colored-border": {
        "$type": "color",
        "$value": "{sys.color.coral}",
        "$description": "Card Colored Shadow 变体边框色，与 colored-shadow 同源。"
      }
    },
    "demo": {
      "shadow": {
        "$type": "shadow",
        "$value": "{sys.shadow.lg}",
        "$description": "演示块阴影，对齐全局 sys.shadow.lg（3/5/8 ramp 第三档 8px）。"
      }
    },
    "term": {
      "screen-bg": { "$type": "color", "$value": "#0f1115" },
      "text": { "$type": "color", "$value": "#e6e6e6" },
      "light-screen-bg": { "$type": "color", "$value": "{ref.color.paper}" },
      "light-text": { "$type": "color", "$value": "{ref.color.ink}" },
      "shadow": {
        "$type": "shadow",
        "$value": "8px 8px 0 {ref.color.yellow.400}",
        "$description": "Command 私有：仅黄色偏移阴影，不叠加外框。尺寸与全局 sys.shadow.lg 对齐（3/5/8 ramp 第三档 8px）。"
      }
    },
    "header": {
      "padding-block": { "$type": "dimension", "$value": "0.9rem" },
      "padding-inline": {
        "$type": "dimension",
        "$value": "clamp(1rem, 8vw, 6rem)"
      },
      "gap": { "$type": "dimension", "$value": "{ref.space.4}" },
      "logo-size": { "$type": "dimension", "$value": "3.5rem" },
      "logo-bg": {
        "$type": "color",
        "$value": "{ref.color.ink}",
        "$description": "Header logo 容器背景（黑底暖纸配色：ink 背景 + paper 前景）。"
      },
      "logo-fg": {
        "$type": "color",
        "$value": "{ref.color.paper}",
        "$description": "Header logo mark 前景色，配合 logo-bg 形成反白。"
      }
    },
    "page-head": {
      "margin-block-start": { "$type": "dimension", "$value": "{ref.space.6}" },
      "margin-block-end": {
        "$type": "dimension",
        "$value": "{ref.space.12}",
        "$description": "与下方内容（卡片网格等）的间距。"
      },
      "max-width": { "$type": "dimension", "$value": "42rem" },
      "title-size": {
        "$type": "dimension",
        "$value": "{sys.font.display.lg}",
        "$description": "hero 级标题字号，别名 sys.font.display.lg。"
      },
      "desc-size": {
        "$type": "dimension",
        "$value": "{sys.font.size.reading}",
        "$description": "页头描述字号，别名 sys.font.size.reading（原 1.05rem → 1.0625rem）。"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{ref.space.3}",
        "$description": "标题与描述之间的间距。"
      }
    },
    "code": {
      "bg": {
        "$type": "color",
        "$value": "#1a1a2e",
        "$description": "代码块深蓝紫底（= neubrutalism.com .code-block #1a1a2e，深色终端感）。"
      },
      "fg": {
        "$type": "color",
        "$value": "{ref.color.terminal.text}",
        "$description": "代码块默认文字色。"
      },
      "highlight": {
        "selector": { "$type": "color", "$value": "{ref.color.coral}" },
        "property": { "$type": "color", "$value": "{ref.color.cyan}" },
        "value": { "$type": "color", "$value": "{ref.color.yellow.400}" },
        "comment": { "$type": "color", "$value": "{ref.color.gray.500}" },
        "tag": { "$type": "color", "$value": "{ref.color.sky}" },
        "string": { "$type": "color", "$value": "{ref.color.pop-green}" }
      }
    }
  }
}
