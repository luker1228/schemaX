{
  "comp": {
    "card": {
      "padding": { "$type": "dimension", "$value": "{ref.space.4}" },
      "shadow": { "$type": "shadow", "$value": "{sys.shadow.sm}" },
      "radius": {
        "$type": "dimension",
        "$value": "{sys.radius.control}",
        "$description": "圆角卡片半径，同源 sys.radius.control（2px）。none 变体为 0。"
      },
      "hover-shadow": {
        "$type": "shadow",
        "$value": "{sys.shadow.md}",
        "$description": "interactive 卡片 hover 时的阴影。"
      }
    },
    "demo": {
      "shadow": {
        "$type": "shadow",
        "$value": "{sys.shadow.lg}",
        "$description": "演示块阴影，对齐全局 sys.shadow.lg（6px）。"
      }
    },
    "term": {
      "screen-bg": { "$type": "color", "$value": "#0f1115" },
      "text": { "$type": "color", "$value": "#e6e6e6" },
      "light-screen-bg": { "$type": "color", "$value": "{ref.color.paper}" },
      "light-text": { "$type": "color", "$value": "{ref.color.ink}" },
      "shadow": {
        "$type": "shadow",
        "$value": "6px 6px 0 {ref.color.yellow.400}, 6px 6px 0 1px {ref.color.ink}",
        "$description": "Command 私有：黄色偏移 + 黑色描边。尺寸与全局 sys.shadow.lg 对齐（6px）。"
      }
    },
    "header": {
      "padding-block": { "$type": "dimension", "$value": "0.9rem" },
      "padding-inline": {
        "$type": "dimension",
        "$value": "clamp(1rem, 8vw, 6rem)"
      },
      "gap": { "$type": "dimension", "$value": "{ref.space.4}" },
      "logo-size": { "$type": "dimension", "$value": "3.5rem" },
      "logo-bg": {
        "$type": "color",
        "$value": "{ref.color.ink}",
        "$description": "Header logo 容器背景（黑底暖纸配色：ink 背景 + paper 前景）。"
      },
      "logo-fg": {
        "$type": "color",
        "$value": "{ref.color.paper}",
        "$description": "Header logo mark 前景色，配合 logo-bg 形成反白。"
      }
    },
    "page-head": {
      "margin-block-start": { "$type": "dimension", "$value": "{ref.space.6}" },
      "margin-block-end": {
        "$type": "dimension",
        "$value": "{ref.space.12}",
        "$description": "与下方内容（卡片网格等）的间距。"
      },
      "max-width": { "$type": "dimension", "$value": "42rem" },
      "title-size": {
        "$type": "dimension",
        "$value": "{sys.font.display.lg}",
        "$description": "hero 级标题字号，别名 sys.font.display.lg。"
      },
      "desc-size": {
        "$type": "dimension",
        "$value": "{sys.font.size.reading}",
        "$description": "页头描述字号，别名 sys.font.size.reading（原 1.05rem → 1.0625rem）。"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{ref.space.3}",
        "$description": "标题与描述之间的间距。"
      }
    }
  }
}
