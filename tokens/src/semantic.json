{
  "sys": {
    "color": {
      "bg": {
        "page": { "$type": "color", "$value": "{ref.color.paper}" },
        "surface": { "$type": "color", "$value": "{ref.color.white}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{ref.color.ink}" },
        "soft": { "$type": "color", "$value": "{ref.color.warm-gray}" },
        "muted": { "$type": "color", "$value": "{ref.color.gray.500}" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "{ref.color.blue.500}" }
      },
      "accent": { "$type": "color", "$value": "{ref.color.yellow.400}" },
      "border": { "$type": "color", "$value": "{ref.color.ink}" },
      "danger": { "$type": "color", "$value": "{ref.color.red.500}" },
      "success": { "$type": "color", "$value": "{ref.color.green.500}" },
      "warning": { "$type": "color", "$value": "{ref.color.orange}", "$description": "警告语义色（neubrutalism 撞色橙 #FFA552）。Toast / Badge warning。" },
      "info": { "$type": "color", "$value": "{ref.color.sky}", "$description": "信息语义色（neubrutalism 撞色天蓝 #74B9FF）。Toast / Badge info。" },
      "mint": { "$type": "color", "$value": "{ref.color.mint}" },
      "lavender": { "$type": "color", "$value": "{ref.color.lavender}" },
      "beige": { "$type": "color", "$value": "{ref.color.beige}" },
      "gray-light": { "$type": "color", "$value": "{ref.color.gray.200}" },
      "coral": { "$type": "color", "$value": "{ref.color.coral}", "$description": "neubrutalism 撞色：珊瑚粉，贴纸 / 撞色卡强调。" },
      "sky": { "$type": "color", "$value": "{ref.color.sky}", "$description": "neubrutalism 撞色：天蓝，focus outline / 撞色卡。" },
      "pop-green": { "$type": "color", "$value": "{ref.color.pop-green}", "$description": "neubrutalism 撞色：柔绿，贴纸 / 状态撞色。" },
      "orange": { "$type": "color", "$value": "{ref.color.orange}", "$description": "neubrutalism 撞色：橙，贴纸 / 强调。" },
      "terminal": {
        "bg": { "$type": "color", "$value": "{ref.color.terminal.bg}" },
        "surface": { "$type": "color", "$value": "{ref.color.terminal.surface}" },
        "elevated": { "$type": "color", "$value": "{ref.color.terminal.elevated}" },
        "border": { "$type": "color", "$value": "{ref.color.terminal.border}" },
        "text": { "$type": "color", "$value": "{ref.color.terminal.text}" },
        "muted": { "$type": "color", "$value": "{ref.color.terminal.muted}" }
      }
    },
    "font": {
      "family": {
        "display": { "$type": "fontFamily", "$value": "{ref.font.family.display}" },
        "body": { "$type": "fontFamily", "$value": "{ref.font.family.body}" },
        "mono": { "$type": "fontFamily", "$value": "{ref.font.family.mono}" },
        "terminal": { "$type": "fontFamily", "$value": "{ref.font.family.ibm-plex-mono}" },
        "mono-system": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "UI chrome 系统等宽栈（nav / tag / terminal / 行内 code 标注）。与 Geist Mono (mono) 区分。" }
      },
      "size": {
        "xs": { "$type": "dimension", "$value": "0.6875rem" },
        "sm": { "$type": "dimension", "$value": "0.75rem" },
        "md": { "$type": "dimension", "$value": "0.8125rem" },
        "base": { "$type": "dimension", "$value": "0.9rem" },
        "lg": { "$type": "dimension", "$value": "1rem" },
        "reading": { "$type": "dimension", "$value": "1.0625rem" },
        "xl": { "$type": "dimension", "$value": "1.2rem" },
        "2xl": { "$type": "dimension", "$value": "1.5rem" },
        "3xl": { "$type": "dimension", "$value": "2rem" },
        "4xl": { "$type": "dimension", "$value": "2.5rem" }
      },
      "display": {
        "sm": { "$type": "dimension", "$value": "clamp(1.25rem, 3vw, 1.75rem)" },
        "md": { "$type": "dimension", "$value": "clamp(1.75rem, 4vw, 2.75rem)" },
        "lg": { "$type": "dimension", "$value": "clamp(2.5rem, 7vw, 4.5rem)" }
      }
    },
    "border": {
      "width": { "$type": "dimension", "$value": "2px", "$description": "细笔触（neubrutalism border-thin：分割线 / 次级元素）。" },
      "width-strong": {
        "$type": "dimension",
        "$value": "3px",
        "$description": "Canonical 笔触（neubrutalism border：所有主组件默认边框，单一笔触宽度，border IS ornament）。"
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "0" },
      "md": { "$type": "dimension", "$value": "0" },
      "control": { "$type": "dimension", "$value": "0", "$description": "恒 0 圆角（neubrutalism：所有控件 / 卡片 / 容器一律直角，无例外）。" }
    },
    "shadow": {
      "color": { "$type": "color", "$value": "{sys.color.border}", "$description": "硬影色（= ink 黑）。neubrutalism 零模糊硬偏移影；组件可局部覆盖 --sx-sys-shadow-color 做撞色偏移（黄 / 粉 / 蓝 / 绿）。" },
      "sm": { "$type": "shadow", "$value": "3px 3px 0 var(--sx-sys-shadow-color)", "$description": "3/6/9 ramp 第一档：徽章 / chip / inline 控件。" },
      "md": { "$type": "shadow", "$value": "6px 6px 0 var(--sx-sys-shadow-color)", "$description": "3/6/9 ramp 第二档：卡片 / 按钮 / 面板默认硬影。" },
      "lg": { "$type": "shadow", "$value": "9px 9px 0 var(--sx-sys-shadow-color)", "$description": "3/6/9 ramp 第三档：hover 抬升态 / 强调面板。" },
      "xl": { "$type": "shadow", "$value": "12px 12px 0 var(--sx-sys-shadow-color)", "$description": "hero / dialog 重硬影（neubrutalism shadow-xl，独立 hero 档，不在 3/6/9 ramp 内）。" }
    },
    "rotate": {
      "sticker": { "$type": "other", "$value": "-2deg", "$description": "贴纸/戳记/CTA 微旋默认倾角（左倾 -2°）。反方向用 calc(var(--sx-sys-rotate-sticker) * -1)。仅 sticker 可旋，正文不可。" }
    },
    "layout": {
      "width": {
        "doc": {
          "$type": "dimension",
          "$value": "87.5rem",
          "$description": "文档/课时双栏布局内容总宽（侧栏 + 主区）。设计系统组件页与课程课时页共用。"
        }
      },
      "sidebar": {
        "width": {
          "$type": "dimension",
          "$value": "13.5rem",
          "$description": "文档/课时左侧栏列宽。与主区组成双栏 grid。偏窄以把主区（白板）让宽。"
        }
      },
      "gap": {
        "doc": {
          "$type": "dimension",
          "$value": "10rem",
          "$description": "文档/课时双栏：侧栏 ↔ 主区间距（目录与白板之间的留白）。"
        },
        "main": {
          "$type": "dimension",
          "$value": "{ref.space.8}",
          "$description": "文档/课时主区内部纵向间距（导航 / hero / 正文）。"
        }
      },
      "padding": {
        "inline": {
          "$type": "dimension",
          "$value": "{ref.space.6}",
          "$description": "文档/课时双栏容器左右内边距。"
        },
        "block-start": {
          "$type": "dimension",
          "$value": "{ref.space.8}",
          "$description": "文档/课时双栏容器顶部内边距。"
        },
        "block-end": {
          "$type": "dimension",
          "$value": "{ref.space.12}",
          "$description": "文档/课时双栏容器底部内边距。"
        }
      },
      "grid": {
        "cell-min": { "$type": "dimension", "$value": "18rem", "$description": "auto-fill 卡片格单元最小宽（.sx-grid 的 minmax 下限）。" }
      }
    },
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "36rem" },
      "md": { "$type": "dimension", "$value": "45rem" },
      "lg": { "$type": "dimension", "$value": "48rem" },
      "xl": { "$type": "dimension", "$value": "64rem" },
      "2xl": { "$type": "dimension", "$value": "82rem" }
    }
  }
}
